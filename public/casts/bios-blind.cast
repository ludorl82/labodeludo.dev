{"version": 2, "width": 96, "height": 22, "title": "Un BIOS invisible, pilot\u00e9 \u00e0 l'aveugle (reconstitution)", "timestamp": 0, "idle_time_limit": 2, "env": {"TERM": "xterm-256color", "SHELL": "/bin/zsh"}}
[0.0, "o", "\u001b[38;5;220m  ⚠  Reconstitution condensée — pas une capture en direct.\u001b[0m\r\n"]
[0.25, "o", "\u001b[38;5;246m     Demandes et messages réels, minutage compressé,\u001b[0m\r\n"]
[0.5, "o", "\u001b[38;5;246m     noms d'hôte sanitisés.  labodeludo.dev/casts/\u001b[0m\r\n"]
[3.1, "o", "\r\n"]
[3.65, "o", "\u001b[38;5;217m  ▄▄▄▄▄▄▄▄\u001b[0m   \u001b[1mClaude Code\u001b[0m \u001b[38;5;246mv2.1.225\u001b[0m\r\n"]
[3.85, "o", "\u001b[38;5;217m  █ ██ ██ █\u001b[0m  \u001b[38;5;246mOpus 4.8 · Claude Pro\u001b[0m\r\n"]
[4.05, "o", "\u001b[38;5;217m  ▀▀    ▀▀\u001b[0m  \u001b[38;5;246m~/git/nixos-iac\u001b[0m\r\n"]
