[76.513, "o", "  \u001b[38;5;246mBash  ipmitool … sol activate   # ESC 3, then save\u001b[0m\r\n"]
[77.213, "o", "\u001b[38;5;174m· Resetting…\u001b[0m \u001b[38;5;246m(4m 40s · ↓ 2.6k tokens)\u001b[0m\r\n"]
[79.213, "o", "\r\n"]
[79.763, "o", "\r\n"]
[80.313, "o", "  \u001b[38;5;220m\u001b[1mI need to tell you plainly: the Load Optimized Defaults left hyperviseur\u001b[0m\r\n"]
[81.213, "o", "  \u001b[38;5;220min a boot loop, and it is currently down.\u001b[0m\r\n"]
[81.813, "o", "  \u001b[38;5;246mwaiting for you…\u001b[0m\r\n"]
[85.013, "o", "\r\n"]
[85.563, "o", "\u001b[38;5;253m●\u001b[0m POST reaches code 72, goes dark, and restarts at code 32 roughly every\r\n"]
[86.463, "o", "  two minutes, over and over. A cold power off/on didn't clear it.\r\n"]
[87.363, "o", "  Diagnostics say settings, not hardware: no fault events, temps healthy.\r\n"]
[88.763, "o", "\u001b[38;5;37m──────────────────────────────────────────────────────────────────────────── nixos-hyperviseur\u001b[0m\r\n"]
