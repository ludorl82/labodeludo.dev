[68.573, "o", "\u001b[38;5;114mbob\u001b[0m  \u001b[38;5;253mÇa, c'est pas documenté — demande à Ludo. Moi, je suis là pour te\u001b[0m\r\n"]
[69.523, "o", "     \u001b[38;5;253mdire ce que j'ai vu tourner dans le parc, pas pour te donner les\u001b[0m\r\n"]
[70.423, "o", "     \u001b[38;5;253mclés de la maison.\u001b[0m\r\n"]
[72.823, "o", "\r\n"]
[73.373, "o", "  \u001b[38;5;37m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[74.073, "o", "  \u001b[38;5;246mLire ses propres articles ne veut pas dire tout savoir.\u001b[0m\r\n"]
[74.673, "o", "  \u001b[38;5;246mIl cite ce qui est publié, et il s'arrête là.\u001b[0m\r\n"]
