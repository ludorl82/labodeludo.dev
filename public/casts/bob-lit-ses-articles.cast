[14.278, "o", "  \u001b[38;5;246m(⌐■_■) Fouille ses archives… (3s)\u001b[0m\r\n"]
[15.178, "o", "\u001b[38;5;114mbob\u001b[0m  \u001b[38;5;253mT'as lu le bon article pour ça :\u001b[0m\r\n"]
[16.128, "o", "     \u001b[38;5;37m≡ Déplacer mes partages NFS sur un SSD sans toucher à Kubernetes\u001b[0m\r\n"]
[16.728, "o", "     \u001b[38;5;253mLe gros problème, c'est qu'un processus `mount.nfs` s'était figé\u001b[0m\r\n"]
[17.628, "o", "     \u001b[38;5;253men état D sur une machine, bloquant toutes les autres tentatives\u001b[0m\r\n"]
[18.528, "o", "     \u001b[38;5;253mde monture comme si y'avait un souci de réseau.\u001b[0m\r\n"]
[20.528, "o", "\r\n"]
[21.078, "o", "  \u001b[38;5;220mCe détail-là n'est écrit nulle part dans l'index. Il est au milieu de l'article.\u001b[0m\r\n"]
[22.678, "o", "\r\n"]
