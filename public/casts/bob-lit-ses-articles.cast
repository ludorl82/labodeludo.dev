{"version": 2, "width": 96, "height": 22, "title": "Bob lit ses articles (réponses réelles)", "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.0, "o", "\u001b[38;5;220m  ⚠  Les réponses sont RÉELLES — capturées le 11 septembre 2026\u001b[0m\r\n"]
[0.25, "o", "\u001b[38;5;246m     sur labodeludo.dev/api/bob/chat, mot pour mot, liens compris.\u001b[0m\r\n"]
[0.5, "o", "\u001b[38;5;246m     Seul le minutage est compressé.  labodeludo.dev/auteurs/bob/\u001b[0m\r\n"]
[3.3, "o", "\r\n"]
[3.85, "o", "\u001b[38;5;217m  ▄▄▄▄▄▄▄▄\u001b[0m   \u001b[1mbob --chat\u001b[0m  \u001b[38;5;246m+ recherche sémantique\u001b[0m\r\n"]
[4.05, "o", "\u001b[38;5;217m  █ ██ ██ █\u001b[0m  \u001b[38;5;246m915 tronçons d'articles, 1024 dimensions, int8\u001b[0m\r\n"]
[4.25, "o", "\u001b[38;5;217m  ▀▀    ▀▀\u001b[0m  \u001b[38;5;246mavant : il connaissait les titres. maintenant : le texte.\u001b[0m\r\n"]
