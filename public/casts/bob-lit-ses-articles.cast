[29.449, "o", "\u001b[38;5;114mbob\u001b[0m  \u001b[38;5;253mOuais, c'est tout récent — le 11 septembre dernier, j'ai publié\u001b[0m\r\n"]
[30.399, "o", "     \u001b[38;5;37m≡ J'ai fait parler mon blogue, et le modèle était la partie facile\u001b[0m\r\n"]
[30.999, "o", "     \u001b[38;5;253mpour dire comment on a mis ça sur pied. Y'a aussi un cast du même\u001b[0m\r\n"]
[31.899, "o", "     \u001b[38;5;253mjour qui répond à cinq questions posées directement au chatbot.\u001b[0m\r\n"]
