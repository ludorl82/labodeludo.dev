[13.624, "o", "\u001b[38;5;253m●\u001b[0m Taking a fresh etcd snapshot before touching membership — if this goes\r\n"]
[14.974, "o", "  wrong, the snapshot is the only way back.\r\n"]
[16.174, "o", "\r\n"]
[16.924, "o", "  \u001b[38;5;246mBash  ssh cloud-01 'sudo k3s etcd-snapshot save --name pre-removal'\u001b[0m\r\n"]
[17.624, "o", "\u001b[38;5;174m· Snapshotting…\u001b[0m \u001b[38;5;246m(22s · ↓ 0.9k tokens)\u001b[0m\r\n"]
