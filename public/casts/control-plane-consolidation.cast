[69.604, "o", "  \u001b[38;5;246mgpu-01     \u001b[38;5;114mReady   \u001b[38;5;246m <none>                4h4m    v1.36.2+k3s1\u001b[0m\r\n"]
[69.824, "o", "  \u001b[38;5;246mnode-01    \u001b[38;5;114mReady   \u001b[38;5;246m <none>                5d      v1.36.2+k3s1\u001b[0m\r\n"]
[70.044, "o", "  \u001b[38;5;246m… 4 worker nodes omitted from this recording\u001b[0m\r\n"]
[71.844, "o", "\u001b[38;5;253m●\u001b[0m cloud-01 never flinched this time. Stopping vm-06 for real now.\r\n"]
[73.044, "o", "\r\n"]
[73.594, "o", "  \u001b[38;5;246mBash  ssh vm-06 'sudo systemctl stop k3s' && curl -s -w '%{http_code}' …\u001b[0m\r\n"]
[74.294, "o", "  \u001b[38;5;246minactive\u001b[0m\r\n"]
[74.694, "o", "  \u001b[38;5;246mstatus.example.com  -> 200\u001b[0m\r\n"]
[75.044, "o", "  \u001b[38;5;246mjobs.example.com    -> 200\u001b[0m\r\n"]
[76.344, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;114mOne control-plane node, correctly sized.\u001b[0m Both members are out of etcd\r\n"]
[77.244, "o", "  cleanly and everything is still routing.\r\n"]
[78.644, "o", "\r\n"]
[79.194, "o", "  \u001b[38;5;246mThree voters became one. The redundancy that was lost\u001b[0m\r\n"]
[79.694, "o", "  \u001b[38;5;246mhad been protecting a majority that lived in one place anyway.\u001b[0m\r\n"]
