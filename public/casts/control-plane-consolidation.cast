[60.284, "o", "  \u001b[38;5;246m… 4 worker nodes omitted from this recording\u001b[0m\r\n"]
[62.084, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;114mQuorum restored.\u001b[0m API is answering again.\r\n"]
[63.484, "o", "\u001b[38;5;253m●\u001b[0m Now the right way round: delete the Node object while vm-06's etcd is\r\n"]
[64.484, "o", "  still running. That lets the raft cluster remove the member itself and\r\n"]
[65.384, "o", "  step down to a healthy single member — then, and only then, stop it.\r\n"]
[66.884, "o", "\r\n"]
[67.434, "o", "  \u001b[38;5;246mBash  ssh cloud-01 'k3s kubectl delete node vm-06'\u001b[0m\r\n"]
[68.134, "o", "  \u001b[38;5;246mnode \"vm-06\" deleted\u001b[0m\r\n"]
