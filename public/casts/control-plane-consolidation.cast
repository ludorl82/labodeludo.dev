[20.274, "o", "  \u001b[38;5;246m… 4 worker nodes omitted from this recording\u001b[0m\r\n"]
[22.074, "o", "\u001b[38;5;253m●\u001b[0m Three control-plane members, two of them leaving. Starting with cloud-02.\r\n"]
[23.274, "o", "\r\n"]
[23.824, "o", "  \u001b[38;5;246mBash  ssh cloud-02 'sudo systemctl stop k3s'\u001b[0m\r\n"]
[24.524, "o", "  \u001b[38;5;246minactive\u001b[0m\r\n"]
[25.124, "o", "\r\n"]
[25.674, "o", "  \u001b[38;5;246mBash  ssh cloud-01 'k3s kubectl delete node cloud-02'\u001b[0m\r\n"]
[26.374, "o", "  \u001b[38;5;246mnode \"cloud-02\" deleted\u001b[0m\r\n"]
[27.574, "o", "  \u001b[38;5;246mNAME       STATUS   ROLES                 AGE     VERSION\u001b[0m\r\n"]
