[79.874, "o", "  \u001b[38;5;246m… 4 worker nodes omitted from this recording\u001b[0m\r\n"]
[82.674, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;114mQuorum restored.\u001b[0m API is answering again.\r\n"]
[85.474, "o", "\u001b[38;5;253m●\u001b[0m Now the right way round: delete the Node object while vm-06's etcd is\r\n"]
[86.474, "o", "  still running. That lets the raft cluster remove the member itself and\r\n"]
[87.374, "o", "  step down to a healthy single member — then, and only then, stop it.\r\n"]
[89.774, "o", "\r\n"]
[90.524, "o", "  \u001b[38;5;246mBash  ssh cloud-01 'k3s kubectl delete node vm-06'\u001b[0m\r\n"]
[91.224, "o", "  \u001b[38;5;246mnode \"vm-06\" deleted\u001b[0m\r\n"]
[92.924, "o", "  \u001b[38;5;246mNAME       STATUS   ROLES                 AGE     VERSION\u001b[0m\r\n"]
[93.274, "o", "  \u001b[38;5;246mcloud-01   \u001b[38;5;114mReady   \u001b[38;5;246m control-plane,etcd    139m    v1.36.2+k3s1\u001b[0m\r\n"]
[93.574, "o", "  \u001b[38;5;246mgpu-01     \u001b[38;5;114mReady   \u001b[38;5;246m <none>                4h4m    v1.36.2+k3s1\u001b[0m\r\n"]
[93.874, "o", "  \u001b[38;5;246mnode-01    \u001b[38;5;114mReady   \u001b[38;5;246m <none>                5d      v1.36.2+k3s1\u001b[0m\r\n"]
[94.174, "o", "  \u001b[38;5;246m… 4 worker nodes omitted from this recording\u001b[0m\r\n"]
[96.974, "o", "\u001b[38;5;253m●\u001b[0m cloud-01 never flinched this time. Stopping vm-06 for real now.\r\n"]
[98.774, "o", "\r\n"]
[99.524, "o", "  \u001b[38;5;246mBash  ssh vm-06 'sudo systemctl stop k3s' && curl -s -w '%{http_code}' …\u001b[0m\r\n"]
[100.224, "o", "  \u001b[38;5;246minactive\u001b[0m\r\n"]
[100.624, "o", "  \u001b[38;5;246mstatus.example.com  -> 200\u001b[0m\r\n"]
[100.974, "o", "  \u001b[38;5;246mjobs.example.com    -> 200\u001b[0m\r\n"]
[103.174, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;114mOne control-plane node, correctly sized.\u001b[0m Both members are out of etcd\r\n"]
[104.074, "o", "  cleanly and everything is still routing.\r\n"]
[106.474, "o", "\r\n"]
[107.224, "o", "  \u001b[38;5;246mThree voters became one. The redundancy that was lost\u001b[0m\r\n"]
[108.324, "o", "  \u001b[38;5;246mhad been protecting a majority that lived in one place anyway.\u001b[0m\r\n"]
