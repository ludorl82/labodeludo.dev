[13.024, "o", "\u001b[38;5;253m●\u001b[0m Taking a fresh etcd snapshot before touching membership — if this goes\r\n"]
[13.924, "o", "  wrong, the snapshot is the only way back.\r\n"]
[15.124, "o", "\r\n"]
[15.674, "o", "  \u001b[38;5;246mBash  ssh cloud-01 'sudo k3s etcd-snapshot save --name pre-removal'\u001b[0m\r\n"]
[16.374, "o", "\u001b[38;5;174m· Snapshotting…\u001b[0m \u001b[38;5;246m(22s · ↓ 0.9k tokens)\u001b[0m\r\n"]
[18.374, "o", "\r\n"]
