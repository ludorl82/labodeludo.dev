[57.935, "o", "\u001b[38;5;253m●\u001b[0m Bien vu. \u001b[1mDu routage asymétrique\u001b[0m, classique d'un hôte à deux pattes :\r\n"]
[58.835, "o", "  la requête arrive par le routeur sur \u001b[38;5;114m192.0.2.141\u001b[0m, la réponse part directement\r\n"]
[59.635, "o", "  sur le réseau maison. Le pare-feu ne voit jamais le retour, TCP décroche.\r\n"]
[60.635, "o", "  \u001b[1mA.\u001b[0m routage par politique dans les VM : on répond par où on a reçu.\r\n"]
[61.235, "o", "  \u001b[1mB.\u001b[0m faire résoudre les clients de la maison vers 198.51.100.141.\r\n"]
[61.835, "o", "\r\n"]
