[131.226, "o", "\u001b[38;5;253m●\u001b[0m \u001b[1mLa bibliothèque Steam qui était sur ce SSD est perdue\u001b[0m : les jeux se\r\n"]
[132.126, "o", "  retéléchargent. Et arcade2 tourne encore sur le SSD jumeau, même modèle,\r\n"]
[132.926, "o", "  même âge : c'est le prochain candidat.\r\n"]
[134.526, "o", "\r\n"]
[135.076, "o", "\u001b[38;5;253m●\u001b[0m Deux « ne répond pas », et aucun n'était le réseau. \u001b[1mAvant de le soupçonner, demander\u001b[0m\r\n"]
