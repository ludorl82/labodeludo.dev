[169.456, "o", "\r\n"]
[170.006, "o", "  \u001b[38;5;114mdeployer: deploying generation 88ec6151 (switch)\u001b[0m\r\n"]
[170.406, "o", "  \u001b[38;5;114mnix: deployment ended\u001b[0m\r\n"]
[171.806, "o", "\u001b[38;5;253m●\u001b[0m vm-01 picked up the merge on its own: fetched master, evaluated,\r\n"]
[173.156, "o", "  switched — three seconds of work, one poll after the merge, no hands.\r\n"]
[174.356, "o", "  configurationRevision now equals origin/master.\r\n"]
[176.356, "o", "\r\n"]
[176.906, "o", "\u001b[38;5;246m  Le bouton merge est devenu le bouton deploy.\u001b[0m\r\n"]
