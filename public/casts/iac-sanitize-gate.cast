[15.781, "o", "\u001b[38;5;253m●\u001b[0m Both are sanitizable, and neither tracks state — *.tfstate is gitignored\r\n"]
[16.681, "o", "  in both, and git ls-files confirms zero tracked files.\r\n"]
[17.881, "o", "\r\n"]
[18.431, "o", "  \u001b[38;5;246mCalling Write 2 times…\u001b[0m\r\n"]
[19.131, "o", "\u001b[38;5;174m· Building…\u001b[0m \u001b[38;5;246m(3m 12s · ↓ 8.4k tokens)\u001b[0m\r\n"]
[21.131, "o", "\r\n"]
[21.681, "o", "\u001b[38;5;253m●\u001b[0m Copying only what git tracks, not an exclude list — tofu leaves real\r\n"]
[22.581, "o", "  state on disk, and an exclude list is one typo from shipping it.\r\n"]
[24.181, "o", "\u001b[38;5;253m●\u001b[0m Each sanitizer ends in a verification gate. The substitutions are best\r\n"]
[25.081, "o", "  effort; the gate is the guarantee. A missed rule fails the run instead\r\n"]
[25.831, "o", "  of leaking quietly.\r\n"]
[27.031, "o", "\r\n"]
[27.581, "o", "  \u001b[38;5;246mCalling Bash 1 time…\u001b[0m\r\n"]
[28.281, "o", "\u001b[38;5;174m· Validating…\u001b[0m \u001b[38;5;246m(9s · ↓ 0.7k tokens)\u001b[0m\r\n"]
[30.281, "o", "\r\n"]
[30.831, "o", "  \u001b[38;5;114mSuccess! The configuration is valid.\u001b[0m\r\n"]
