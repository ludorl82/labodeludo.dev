[12.131, "o", "\u001b[38;5;253m●\u001b[0m Both are sanitizable, and neither tracks state — *.tfstate is gitignored\r\n"]
[13.031, "o", "  in both, and git ls-files confirms zero tracked files.\r\n"]
[14.231, "o", "\r\n"]
[14.781, "o", "  \u001b[38;5;246mCalling Write 2 times…\u001b[0m\r\n"]
[15.481, "o", "\u001b[38;5;174m· Building…\u001b[0m \u001b[38;5;246m(3m 12s · ↓ 8.4k tokens)\u001b[0m\r\n"]
[17.481, "o", "\r\n"]
[18.031, "o", "\u001b[38;5;253m●\u001b[0m Copying only what git tracks, not an exclude list — tofu leaves real\r\n"]
[18.931, "o", "  state on disk, and an exclude list is one typo from shipping it.\r\n"]
[20.531, "o", "\u001b[38;5;253m●\u001b[0m Each sanitizer ends in a verification gate. The substitutions are best\r\n"]
[21.431, "o", "  effort; the gate is the guarantee. A missed rule fails the run instead\r\n"]
[22.181, "o", "  of leaking quietly.\r\n"]
[23.381, "o", "\r\n"]
[23.931, "o", "  \u001b[38;5;246mCalling Bash 1 time…\u001b[0m\r\n"]
[24.631, "o", "\u001b[38;5;174m· Validating…\u001b[0m \u001b[38;5;246m(9s · ↓ 0.7k tokens)\u001b[0m\r\n"]
[26.631, "o", "\r\n"]
[27.181, "o", "  \u001b[38;5;114mSuccess! The configuration is valid.\u001b[0m\r\n"]
