[33.531, "o", "\u001b[38;5;253m●\u001b[0m Both snapshots pass. Pushed — as private repos.\r\n"]
[34.831, "o", "\r\n"]
[35.381, "o", "  \u001b[38;5;220m\u001b[1mLeft them private on purpose: a review branch on a public repo\u001b[0m\r\n"]
[36.281, "o", "  \u001b[38;5;220mis already public. Say the word and I'll flip them.\u001b[0m\r\n"]
[36.881, "o", "  \u001b[38;5;246mwaiting for you…\u001b[0m\r\n"]
