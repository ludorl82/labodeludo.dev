[0.0, "o", "\u001b[38;5;220m  ⚠  Reconstitution condensée — pas une capture en direct.\u001b[0m\r\n"]
[0.25, "o", "\u001b[38;5;246m     Demandes et messages réels (16 sept. 2026), minutage compressé,\u001b[0m\r\n"]
[0.5, "o", "\u001b[38;5;246m     sorties réécrites, noms sanitisés.  labodeludo.dev/casts/\u001b[0m\r\n"]
