[77.18, "o", "\r\n"]
[77.73, "o", "\u001b[38;5;253m●\u001b[0m Environ cent requêtes à vingt secondes chacune, pour une seule session.\r\n"]
[78.63, "o", "\u001b[38;5;253m●\u001b[0m \u001b[1m1. Mesurer d'abord.\u001b[0m Ajouter la durée par session au journal.\r\n"]
[79.53, "o", "  \u001b[1m2. Donner un delta à A et C\u001b[0m, comme B et D en ont un.\r\n"]
[80.13, "o", "\r\n"]
[80.68, "o", "  \u001b[38;5;246mwaiting for you…\u001b[0m\r\n"]
[83.88, "o", "\u001b[38;5;37m─────────────────────────────────────────────────────────────────────────────── chaine-de-nuit\u001b[0m\r\n"]
