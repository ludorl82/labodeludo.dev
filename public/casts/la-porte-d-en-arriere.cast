[80.586, "o", "\u001b[38;5;253m●\u001b[0m Ça ressemble fortement à ce que j'avais volontairement laissé de côté.\r\n"]
[81.486, "o", "  Ton Mac joint l'adresse VLAN 10 par pfSense ; la réponse revient directement\r\n"]
[82.286, "o", "  par la patte 50. Je le vérifie avant de toucher quoi que ce soit.\r\n"]
[83.286, "o", "\r\n"]
[83.836, "o", "  \u001b[38;5;246mCalling Bash 5 times…\u001b[0m\r\n"]
[84.536, "o", "\u001b[38;5;174m· Lecture de la table d'états…\u001b[0m \u001b[38;5;246m(6m 40s · ↓ 3.6k tokens)\u001b[0m\r\n"]
[86.036, "o", "\r\n"]
[86.586, "o", "  \u001b[38;5;246mmvneta0.10  203.0.113.37 -> 192.0.2.136:22   \u001b[0m\u001b[38;5;174mSYN_SENT:CLOSED\u001b[0m\r\n"]
[86.986, "o", "  \u001b[38;5;246m            expires in 00:00:24 · \u001b[0m\u001b[38;5;174m22:0 pkts\u001b[0m\r\n"]
[88.386, "o", "\u001b[38;5;253m●\u001b[0m Pour pfSense, la connexion ne s'est jamais établie. \u001b[1mIl l'oublie après 30 s\u001b[0m\r\n"]
[89.286, "o", "  de silence, et jette le caractère suivant.\r\n"]
[90.286, "o", "\u001b[38;5;253m●\u001b[0m \u001b[1mUn cas laissé de côté exprès, à tort.\u001b[0m Mon transfert de 200 Mo durait dix\r\n"]
[91.186, "o", "  secondes : \u001b[1mun essai court ne rencontre jamais un délai d'inactivité.\u001b[0m\r\n"]
