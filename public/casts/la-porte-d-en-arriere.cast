[108.815, "o", "  \u001b[38;5;246mCalling Bash 6 times…\u001b[0m\r\n"]
[109.515, "o", "\u001b[38;5;174m· Règles et fiches de pfSense…\u001b[0m \u001b[38;5;246m(5m 02s · ↓ 4.1k tokens)\u001b[0m\r\n"]
[111.015, "o", "\r\n"]
[111.565, "o", "  \u001b[38;5;246mip rule sur console-vm          \u001b[0m\u001b[38;5;114m100 101 102 présentes\u001b[0m\r\n"]
[111.965, "o", "  \u001b[38;5;246mport 2222 → DNAT vers le conteneur de la console, port 22\u001b[0m\r\n"]
[112.365, "o", "  \u001b[38;5;246mmvneta0.10  … -> 192.0.2.136:2222   \u001b[0m\u001b[38;5;174mSYN_SENT:CLOSED · 24:0 pkts\u001b[0m\r\n"]
[113.765, "o", "\u001b[38;5;253m●\u001b[0m Les règles marchent pour ce qu'elles couvrent. Ta connexion prend le seul\r\n"]
[114.665, "o", "  chemin qu'elles ne voient pas : la réponse part de \u001b[1ml'adresse du conteneur\u001b[0m.\r\n"]
[115.465, "o", "  Option 1 : marquer la connexion à l'entrée, la reprendre à la sortie.\r\n"]
[116.065, "o", "\r\n"]
