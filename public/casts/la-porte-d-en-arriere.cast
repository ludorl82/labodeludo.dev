[57.505, "o", "\r\n"]
[58.055, "o", "  \u001b[38;5;246m9 hôtes déployés en < 2 min · TCP, deux pattes chacun : \u001b[0m\u001b[38;5;114m18 / 18\u001b[0m\r\n"]
[58.455, "o", "  \u001b[38;5;246mk3s : 10 noeuds Ready · 1 pod en échec\u001b[0m\r\n"]
[59.655, "o", "\u001b[38;5;253m●\u001b[0m Ce pod est un essai raté d'une CronJob, daté du 16 septembre. Il est\r\n"]
[60.555, "o", "  antérieur à mon changement : pas de ma faute, mais à regarder un jour.\r\n"]
[62.355, "o", "\r\n"]
[62.905, "o", "  \u001b[38;5;246m— le lendemain —\u001b[0m\r\n"]
