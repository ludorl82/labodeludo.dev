[19.261, "o", "  \u001b[38;5;246mCalling Bash 4 times…\u001b[0m\r\n"]
[19.961, "o", "\u001b[38;5;174m· Reproduction de la panne…\u001b[0m \u001b[38;5;246m(4m 12s · ↓ 2.9k tokens)\u001b[0m\r\n"]
[21.461, "o", "\r\n"]
[22.011, "o", "  \u001b[38;5;246mMac → vm-02 (VLAN 10)      \u001b[0m\u001b[38;5;114m200 Mo en 10 s\u001b[0m\r\n"]
[22.411, "o", "  \u001b[38;5;246mcloud-01 → vm-02 (VLAN 50) \u001b[0m\u001b[38;5;114mping ok\u001b[0m  \u001b[38;5;174mTCP : échec\u001b[0m\r\n"]
[22.811, "o", "  \u001b[38;5;246mip route get 198.18.0.2 from 203.0.113.134  →  via 192.0.2.254 dev \u001b[0m\u001b[38;5;174mens2\u001b[0m\r\n"]
[24.211, "o", "\u001b[38;5;253m●\u001b[0m Depuis ton Mac, tout passe. La panne frappe un pair hors des deux réseaux,\r\n"]
[25.111, "o", "  comme cloud-01 : la réponse part de l'adresse 50, mais suit la route par\r\n"]
[25.911, "o", "  défaut, côté VLAN 10. \u001b[1mpfSense voit revenir la réponse par l'autre porte.\u001b[0m\r\n"]
[27.311, "o", "\u001b[38;5;253m●\u001b[0m J'applique les deux règles à la main, je teste, je les retire.\r\n"]
[28.211, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;174mRien n'a tourné\u001b[0m : mon propre shell est aussi zsh, et la variable ne\r\n"]
[29.111, "o", "  s'est pas découpée. Aucune règle posée. Je refais par l'entrée standard.\r\n"]
[30.311, "o", "\r\n"]
[30.861, "o", "  \u001b[38;5;246mCalling Bash 3 times…\u001b[0m\r\n"]
[31.561, "o", "  \u001b[38;5;246mvm-02, depuis cloud-01   avant : \u001b[0m\u001b[38;5;174méchec\u001b[0m\u001b[38;5;246m   règles posées : \u001b[0m\u001b[38;5;114mbannière\u001b[0m\u001b[38;5;246m   retirées : \u001b[0m\u001b[38;5;174méchec\u001b[0m\r\n"]
[32.961, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;114m100\u001b[0m : la table principale \u001b[1msans sa route par défaut\u001b[0m (suppress_prefixlength 0)\r\n"]
[33.861, "o", "  — le LAN et les pods gardent leur chemin. \u001b[38;5;114m101\u001b[0m : le reste repart côté 50.\r\n"]
[34.661, "o", "  Module \u001b[38;5;114mlabo.dualHomed\u001b[0m, activé sur vm-02 seulement, comme témoin.\r\n"]
[35.261, "o", "\r\n"]
[35.811, "o", "  \u001b[38;5;246mwaiting for you…\u001b[0m\r\n"]
