[43.247, "o", "\u001b[38;5;174m· Déploiement par comin, puis essais…\u001b[0m \u001b[38;5;246m(8m 03s · ↓ 4.4k tokens)\u001b[0m\r\n"]
[44.747, "o", "\r\n"]
[45.297, "o", "\u001b[38;5;253m●\u001b[0m Le témoin tient. Avant d'élargir, les deux autres câblages, à la main :\r\n"]
[46.197, "o", "  \u001b[38;5;246mpi-01  (physique)      avant : \u001b[0m\u001b[38;5;174méchec\u001b[0m\u001b[38;5;246m   règles : \u001b[0m\u001b[38;5;114mbannière\u001b[0m\u001b[38;5;246m   retirées : \u001b[0m\u001b[38;5;174méchec\u001b[0m\r\n"]
[46.597, "o", "  \u001b[38;5;246msrv-01 (hyperviseur)   avant : \u001b[0m\u001b[38;5;174méchec\u001b[0m\u001b[38;5;246m   règles : \u001b[0m\u001b[38;5;114mbannière\u001b[0m\u001b[38;5;246m   retirées : \u001b[0m\u001b[38;5;174méchec\u001b[0m\r\n"]
[47.797, "o", "  Les treize systèmes s'évaluent. La PR pour les huit autres est prête.\r\n"]
[48.397, "o", "\r\n"]
