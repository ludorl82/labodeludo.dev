[127.684, "o", "\u001b[38;5;253m●\u001b[0m Option \u001b[38;5;114mdnatReplies\u001b[0m : CONNMARK + règle \u001b[38;5;114m103\u001b[0m, sur console-vm seulement.\r\n"]
