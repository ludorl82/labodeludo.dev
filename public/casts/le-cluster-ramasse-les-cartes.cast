[85.488, "o", "  \u001b[38;5;246mCalling Bash 23 times…\u001b[0m\r\n"]
[86.188, "o", "\u001b[38;5;174m· Démarrage de vm-03 avec trois cartes…\u001b[0m \u001b[38;5;246m(26m 40s · ↓ 9.6k tokens)\u001b[0m\r\n"]
[87.588, "o", "\r\n"]
[88.138, "o", "  \u001b[38;5;246m0 carte            \u001b[0m\u001b[38;5;114minstalleur debout en 24 s\u001b[0m\r\n"]
[88.538, "o", "  \u001b[38;5;246m1 carte            \u001b[0m\u001b[38;5;174mrien\u001b[0m\r\n"]
[88.938, "o", "  \u001b[38;5;246mvirsh screenshot   \u001b[0m\u001b[38;5;220mShell> — lecteur CD vide\u001b[0m\r\n"]
[90.238, "o", "\u001b[38;5;253m●\u001b[0m \u001b[1mMon bisect était faussé.\u001b[0m La variante à une carte venait du XML du dépôt,\r\n"]
[91.138, "o", "  où le lecteur est vide : j'ai comparé une VM avec CD à une VM sans.\r\n"]
[91.938, "o", "  Une carte démarre. Trois calent. Fenêtre MMIO à 64 Gio : \u001b[38;5;174msans effet\u001b[0m.\r\n"]
[92.738, "o", "  J'installe vm-03 avec la 960 seule et je m'arrête là pour ce soir.\r\n"]
[94.338, "o", "\u001b[38;5;37m─────────────────────────────────────────────────────────────────────────────────────── master\u001b[0m\r\n"]
