[118.776, "o", "\u001b[38;5;174m· Cycles start / stop…\u001b[0m \u001b[38;5;246m(45m 30s · ↓ 12.1k tokens)\u001b[0m\r\n"]
[120.176, "o", "\r\n"]
[120.726, "o", "  \u001b[38;5;246mdrain vm-03   \u001b[0m\u001b[38;5;174msudo: …/sw/bin/sudo must be owned by uid 0 and have the setuid bit set\u001b[0m\r\n"]
[121.226, "o", "  \u001b[38;5;246mrelease       \u001b[0m\u001b[38;5;174mvm-03 revient SchedulingDisabled\u001b[0m\r\n"]
[121.726, "o", "  \u001b[38;5;246m2ᵉ cycle      \u001b[0m\u001b[38;5;174mUnit gamemode-start-vm-03.service was already loaded\u001b[0m\r\n"]
[122.226, "o", "  \u001b[38;5;246mstop jeu-01   \u001b[0m\u001b[38;5;174mQEMU guest agent is not connected\u001b[0m\r\n"]
[123.626, "o", "\u001b[38;5;253m●\u001b[0m Quatre bogues, et mes deux premiers correctifs « évidents » ont échoué :\r\n"]
[124.526, "o", "  le seul sudo setuid de NixOS vit dans \u001b[38;5;114m/run/wrappers/bin\u001b[0m, que mon PATH\r\n"]
[125.326, "o", "  masquait. Le cordon survit au reboot : le hook décordonne au release.\r\n"]
[126.126, "o", "  Noms d'unité générés + \u001b[38;5;114m--collect\u001b[0m. 3ᵉ cycle : \u001b[38;5;114mvm-03 drained\u001b[0m.\r\n"]
[127.726, "o", "\u001b[38;5;37m─────────────────────────────────────────────────────────────────────────────────────── master\u001b[0m\r\n"]
