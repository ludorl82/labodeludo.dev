[48.401, "o", "  \u001b[38;5;246m[photo de l'écran]  INFO: task iptables-restor blocked for more than 122 s\u001b[0m\r\n"]
[48.801, "o", "  \u001b[38;5;246m                    bridge · k3s-agent · modprobe · udev-worker → en attente\u001b[0m\r\n"]
[50.101, "o", "\u001b[38;5;253m●\u001b[0m Ce n'est pas le PATH, \u001b[1mje retire cette hypothèse\u001b[0m. C'est un blocage noyau :\r\n"]
[51.001, "o", "  modprobe coincé, k3s n'obtient jamais br_netfilter, aucun conteneur ne naît.\r\n"]
[51.801, "o", "  Le seul élément nouveau : le module NVIDIA (\u001b[38;5;174mTainted: P\u001b[0m). Je le retire.\r\n"]
[52.801, "o", "\u001b[38;5;253m●\u001b[0m Retour arrière poussé, mais sshd n'ouvre plus de session.\r\n"]
