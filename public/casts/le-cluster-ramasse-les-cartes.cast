[35.871, "o", "\u001b[38;5;253m●\u001b[0m C'est \u001b[1mmon changement\u001b[0m qui a cassé la création de conteneurs. Suspect :\r\n"]
[36.771, "o", "  le PATH de l'unité k3s, que j'ai peut-être remplacé au lieu de l'étendre.\r\n"]
[37.571, "o", "\u001b[38;5;253m●\u001b[0m Et je ne peux pas le vérifier : ma boucle d'attente a martelé sshd au\r\n"]
[38.471, "o", "  démarrage, \u001b[1mje me suis verrouillé dehors\u001b[0m. J'aurais dû sonder le bail.\r\n"]
[39.271, "o", "  Si tu peux taper \u001b[38;5;114mjournalctl -u k3s -n 40\u001b[0m devant la machine…\r\n"]
