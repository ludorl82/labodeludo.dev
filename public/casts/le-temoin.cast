[18.029, "o", "\u001b[0m\r\n"]
[19.829, "o", "\r\n"]
[20.379, "o", "\u001b[38;5;253m●\u001b[0m L'anneau rouge au réveil, avec un assistant qui répond correctement —\r\n"]
[21.279, "o", "  ça sent la couche d'affichage, pas la chaîne vocale. Je vérifie quand\r\n"]
[22.079, "o", "  même la piste connue avant de spéculer.\r\n"]
[23.579, "o", "\u001b[38;5;253m●\u001b[0m Le 5 août, un moteur TTS tombé en « unavailable » donnait exactement\r\n"]
[24.479, "o", "  cette signature. C'est la première chose à écarter.\r\n"]
[25.679, "o", "\r\n"]
[26.229, "o", "  \u001b[38;5;246mCalling Bash 2 times…\u001b[0m\r\n"]
[26.929, "o", "\u001b[38;5;174m· Interrogation des moteurs…\u001b[0m \u001b[38;5;246m(8s · ↓ 1.1k tokens)\u001b[0m\r\n"]
[28.929, "o", "\r\n"]
[29.479, "o", "  \u001b[38;5;246mtts.cloud_a       \u001b[0m\u001b[38;5;114mok\u001b[0m   \u001b[38;5;246mdernier appel il y a 1 s\u001b[0m\r\n"]
[29.929, "o", "  \u001b[38;5;246mtts.local_b       \u001b[0m\u001b[38;5;114mok\u001b[0m   \u001b[38;5;246mdernier appel il y a 1 s\u001b[0m\r\n"]
[30.379, "o", "  \u001b[38;5;246mstt.local         \u001b[0m\u001b[38;5;114mok\u001b[0m\r\n"]
[31.679, "o", "\u001b[38;5;253m●\u001b[0m Tous sains, et deux d'entre eux ont répondu à une seconde d'intervalle.\r\n"]
[32.579, "o", "  Ce n'est pas la signature d'août. Hypothèse écartée.\r\n"]
[34.179, "o", "\u001b[38;5;253m●\u001b[0m Deuxième piste : l'animation d'écoute du firmware peint l'anneau en\r\n"]
[35.079, "o", "  même temps que mon automatisation. Un conflit en direct expliquerait\r\n"]
[35.879, "o", "  pourquoi la couleur est bonne au repos et fausse au réveil.\r\n"]
[37.079, "o", "\u001b[38;5;253m●\u001b[0m Je redémarre l'appareil pour repartir d'un état propre.\r\n"]
[37.979, "o", "\r\n"]
[38.529, "o", "  \u001b[38;5;246mCalling Bash 1 time…\u001b[0m\r\n"]
[39.229, "o", "\u001b[38;5;174m· Redémarrage…\u001b[0m \u001b[38;5;246m(22s · ↓ 0.4k tokens)\u001b[0m\r\n"]
[41.229, "o", "\r\n"]
[41.779, "o", "  \u001b[38;5;114mvoix-01 en ligne\u001b[0m  \u001b[38;5;246manneau : (255, 0, 0) · luminosité 64\u001b[0m\r\n"]
[43.179, "o", "\u001b[38;5;253m●\u001b[0m Le redémarrage n'a rien changé. Ça pointe vers un conflit vivant\r\n"]
[44.079, "o", "  plutôt que vers un état rémanent — je prépare un test qui coupe\r\n"]
[44.879, "o", "  l'animation pour isoler.\r\n"]
[46.679, "o", "\u001b[38;5;37m──────────────────────────────────────────────────────────────────────────────── mot-de-reveil\u001b[0m\r\n"]
