[80.938, "o", "\r\n"]
[81.488, "o", "  \u001b[38;5;114m7/7 NFS workloads NotReady — detection complete\u001b[0m\r\n"]
[82.388, "o", "  \u001b[38;5;114m9/10 containers recovered unattended after power back\u001b[0m\r\n"]
[83.288, "o", "  \u001b[38;5;174mloki: CrashLoopBackOff (restarts 4 → 6)\u001b[0m\r\n"]
[85.088, "o", "\u001b[38;5;253m●\u001b[0m loki can't replay its WAL: it deletes segment files it still holds\r\n"]
[85.988, "o", "  open, NFS turns that into a silly-rename to .nfsXXXX, and the rmdir\r\n"]
[86.788, "o", "  dies with ENOTEMPTY. Every restart regenerates the failure — a stable\r\n"]
[87.588, "o", "  equilibrium, not residue. Waiting will not fix it.\r\n"]
[89.188, "o", "\r\n"]
[89.738, "o", "  \u001b[38;5;246mCalling Bash 1 time…\u001b[0m\r\n"]
[90.438, "o", "  \u001b[38;5;174m\u001b[1mPermission denied by the auto mode classifier\u001b[0m\r\n"]
[91.238, "o", "  \u001b[38;5;246m  kubectl exec loki-fix -- mv /loki/…/wal /loki/…/wal.broken\u001b[0m\r\n"]
[92.638, "o", "\r\n"]
[93.188, "o", "  \u001b[38;5;220m\u001b[1mI need to stop and get your call on one command.\u001b[0m\r\n"]
[94.088, "o", "  \u001b[38;5;220mmv on loki's data volume — blocked, reasonably. Risk is nil: all\u001b[0m\r\n"]
[94.688, "o", "  \u001b[38;5;246mwaiting for you…\u001b[0m\r\n"]
