[60.74, "o", "\r\n"]
[61.29, "o", "  \u001b[38;5;253mcronicle  \u001b[38;5;174m0/1\u001b[0m   \u001b[38;5;253mgrafana  \u001b[38;5;174m0/1\u001b[0m   \u001b[38;5;253mn8n  \u001b[38;5;174m0/1\u001b[0m   \u001b[38;5;253mnginx  \u001b[38;5;174m0/1\u001b[0m\r\n"]
[61.99, "o", "  \u001b[38;5;253mloki      \u001b[38;5;114m1/1\u001b[0m   \u001b[38;5;253msftpgo   \u001b[38;5;114m1/1\u001b[0m   \u001b[38;5;253mmongo \u001b[38;5;114m1/1\u001b[0m   \u001b[38;5;246m← still lying\u001b[0m\r\n"]
[63.79, "o", "\u001b[38;5;253m●\u001b[0m Four are already NotReady — and the three that aren't are each a lesson.\r\n"]
[64.79, "o", "\u001b[38;5;253m●\u001b[0m loki's /ready returns 200 with the NAS physically dead: it reports\r\n"]
[65.69, "o", "  ingester state from memory and never touches the volume.\r\n"]
[67.09, "o", "\u001b[38;5;253m●\u001b[0m The ls-based probes ride the NFS attribute cache (~60s). Only a write\r\n"]
[67.99, "o", "  is forced to the server. Every exec probe becomes touch, not ls.\r\n"]
