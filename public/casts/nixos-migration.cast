[19.765, "o", ";"]
[19.857, "o", "2"]
[19.904, "o", "5"]
[19.981, "o", "3"]
[20.038, "o", "m"]
[20.091, "o", "n"]
[20.14, "o", "v"]
[20.239, "o", "m"]
