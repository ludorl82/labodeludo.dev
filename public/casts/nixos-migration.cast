[21.197, "o", "a"]
[21.268, "o", "m"]
[21.374, "o", "e"]
[21.486, "o", " "]
[21.542, "o", "v"]
[21.599, "o", "m"]
[21.661, "o", "-"]
[21.722, "o", "0"]
[21.801, "o", "5"]
[21.887, "o", "\u001b"]
