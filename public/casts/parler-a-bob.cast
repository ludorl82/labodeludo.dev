[26.413, "o", "     \u001b[38;5;253mqui est là, mais Proxmox n'apparaît ni ici ni ailleurs dans\u001b[0m\r\n"]
[27.313, "o", "     \u001b[38;5;253mle sommaire.\u001b[0m\r\n"]
[29.113, "o", "\r\n"]
[29.663, "o", "  \u001b[38;5;220mIl refuse plutôt que d'inventer. C'est la fonctionnalité, pas la limite.\u001b[0m\r\n"]
