[57.407, "o", "  \u001b[38;5;246m(⌐■_■) Se gratte la tête… (2s)\u001b[0m\r\n"]
[58.307, "o", "\u001b[38;5;114mbob\u001b[0m  \u001b[38;5;253mGaming-01 a une RTX 3060 en passthrough pour le jeu, pis gpu-01\u001b[0m\r\n"]
