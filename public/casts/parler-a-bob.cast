[69.338, "o", "\u001b[38;5;114mbob\u001b[0m  \u001b[38;5;253mLe modèle qui répond ici, c'est qwen35-q4kl, servi par Ollama sur\u001b[0m\r\n"]
[70.288, "o", "     \u001b[38;5;253mune carte graphique du parc. Y'a aucun fournisseur d'IA\u001b[0m\r\n"]
[71.188, "o", "     \u001b[38;5;253minfonuagique dans le portrait, juste ma propre machine.\u001b[0m\r\n"]
[73.588, "o", "\r\n"]
[74.138, "o", "  \u001b[38;5;37m──────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[74.838, "o", "  \u001b[38;5;246mIl ne sait que ce que le labo publie : l'inventaire assaini,\u001b[0m\r\n"]
