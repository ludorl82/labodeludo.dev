[75.412, "o", "  \u001b[38;5;253mnode/gpu-01 cordoned\u001b[0m\r\n"]
[76.112, "o", "  \u001b[38;5;253mevicting pod cronicle/cronicle-e83a1…   \u001b[38;5;246mt+0s\u001b[0m\r\n"]
[77.212, "o", "  \u001b[38;5;246mNAME              STATUS              NODE     AGE\u001b[0m\r\n"]
[77.712, "o", "  \u001b[38;5;253mcronicle-e83a1   \u001b[0m \u001b[38;5;174mTerminating        \u001b[0m \u001b[38;5;253mgpu-01  \u001b[0m \u001b[38;5;246m41m\u001b[0m\r\n"]
[78.512, "o", "  \u001b[38;5;253mcronicle-f96d2   \u001b[0m \u001b[38;5;220mPending            \u001b[0m \u001b[38;5;253m<none>  \u001b[0m \u001b[38;5;246m0s\u001b[0m\r\n"]
[79.212, "o", "  \u001b[38;5;253mcronicle-f96d2   \u001b[0m \u001b[38;5;220mContainerCreating  \u001b[0m \u001b[38;5;253mvm-01   \u001b[0m \u001b[38;5;246m1s\u001b[0m\r\n"]
[80.212, "o", "  \u001b[38;5;253mcronicle-f96d2   \u001b[0m \u001b[38;5;114mRunning            \u001b[0m \u001b[38;5;253mvm-01   \u001b[0m \u001b[38;5;246m4s\u001b[0m\r\n"]
[81.112, "o", "  \u001b[38;5;253mcronicle-f96d2   \u001b[0m \u001b[38;5;114mRunning 1/1        \u001b[0m \u001b[38;5;253mvm-01   \u001b[0m \u001b[38;5;246m12s\u001b[0m\r\n"]
[82.912, "o", "  \u001b[38;5;114mscheduler ready on vm-01 — \u001b[1m12 s\u001b[0m\u001b[38;5;114m after the eviction\u001b[0m\r\n"]
[83.912, "o", "  \u001b[38;5;114mhistory intact: 30 events, job logs readable, S3 reads 140 ms\u001b[0m\r\n"]
[85.712, "o", "\u001b[38;5;253m●\u001b[0m Twelve seconds, and none of them were spent moving data — there is no\r\n"]
[86.612, "o", "  data to move. The pod carries its image and its config; everything it\r\n"]
[87.412, "o", "  knows is in s3://scheduler-data, which never noticed the drain.\r\n"]
[89.012, "o", "\u001b[38;5;253m●\u001b[0m That is the whole trade. Before, the node owned the pod. Now any node\r\n"]
[89.912, "o", "  with CPU and RAM will do — gpu-01 is just hardware again.\r\n"]
[91.612, "o", "\r\n"]
[92.162, "o", "  \u001b[38;5;246mreboot gpu-01 whenever you like.\u001b[0m\r\n"]
