[19.565, "o", "\u001b[38;5;174m· Draining…\u001b[0m \u001b[38;5;246m(22s · ↓ 1.1k tokens)\u001b[0m\r\n"]
[21.565, "o", "\r\n"]
[22.115, "o", "  \u001b[38;5;253mnode/gpu-01 cordoned\u001b[0m\r\n"]
[22.815, "o", "  \u001b[38;5;253mevicting pod cronicle/cronicle-7d4f9…\u001b[0m\r\n"]
[24.115, "o", "  \u001b[38;5;246mNAME              STATUS              NODE     AGE\u001b[0m\r\n"]
[24.615, "o", "  \u001b[38;5;253mcronicle-7d4f9   \u001b[0m \u001b[38;5;174mTerminating        \u001b[0m \u001b[38;5;253mgpu-01  \u001b[0m \u001b[38;5;246m13d\u001b[0m\r\n"]
[25.415, "o", "  \u001b[38;5;253mcronicle-b112c   \u001b[0m \u001b[38;5;220mPending            \u001b[0m \u001b[38;5;253m<none>  \u001b[0m \u001b[38;5;246m2s\u001b[0m\r\n"]
[26.315, "o", "  \u001b[38;5;253mcronicle-b112c   \u001b[0m \u001b[38;5;220mPending            \u001b[0m \u001b[38;5;253m<none>  \u001b[0m \u001b[38;5;246m45s\u001b[0m\r\n"]
[27.215, "o", "  \u001b[38;5;253mcronicle-b112c   \u001b[0m \u001b[38;5;220mPending            \u001b[0m \u001b[38;5;253m<none>  \u001b[0m \u001b[38;5;246m2m11s\u001b[0m\r\n"]
[28.815, "o", "\r\n"]
[29.365, "o", "  \u001b[38;5;246mCalling Bash 1 time…\u001b[0m\r\n"]
[30.065, "o", "  \u001b[38;5;174mWarning  FailedScheduling\u001b[0m\r\n"]
[30.665, "o", "  \u001b[38;5;246m  0/9 nodes are available: 1 node(s) had volume node affinity\u001b[0m\r\n"]
[31.165, "o", "  \u001b[38;5;246m  conflict, 8 node(s) didn't find available persistent volume\u001b[0m\r\n"]
[32.665, "o", "\u001b[38;5;253m●\u001b[0m The drain worked; the scheduler didn't survive it. Its volume is bound\r\n"]
[33.565, "o", "  to gpu-01's local disk, so the replacement pod can only run on the one\r\n"]
[34.365, "o", "  node you just emptied. Eight healthy nodes, zero candidates.\r\n"]
[35.865, "o", "\u001b[38;5;253m●\u001b[0m Nothing is broken. This is the configuration doing exactly what it\r\n"]
[36.765, "o", "  says: the data lives on that node, so the pod belongs to that node.\r\n"]
[38.365, "o", "\r\n"]
[38.915, "o", "  \u001b[38;5;220m\u001b[1mLe pod n'a nulle part où aller.\u001b[0m\r\n"]
[39.815, "o", "  \u001b[38;5;246muncordon gpu-01, ou pas de planificateur pendant le reboot.\u001b[0m\r\n"]
