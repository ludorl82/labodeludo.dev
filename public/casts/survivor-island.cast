[69.423, "o", "\u001b[38;5;174m·\u001b[0m \u001b[38;5;246mReading BMC LAN config in-band via Microsoft_IPMI WMI… (24s · ↓ 1.8k tokens)\u001b[0m\r\n"]
[70.823, "o", "  \u001b[38;5;246mparam 20 (802.1q): 0x1e 0x80 — VLAN 30, enabled\u001b[0m\r\n"]
[71.923, "o", "\r\n"]
[72.473, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;253mFound it! The BMC's VLAN tag reads VLAN 30 — it should be VLAN 10. The\u001b[0m\r\n"]
[73.373, "o", "  \u001b[38;5;253mcold AC cycle scrambled it: alive the whole time, tagging its traffic\u001b[0m\r\n"]
[74.273, "o", "  \u001b[38;5;253monto the wrong network. Fixing it in-band:\u001b[0m\r\n"]
[75.173, "o", "\u001b[38;5;174m·\u001b[0m \u001b[38;5;246mSetting param 20 → VLAN 10 via raw IPMI… cc=0\u001b[0m\r\n"]
[76.373, "o", "  \u001b[38;5;114m✓\u001b[0m \u001b[38;5;253mwin-01 BMC answering after 10s\u001b[0m\r\n"]
[77.373, "o", "\r\n"]
[77.923, "o", "\u001b[38;5;174m·\u001b[0m \u001b[38;5;246mWaiting for the latch… (70s)\u001b[0m\r\n"]
[79.323, "o", "  \u001b[38;5;114m✓\u001b[0m \u001b[38;5;253mpower restored and all chassis on: latch cleared\u001b[0m\r\n"]
[80.223, "o", "  \u001b[38;5;114m✓\u001b[0m \u001b[38;5;253mntfy → \"Rolling rack awake after power event\"\u001b[0m\r\n"]
[81.323, "o", "\r\n"]
[81.873, "o", "\u001b[38;5;253m●\u001b[0m \u001b[38;5;253mThe latch cleared and sent its notification — full recovery, closed\u001b[0m\r\n"]
[82.873, "o", "  \u001b[38;5;253mloop, by the system itself. All 9 cluster nodes Ready.\u001b[0m\r\n"]
