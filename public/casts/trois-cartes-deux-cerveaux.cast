[119.083, "o", "\u001b[0m\r\n"]
[120.283, "o", "\r\n"]
[120.833, "o", "\u001b[38;5;253m●\u001b[0m Elle ne se vidait presque jamais. \u001b[1mElle était chaude pour le mauvais prompt.\u001b[0m\r\n"]
[121.733, "o", "  Une question du Voice PE ajoute sa pièce et ses minuteries : le prompt diffère dès\r\n"]
[122.533, "o", "  le jeton 3 761, avant tout point de contrôle. Le réchauffement de 6 h, lui, ne\r\n"]
[123.333, "o", "  pouvait pas dire de quel appareil il venait.\r\n"]
[124.333, "o", "  \u001b[38;5;246msalle à manger : 'Dis-moi juste bonsoir.'   \u001b[0m\u001b[38;5;174m7,4 s\u001b[0m\r\n"]
[124.633, "o", "  \u001b[38;5;246msalle à manger : 'Dis-moi juste allô.'      \u001b[0m\u001b[38;5;114m0,8 s\u001b[0m\r\n"]
[125.933, "o", "\u001b[38;5;253m●\u001b[0m Et ce n'était \u001b[1mpas le chat du site\u001b[0m : après une question au chat, la voix a\r\n"]
[126.833, "o", "  restauré son point de contrôle et relu 4 jetons. On l'a soupçonné deux fois.\r\n"]
[128.633, "o", "\r\n"]
[129.183, "o", "\u001b[38;5;253m●\u001b[0m \u001b[1mDans un prompt mis en cache, ce qui change va à la fin.\u001b[0m Sur un hybride, la\r\n"]
[130.083, "o", "  fin, c'est après le dernier point de contrôle : la question, ou la réponse d'un outil.\r\n"]
[132.483, "o", "\r\n"]
