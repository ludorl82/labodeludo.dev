[101.719, "o", "  \u001b[38;5;246mCalling Bash 5 times…\u001b[0m\r\n"]
[102.419, "o", "\u001b[38;5;174m· mesure-prefixe.sh, répétition…\u001b[0m \u001b[38;5;246m(1m 12s · ↓ 2.2k tokens)\u001b[0m\r\n"]
[103.619, "o", "\r\n"]
[104.169, "o", "  \u001b[38;5;246mprompt_eval_count   \u001b[0m\u001b[38;5;174m4 501 · 4 501 · 4 501\u001b[0m  \u001b[38;5;246m— Ollama renvoie toujours le total\u001b[0m\r\n"]
[104.669, "o", "  \u001b[38;5;246m→ lire le journal de llama-server à la place\u001b[0m\r\n"]
[105.269, "o", "  \u001b[38;5;246ml'heure en tête du prompt système   4,88 s   \u001b[0m\u001b[38;5;174m3 483 jetons relus\u001b[0m\r\n"]
[105.669, "o", "  \u001b[38;5;246ml'heure à la fin du prompt système  2,23 s   \u001b[0m\u001b[38;5;220m1 024 jetons relus\u001b[0m\r\n"]
[106.069, "o", "  \u001b[38;5;246ml'heure dans la question            0,37 s   \u001b[0m\u001b[38;5;114m   29 jetons relus\u001b[0m\r\n"]
[107.569, "o", "\u001b[38;5;253m●\u001b[0m \u001b[1mLa fin du prompt système ne suffit pas.\u001b[0m Un hybride ne reprend qu'à un point de\r\n"]
[108.469, "o", "  contrôle, et le seul pris avant l'heure tombe environ mille jetons plus haut.\r\n"]
[109.469, "o", "\u001b[38;5;253m●\u001b[0m Et deux choses que je t'ai dites le 25 septembre étaient fausses : Home Assistant\r\n"]
[110.369, "o", "  n'ajoute pas l'heure à la fin, il donne l'outil \u001b[38;5;114mGetDateTime\u001b[0m ; et le « 5 200 → 4 500\r\n"]
[111.169, "o", "  jetons » n'était pas l'effet du correctif, mais l'écart entre deux appareils.\r\n"]
