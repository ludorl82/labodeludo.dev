---
/* Mention d'écriture assistée par IA, en tête de chaque article.
   Le niveau vient du champ `ia` du frontmatter, obligatoire (content.config.ts).
   Avec `certificat` (Humanums), un article `aucune` montre le badge et le lien
   de vérification; une traduction `assistee` renvoie à l'original certifié.
   Le badge est une copie locale de humanums.com/api/badge/<id> : la page ne
   charge rien de leur domaine, seul le lien y mène. */
interface Props {
  ia: "aucune" | "assistee" | "redigee";
  outils?: string;
  certificat?: string;
  lang?: "fr" | "en";
}

const { ia, outils, certificat, lang = "fr" } = Astro.props;
const policy = "/politique-de-confidentialite/";
const verify = certificat && `https://humanums.com/verify/${certificat}`;

const text = {
  fr: {
    assistee: `Rédigé avec l'aide de l'intelligence artificielle (${outils}). Ludo a relu et validé le texte.`,
    redigee: "Rédigé par Bob, un assistant d'intelligence artificielle, à partir du travail fait en session avec Ludo.",
    more: "Comment l'IA est utilisée ici",
    humain: "Texte écrit par Ludo sans IA et certifié par Humanums, puis corrigé pour la forme (orthographe, ponctuation, mise en listes) avec Claude Code. Les tableaux, l'extrait de session et la capture de console, avec leurs légendes, ont été ajoutés à la mise en page avec Claude Code.",
    certificat: "Voir le certificat",
    original: "Traduction d'un original certifié écrit par un humain",
  },
  en: {
    assistee: `Written with the help of artificial intelligence (${outils}). Ludo reviewed and approved the text.`,
    redigee: "Written by Bob, an artificial intelligence assistant, from work done in session with Ludo.",
    more: "How AI is used here (French)",
    humain: "Written by Ludo without AI and certified by Humanums, then corrected for form (spelling, punctuation, lists) with Claude Code. The tables, the session excerpt and the console capture, with their captions, were added during layout with Claude Code.",
    certificat: "See the certificate",
    original: "This is a translation; the French original is certified as human-written",
  },
}[lang];
---

{ia === "aucune" && verify && (
  <p class="ai-notice human" role="note">
    <a class="badge" href={verify} rel="noopener">
      <img src={`/images/humanums/${certificat}.svg`} width="180" height="46" alt={`Verified Human, Humanums ${certificat}`} />
    </a>
    <span>{text.humain} <a href={verify} rel="noopener">{text.certificat}</a>.</span>
  </p>
)}

{ia !== "aucune" && (
  <p class="ai-notice" role="note">
    <span class="tag" aria-hidden="true">IA</span>
    <span>
      {text[ia]} {verify && <>{text.original} (<a href={verify} rel="noopener">{certificat}</a>). </>}
      <a href={policy}>{text.more}</a>.
    </span>
  </p>
)}

<style>
  .ai-notice {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
    max-width: var(--measure);
    margin: 1rem 0 0;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .ai-notice .tag {
    flex: none;
    padding: 0 0.4em;
    border: 1px solid currentColor;
    border-radius: 3px;
    font-size: 0.6875rem;
    letter-spacing: 0.05em;
  }

  .ai-notice a {
    color: inherit;
  }

  .ai-notice.human {
    align-items: center;
    flex-wrap: wrap;
  }

  .ai-notice .badge {
    flex: none;
    line-height: 0;
  }

  .ai-notice .badge img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .ai-notice a:hover {
    color: var(--accent-live);
  }
</style>
