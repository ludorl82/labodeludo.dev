---
// The generated half of /architecture, rendered only when the hub's
// showLiveArch gate is on (SHOW_LIVE_ARCH=1: staging + the nightly job).
import LiveArchDiagram from "./LiveArchDiagram.astro";
import arch from "../data/architecture.json";

// The generated architecture view. Everything on this page comes from
// src/data/architecture.json, produced by scripts/topology/join-topology.py
// out of the four PUBLIC sanitized IaC snapshots — never the private repos.
// A hand-drawn diagram is wrong the moment something changes; this one is
// only as stale as its generation date, shown below, honestly.

type TNode = {
  id: string;
  kind: string;
  label: string;
  layer: string;
  source: string;
  repo: string;
  meta: Record<string, any>;
};
const nodes = arch.nodes as TNode[];
const edges = arch.edges as { from: string; to: string; kind: string }[];

const byLayer = (layer: string, kinds?: string[]) =>
  nodes.filter(
    (n) => n.layer === layer && (!kinds || kinds.includes(n.kind)),
  );

const dns = byLayer("edge", ["dns"]).sort((a, b) =>
  a.label.localeCompare(b.label),
);
const tunnel = byLayer("edge", ["tunnel"])[0];

const src = (n: TNode) =>
  `https://github.com/ludorl82/${n.repo}/blob/HEAD/${n.source}`;
const generated = (arch.generated as string).replace("T", " ").slice(0, 16);

// the drift badge: the three nightly drift checks assert the private repos
// still match the real infrastructure, so the snapshots this page is built
// from are trustworthy exactly when they are green — and the page says so
// instead of pretending. "unknown" (fetch failed, or a build without the
// nightly pipeline) is shown as unverified, never as green.
type Verified = {
  status?: "ok" | "drift" | "unknown";
  checkedAt?: string | null;
  monitors?: { name: string; up: boolean }[];
};
const verified: Verified = (arch as any).verified ?? { status: "unknown" };
const vDate = verified.checkedAt
  ? verified.checkedAt.replace("T", " ").slice(0, 16) + " UTC"
  : null;
const vDown = (verified.monitors ?? []).filter((m) => !m.up);

// The badge attests that the private repos match reality — that is what the
// three drift monitors compare. It says nothing about whether the PUBLIC
// snapshots this page is built from still match the private repos, and
// publishing those snapshots is a manual step (sanitize-public.sh has no
// scheduler). So a green badge could sit above a drawing joined from a
// week-old snapshot: true about the question it asks, misleading about the
// one a reader hears. Age is the only proxy available here — the build
// deliberately cannot see the private repos, that separation being the whole
// trust boundary — so past this threshold the green claim is withdrawn
// rather than qualified. Same direction as fetch-drift.py's rule: fail to
// unverified, never to green.
const STALE_AFTER_DAYS = 7;
const snapshotDates = Object.values(
  arch.sources as Record<string, { commit: string; date: string }>,
).map((s) => s.date);
// join-topology.py writes "unknown" when it cannot read a snapshot's git
// metadata; an unreadable date is treated as stale, not as fresh
const snapshotAges = snapshotDates.map((d) => {
  const t = Date.parse(d);
  return Number.isNaN(t) ? Infinity : (Date.now() - t) / 86_400_000;
});
const oldestAge = snapshotAges.length ? Math.max(...snapshotAges) : Infinity;
const snapshotsStale = oldestAge > STALE_AFTER_DAYS;
const staleDays = Number.isFinite(oldestAge) ? Math.floor(oldestAge) : null;
// a detected drift is the stronger signal and keeps its own wording; only
// the green claim is downgraded
const vStatus =
  (verified.status ?? "unknown") === "ok" && snapshotsStale
    ? "unknown"
    : (verified.status ?? "unknown");
const staleTitle = Object.entries(
  arch.sources as Record<string, { commit: string; date: string }>,
)
  .map(([repo, s]) => `${repo.replace("-iac-public", "")}: ${s.date}`)
  .join(", ");

// The highlighter needs the edge KIND, not just the endpoints: the walk is
// directed now, and which way a `part-of` points depends on what it joins.
// Dropping the kind is what forced the old undirected walk.
const edgesLite = edges.map((e) => [e.from, e.to, e.kind]);

// so the live caption can say "cronicle.pub.example.com", not "dns:…"
const labels = Object.fromEntries(nodes.map((n) => [n.id, n.label]));

// The public names, grouped by the path they take inward.
//
// These are the natural STARTING points of a request, and not one of them was
// clickable: the drawing carries boxes for apps, machines, buckets, externals
// and the tunnel — but zero of the 14 dns nodes, zero routes, zero workloads.
// So the question the click answers had no entrance, and the only way in was
// to click something in the middle of a path.
//
// They live here rather than in the SVG on purpose. LiveArchDiagram.astro is
// rewritten by the weekly job, its coordinates are hand-placed literals, and
// fourteen more boxes would have to be threaded between the edge box and the
// cluster — pushing ~25 literals down, every one a chance for the next redraw
// to land badly. As chips they also wrap on a phone, where a row of small SVG
// boxes is exactly where terminal-style diagrams fall apart.
const dnsGroup = (n: TNode): string => {
  const targets = edges
    .filter((e) => e.kind === "routes-to" && e.from === n.id)
    .map((e) => e.to);
  if (targets.includes("app:traefik")) return "ingress";
  if (targets.some((t) => t.startsWith("app:"))) return "direct";
  if (targets.some((t) => t.startsWith("external:"))) return "hors";
  if (targets.some((t) => t.startsWith("bucket:"))) return "statique";
  return "edge";
};
const GROUPS: [string, string][] = [
  ["ingress", "par le tunnel, puis l'ingress"],
  ["direct", "par le tunnel, droit au Service"],
  ["hors", "par le tunnel, vers une origine hors cluster"],
  ["statique", "servi depuis le bucket"],
  ["edge", "servi à l'edge, sans origine à la maison"],
];
const dnsGroups = GROUPS.map(([key, note]) => ({
  key,
  note,
  names: dns.filter((n) => dnsGroup(n) === key),
})).filter((g) => g.names.length > 0);
---

  <div class="status">
    <span class="stamp">générée {generated} UTC</span>
    {
      vStatus === "ok" ? (
        <span class="drift ok" title={`drift checks verts, ${vDate}`}>
          ✓ conforme à l'infra réelle — {vDate}
        </span>
      ) : vStatus === "drift" ? (
        <span
          class="drift bad"
          title={vDown.map((m) => m.name).join(", ") || "dérive détectée"}
        >
          ✗ dérive détectée — ce diagramme peut être en retard
        </span>
      ) : snapshotsStale ? (
        <span class="drift unk" title={staleTitle}>
          instantané public vieux de {staleDays ?? "?"} j — non vérifié
        </span>
      ) : (
        <span class="drift unk">vérification indisponible — non vérifié</span>
      )
    }
    {
      Object.entries(arch.sources as Record<string, any>).map(([repo, s]) => (
        <a
          class="commit"
          href={`https://github.com/ludorl82/${repo}/commit/${s.commit}`}
        >
          {repo.replace("-iac-public", "")}@{s.commit}
        </a>
      ))
    }
  </div>

  <LiveArchDiagram />

  <div class="paths">
    <div class="paths-head">
      <h2>Par où entre une requête</h2>
      <button type="button" id="path-clear" hidden>effacer</button>
    </div>
    <p id="path-say" class="say" aria-live="polite">
      Clique un nom public — ou n'importe quelle boîte du schéma — pour
      allumer le chemin qu'il emprunte. <kbd>Échap</kbd> efface.
    </p>
    {
      dnsGroups.map((g) => (
        <div class="grp">
          <span class="grp-note">{g.note}</span>
          <span class="chips">
            {g.names.map((n) => (
              <a class="chip svg-node" data-node={n.id} href={src(n)}>
                {n.label}
              </a>
            ))}
          </span>
        </div>
      ))
    }
  </div>

  <p class="footnote">
    Je ne lis <em>que</em> les dépôts publics pour dessiner ça — les
    sanitizers et leurs vérifications, qui refusent de publier au moindre
    doute, restent la seule frontière de confiance, et je n'ai pas la clé.
    Le badge en haut vient des trois vérifications de dérive nocturnes qui
    comparent les dépôts privés à la vraie infrastructure : ce schéma est
    fiable <em>exactement quand elles sont vertes</em>, et il l'admet quand
    elles ne le sont pas. « Live » veut dire « refait cette nuit, dernière
    vérification affichée » — pas temps réel. Je dessine vite, mais pas à
    ce point-là.
    <span class="sig">— Bob</span>
  </p>

  <script type="application/json" id="topo-edges" set:html={JSON.stringify(edgesLite)} />
  <script type="application/json" id="topo-labels" set:html={JSON.stringify(labels)} />
  <script>
    // One question, asked from either end: **le chemin** — which path through
    // the system does this box sit on? Clicking a public name lights the
    // machine it lands on; clicking a machine lights the names that end up
    // there. Same walk, run upstream and downstream from wherever you clicked.
    //
    // The traversal itself lives in ../lib/arch-path so the build-time
    // checker (scripts/check-diagram-highlight.mjs) can import the SAME code.
    // A checker with its own copy eventually attests a logic the page no
    // longer runs.
    import { buildGraph, pathThrough, isolated, ns } from "../lib/arch-path";

    const edges = JSON.parse(
      document.getElementById("topo-edges")!.textContent!,
    ) as [string, string, string][];
    const labels = JSON.parse(
      document.getElementById("topo-labels")!.textContent!,
    ) as Record<string, string>;
    const g = buildGraph(edges.map(([from, to, kind]) => ({ from, to, kind })));

    const els = document.querySelectorAll<HTMLElement>(
      "[data-node], [data-nodes]",
    );
    const say = document.getElementById("path-say")!;
    const clearBtn = document.getElementById("path-clear") as HTMLButtonElement;
    const IDLE = say.innerHTML;

    function idsOf(el: HTMLElement): string[] {
      return el.dataset.node
        ? [el.dataset.node]
        : (el.dataset.nodes ?? "").split(" ").filter(Boolean);
    }
    let active: string | null = null;

    function apply(sel: Set<string> | null) {
      els.forEach((el) => {
        const hit = !!sel && idsOf(el).some((id) => sel.has(id));
        el.classList.toggle("lit", hit);
        el.classList.toggle("dimmed", !!sel && !hit);
      });
      clearBtn.hidden = !sel;
    }

    const name = (id: string) => labels[id] ?? id.slice(id.indexOf(":") + 1);
    // Counting by KIND is what makes the sentence explain rather than list:
    // "2 routes, 1 application, 1 machine" is the shape of a path, where
    // fourteen identifiers are just noise.
    const KIND_FR: Record<string, [string, string]> = {
      dns: ["nom public", "noms publics"],
      access: ["porte Access", "portes Access"],
      tunnel: ["tunnel", "tunnels"],
      route: ["route", "routes"],
      app: ["application", "applications"],
      workload: ["workload", "workloads"],
      host: ["machine", "machines"],
      bucket: ["bucket", "buckets"],
      external: ["appareil hors IaC", "appareils hors IaC"],
      cluster: ["cluster", "clusters"],
      instance: ["instance", "instances"],
      lambda: ["lambda", "lambdas"],
    };

    function describe(start: string, sel: Set<string>) {
      if (isolated(g, start)) {
        return `<strong>${name(start)}</strong> — aucun lien déclaré. Cette
          boîte existe dans l'inventaire, mais aucun dépôt ne dit à quoi elle
          se rattache, donc il n'y a pas de chemin à allumer.`;
      }
      const counts = new Map<string, number>();
      for (const id of sel) {
        if (id === start) continue;
        const k = ns(id);
        counts.set(k, (counts.get(k) ?? 0) + 1);
      }
      const parts = [...counts.entries()]
        .sort((a, b) => b[1] - a[1])
        .map(([k, n]) => {
          const fr = KIND_FR[k] ?? [k, k];
          return `${n} ${n > 1 ? fr[1] : fr[0]}`;
        });
      return `<strong>${name(start)}</strong> — sur ce chemin : ${parts.join(
        ", ",
      )}.`;
    }

    function select(el: HTMLElement, key: string) {
      active = key;
      if (el.dataset.node) {
        const sel = pathThrough(g, el.dataset.node);
        apply(sel);
        say.innerHTML = describe(el.dataset.node, sel);
      } else {
        // an aggregate box stands for its members, not for a path through
        // them — light exactly those and say so
        const ids = idsOf(el);
        apply(new Set(ids));
        say.innerHTML = `<strong>${ids.length}</strong> éléments de ce groupe,
          allumés tels quels — c'est un regroupement, pas un chemin.`;
      }
    }

    function clear() {
      active = null;
      apply(null);
      say.innerHTML = IDLE;
    }

    els.forEach((el) => {
      el.addEventListener("click", (ev) => {
        // first click selects; a second on the same box follows its link to
        // the source file (aggregates have no link, so they just re-select)
        const key = el.dataset.node ?? el.dataset.nodes!;
        if (active !== key) {
          ev.preventDefault();
          select(el, key);
        } else if (!el.dataset.node) {
          ev.preventDefault();
        }
      });
    });
    clearBtn.addEventListener("click", clear);
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape") clear();
    });
  </script>

<style>
  /* Entry points into the diagram, and the sentence that explains a click.
     The chips carry .svg-node too, so they take the same .lit/.dimmed
     treatment as the SVG boxes and light when a path reaches them. */
  .paths {
    margin: 1.25rem 0 0.5rem;
  }
  .paths-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .paths h2 {
    font-size: 0.95rem;
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-weight: 600;
  }
  #path-clear {
    background: none;
    border: 1px solid var(--panel-border);
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8rem;
    padding: 0.1rem 0.55rem;
    border-radius: 4px;
    cursor: pointer;
  }
  #path-clear:hover {
    border-color: var(--accent-live);
    color: var(--accent-live);
  }
  .say {
    margin: 0 0 0.8rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    /* rewritten on every click; without a floor the block jumps as the
       sentence changes length */
    min-height: 2.6em;
  }
  .say kbd {
    font-family: var(--font-mono);
    font-size: 0.85em;
    border: 1px solid var(--panel-border);
    border-radius: 3px;
    padding: 0 0.25em;
  }
  .grp {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    margin-bottom: 0.45rem;
  }
  .grp-note {
    font-size: 0.78rem;
    color: var(--text-faint);
    flex: 0 0 auto;
    min-width: 16ch;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.12rem 0.5rem;
    border: 1px solid var(--panel-border);
    border-radius: 999px;
    color: var(--text-muted);
    text-decoration: none;
    cursor: pointer;
    transition:
      opacity 0.15s,
      border-color 0.15s;
  }
  .chip:hover,
  .chip.lit {
    border-color: var(--accent-live);
    color: var(--accent-live);
  }
  .chip.dimmed {
    opacity: 0.25;
  }
  @media (max-width: 640px) {
    .grp-note {
      flex: 1 0 100%;
      min-width: 0;
    }
  }

  .back {
    color: var(--text-muted);
    text-decoration: none;
  }
  .page-header {
    margin: 1.5rem 0;
  }
  .subtitle {
    color: var(--text-muted);
    max-width: 70ch;
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }
  .stamp {
    color: var(--accent-live);
  }
  .drift.ok {
    color: var(--accent-live);
  }
  .drift.bad {
    color: var(--text);
    background: var(--accent-default);
    padding: 0 0.4rem;
  }
  .drift.unk {
    color: var(--text-faint);
  }
  .commit {
    color: var(--text-faint);
    text-decoration: none;
  }
  .commit:hover {
    color: var(--text);
  }
  .band {
    border: 1px solid var(--text-faint);
    padding: 0.75rem 1rem 1rem;
    margin-bottom: 1.25rem;
  }
  .band h2 {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    font-weight: normal;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .node {
    display: inline-block;
    border: 1px solid var(--text-faint);
    padding: 0.25rem 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .node:hover {
    border-color: var(--accent-live);
  }
  .node.lit {
    border-color: var(--accent-live);
    color: var(--accent-live);
  }
  .node.dimmed {
    opacity: 0.25;
  }
  .chip,
  .wl {
    font-size: 0.78rem;
    border-style: dashed;
  }
  .hub {
    border-style: double;
    border-width: 3px;
  }
  .app {
    padding: 0.4rem 0.5rem;
  }
  .app-name {
    color: var(--text);
    text-decoration: none;
    display: block;
    margin-bottom: 0.3rem;
  }
  .workloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .host {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .ext {
    border-style: dashed;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .host-cell {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .role-link {
    color: var(--text-faint);
    font-size: 0.7rem;
    text-decoration: none;
    padding-left: 0.15rem;
  }
  .role-link:hover {
    color: var(--accent-live);
  }
  .app .role-link {
    display: block;
    margin: -0.15rem 0 0.3rem;
  }
  .band-note {
    color: var(--text-faint);
    font-size: 0.8rem;
    max-width: 70ch;
    margin: 0.75rem 0 0;
  }
  .dim {
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .tag {
    color: var(--bg);
    background: var(--text-muted);
    font-size: 0.65rem;
    padding: 0 0.25rem;
    margin-left: 0.35rem;
    vertical-align: middle;
  }
  .sig {
    display: block;
    margin-top: 0.4rem;
    color: var(--text-muted);
  }
  .footnote {
    color: var(--text-faint);
    font-size: 0.85rem;
    max-width: 75ch;
    margin-top: 2rem;
  }
</style>
