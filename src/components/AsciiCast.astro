---
interface Props {
  src: string;
  caption: string;
  disclaimer: string;
  /** Frame shown before playback starts, as an asciinema NPT offset. */
  poster?: string;
  /** Overrides the container id shown in the tmux status line. */
  containerId?: string;
}

const { src, caption, disclaimer, poster = "npt:0:06", containerId } = Astro.props;

/* Each recording ran in its own throwaway container, so the id in the status
   line has to differ from one cast to the next — a single id repeated across
   the site would be a fabricated detail pretending to be a real one. It is
   derived from the cast's path (FNV-1a) rather than randomised, so a given
   cast keeps the same id across builds. */
function fakeContainerId(seed: string): string {
  let id = "";
  let h = 0x811c9dc5;
  for (let i = 0; i < 12; i++) {
    for (const ch of `${seed}#${i}`) {
      h ^= ch.charCodeAt(0);
      h = Math.imul(h, 0x01000193) >>> 0;
    }
    id += (h % 16).toString(16);
  }
  return id;
}

/* The tmux status line, reproduced from the terminal screenshots in the
   article. Purely decorative — it is chrome, not part of the recording. */
const left = ["console", "ludorl82", "1:1"];
const windows = ["1:claude*", "2:claude-", "3:zsh"];
const right = ["10:05:47", "26-Jul-26", containerId ?? fakeContainerId(src)];
---

<figure class="cast">
  <p class="disclaimer">{disclaimer}</p>

  <div class="term">
    <div class="titlebar">
      <span class="app">Alacritty</span>
      <span class="btns"><i></i><i></i><i></i></span>
    </div>

    <div class="screen">
      <div data-cast-src={src} data-cast-poster={poster}></div>
    </div>

    <div class="hint">
      <span><b>▶▶ auto mode on</b> (shift+tab to cycle) · esc to interrupt</span>
      <span class="rc">/rc</span>
    </div>

    <div class="tmux">
      <span class="seg s0">{left[0]}</span>
      <span class="seg s1">{left[1]}</span>
      <span class="seg s2">{left[2]}</span>
      <span class="wins">
        {windows.map((w) => <span class:list={["win", { cur: w.endsWith("*") }]}>{w}</span>)}
      </span>
      {right.map((r, i) => <span class:list={["seg", `r${i}`]}>{r}</span>)}
    </div>
  </div>

  <figcaption>
    <span>{caption}</span>
    <a
      class="credit"
      href="https://asciinema.org/"
      target="_blank"
      rel="noopener noreferrer"
      >asciinema-player ↗</a
    >
  </figcaption>
</figure>

<script>
  import * as AsciinemaPlayer from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  document.querySelectorAll<HTMLElement>("[data-cast-src]").forEach((el) => {
    AsciinemaPlayer.create(el.dataset.castSrc!, el, {
      poster: el.dataset.castPoster,
      idleTimeLimit: 2,
      fit: "width",
      theme: "labo",
    });
  });
</script>

<style is:global>
  /* The player builds its own DOM, so the theme has to be declared globally.
     Colours sampled from the article's terminal screenshots. */
  .asciinema-player-theme-labo {
    --term-color-background: #181818;
    --term-color-foreground: #d8d8d8;
  }

  .cast .ap-player {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  /* Keep the control bar inside the fake window instead of floating over it. */
  .cast .ap-control-bar {
    background: #121212;
    border-top: 1px solid #262626;
  }
</style>

<style>
  .cast {
    margin: 2rem 0;
  }

  .disclaimer {
    margin: 0 0 0.75rem;
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-muted);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-left: 3px solid var(--accent-live);
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
  }

  .term {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--panel-border);
    font-family: var(--font-mono);
  }

  /* --- Windows title bar, light like in the screenshots --- */
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #eff4f9;
    color: #1f1f1f;
    font-size: 0.72rem;
    padding: 0.3rem 0.55rem;
  }

  .btns {
    display: flex;
    gap: 0.5rem;
  }

  .btns i {
    width: 9px;
    height: 9px;
    border: 1px solid #6a6a6a;
    border-radius: 1px;
  }

  .btns i:first-child {
    border: 0;
    border-bottom: 1px solid #6a6a6a;
    height: 5px;
  }

  .screen {
    background: #181818;
    overflow-x: auto;
  }

  /* --- Claude Code's pinned footer hint --- */
  .hint {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    background: #181818;
    color: #949494;
    font-size: 0.7rem;
    padding: 0.3rem 0.75rem 0.45rem;
  }

  .hint b {
    color: #ffd700;
    font-weight: 400;
  }

  .rc {
    color: #87d787;
  }

  /* --- tmux status line --- */
  .tmux {
    display: flex;
    align-items: stretch;
    background: #121212;
    font-size: 0.68rem;
    line-height: 1.9;
    white-space: nowrap;
  }

  .seg {
    padding: 0 0.7rem;
    color: #121212;
  }

  .s0 {
    background: #bcbcbc;
    font-weight: 700;
  }
  .s1 {
    background: #8a8a8a;
  }
  .s2 {
    background: #585858;
    color: #bcbcbc;
  }

  .wins {
    flex: 1;
    display: flex;
    gap: 1.1rem;
    justify-content: center;
    color: #585858;
    background: #121212;
  }

  .win.cur {
    color: #d8d8d8;
    font-weight: 700;
  }

  .r0 {
    background: #262626;
    color: #585858;
  }
  .r1 {
    background: #585858;
    color: #bcbcbc;
  }
  .r2 {
    background: #8a8a8a;
    color: #121212;
  }

  figcaption {
    margin-top: 0.65rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-faint);
  }

  /* Apache-2.0; the bundler strips the upstream banner, so credit it here. */
  .credit {
    flex: none;
    color: var(--text-faint);
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .credit:hover {
    color: var(--accent-live);
  }

  @media (max-width: 600px) {
    figcaption {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (max-width: 600px) {
    .hint,
    .tmux {
      display: none;
    }
  }
</style>
