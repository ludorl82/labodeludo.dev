---
interface Props {
  src: string;
  caption: string;
  disclaimer: string;
  /** Frame shown before playback starts, as an asciinema NPT offset. */
  poster?: string;
}

const { src, caption, disclaimer, poster = "npt:0:04" } = Astro.props;
const id = `cast-${src.split("/").pop()?.replace(/\W/g, "-")}`;
---

<figure class="cast">
  <p class="disclaimer">{disclaimer}</p>
  <div class="cast-wrap">
    <div id={id} data-cast-src={src} data-cast-poster={poster}></div>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import * as AsciinemaPlayer from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  document.querySelectorAll<HTMLElement>("[data-cast-src]").forEach((el) => {
    AsciinemaPlayer.create(el.dataset.castSrc!, el, {
      poster: el.dataset.castPoster,
      idleTimeLimit: 1.5,
      fit: "width",
      terminalFontFamily: 'var(--font-mono)',
      theme: "labo",
    });
  });
</script>

<style is:global>
  /* The player renders its own DOM, so these have to be global. */
  .asciinema-player-theme-labo {
    --term-color-background: #000000;
    --term-color-foreground: #d8d8d8;
  }

  .cast .ap-player {
    font-size: 0.95em;
  }
</style>

<style>
  .cast {
    margin: 2rem 0;
  }

  .disclaimer {
    margin: 0 0 0.75rem;
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-muted);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-left: 3px solid var(--accent-live);
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
  }

  .cast-wrap {
    overflow-x: auto;
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--bg);
    padding: 0.75rem;
  }

  figcaption {
    margin-top: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-faint);
  }
</style>
