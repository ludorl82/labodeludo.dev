---
interface Props {
  src: string;
  caption: string;
  disclaimer: string;
  /** Frame shown before playback starts, as an asciinema NPT offset. */
  poster?: string;
}

const { src, caption, disclaimer, poster = "npt:0:06" } = Astro.props;

/* The tmux status line, reproduced from the terminal screenshots in the
   article. Purely decorative — it is chrome, not part of the recording. */
const left = ["console", "ludorl82", "1:1"];
const windows = ["1:claude*", "2:claude-", "3:zsh"];
const right = ["10:05:47", "26-Jul-26", "24afb1f6d1d5"];
---

<figure class="cast">
  <p class="disclaimer">{disclaimer}</p>

  <div class="term">
    <div class="titlebar">
      <span class="app">Alacritty</span>
      <span class="btns">
        <i></i>
        <button class="max" type="button" aria-label="Plein écran" hidden></button>
        <i></i>
      </span>
    </div>

    <div class="screen">
      <div data-cast-src={src} data-cast-poster={poster}></div>
    </div>

    <div class="hint">
      <span><b>▶▶ auto mode on</b> (shift+tab to cycle) · esc to interrupt</span>
      <span class="rc">/rc</span>
    </div>

    <div class="tmux">
      <span class="seg s0">{left[0]}</span>
      <span class="seg s1">{left[1]}</span>
      <span class="seg s2">{left[2]}</span>
      <span class="wins">
        {windows.map((w) => <span class:list={["win", { cur: w.endsWith("*") }]}>{w}</span>)}
      </span>
      {right.map((r, i) => <span class:list={["seg", `r${i}`]}>{r}</span>)}
    </div>
  </div>

  <figcaption>
    <span>{caption}</span>
    <a
      class="credit"
      href="https://asciinema.org/"
      target="_blank"
      rel="noopener noreferrer"
      >asciinema-player ↗</a
    >
  </figcaption>
</figure>

<script>
  import * as AsciinemaPlayer from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  document.querySelectorAll<HTMLElement>("[data-cast-src]").forEach((el) => {
    AsciinemaPlayer.create(el.dataset.castSrc!, el, {
      poster: el.dataset.castPoster,
      idleTimeLimit: 2,
      fit: "width",
      theme: "labo",
    });
  });

  /* The player's own fullscreen button expands only its .ap-wrapper, which
     leaves the fake window's chrome behind. This one expands the whole .term
     instead. The player still sizes itself correctly: its internal check reads
     document.fullscreenElement, so it fits width *and* height regardless of
     which element was expanded — no need to touch the `fit` option. */
  document.querySelectorAll<HTMLElement>(".cast .max").forEach((btn) => {
    const term = btn.closest<HTMLElement>(".term");
    if (!term?.requestFullscreen) return;
    btn.hidden = false;
    btn.title = "Plein écran";

    const toggle = () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else term.requestFullscreen().catch(() => {});
    };

    btn.addEventListener("click", toggle);
    // Same gesture as maximising a real window — a much bigger target than
    // the 9px square, which matters on a touch screen.
    term.querySelector(".titlebar")?.addEventListener("dblclick", toggle);
  });
</script>

<style is:global>
  /* The player builds its own DOM, so the theme has to be declared globally.
     Colours sampled from the article's terminal screenshots. */
  .asciinema-player-theme-labo {
    --term-color-background: #181818;
    --term-color-foreground: #d8d8d8;
  }

  .cast .ap-player {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }

  /* Keep the control bar inside the fake window instead of floating over it. */
  .cast .ap-control-bar {
    background: #121212;
    border-top: 1px solid #262626;
  }
</style>

<style>
  .cast {
    margin: 2rem 0;
  }

  .disclaimer {
    margin: 0 0 0.75rem;
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-muted);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-left: 3px solid var(--accent-live);
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
  }

  .term {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--panel-border);
    font-family: var(--font-mono);
  }

  /* --- Windows title bar, light like in the screenshots --- */
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #eff4f9;
    color: #1f1f1f;
    font-size: 0.72rem;
    padding: 0.3rem 0.55rem;
  }

  .btns {
    display: flex;
    gap: 0.5rem;
  }

  .btns i {
    width: 9px;
    height: 9px;
    border: 1px solid #6a6a6a;
    border-radius: 1px;
  }

  .btns i:first-child {
    border: 0;
    border-bottom: 1px solid #6a6a6a;
    height: 5px;
  }

  /* Looks like the middle window button; hidden unless the script wires it. */
  .max {
    position: relative;
    width: 9px;
    height: 9px;
    padding: 0;
    background: none;
    border: 1px solid #6a6a6a;
    border-radius: 1px;
    cursor: pointer;
  }

  /* A 9px square is an unhittable tap target on a phone, so extend the hit
     area well past the drawn square without changing how it looks. */
  .max::before {
    content: "";
    position: absolute;
    inset: -16px;
  }

  .max:hover {
    background: #c8ced4;
  }

  /* --- fullscreen: the whole window, chrome included ------------------
     Everything below applies only while expanded, so the inline rendering
     is untouched. */
  .term:fullscreen {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0;
    background: #181818;
  }

  .term:fullscreen .screen {
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The bars are hidden on small screens inline, but in fullscreen there is
     room for them — which is the whole point of expanding the window. */
  .term:fullscreen .hint,
  .term:fullscreen .tmux {
    display: flex;
  }

  .screen {
    background: #181818;
    overflow-x: auto;
  }

  /* --- Claude Code's pinned footer hint --- */
  .hint {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    background: #181818;
    color: #949494;
    font-size: 0.7rem;
    padding: 0.3rem 0.75rem 0.45rem;
  }

  .hint b {
    color: #ffd700;
    font-weight: 400;
  }

  .rc {
    color: #87d787;
  }

  /* --- tmux status line --- */
  .tmux {
    display: flex;
    align-items: stretch;
    background: #121212;
    font-size: 0.68rem;
    line-height: 1.9;
    white-space: nowrap;
  }

  .seg {
    padding: 0 0.7rem;
    color: #121212;
  }

  .s0 {
    background: #bcbcbc;
    font-weight: 700;
  }
  .s1 {
    background: #8a8a8a;
  }
  .s2 {
    background: #585858;
    color: #bcbcbc;
  }

  .wins {
    flex: 1;
    display: flex;
    gap: 1.1rem;
    justify-content: center;
    color: #585858;
    background: #121212;
  }

  .win.cur {
    color: #d8d8d8;
    font-weight: 700;
  }

  .r0 {
    background: #262626;
    color: #585858;
  }
  .r1 {
    background: #585858;
    color: #bcbcbc;
  }
  .r2 {
    background: #8a8a8a;
    color: #121212;
  }

  figcaption {
    margin-top: 0.65rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-faint);
  }

  /* Apache-2.0; the bundler strips the upstream banner, so credit it here. */
  .credit {
    flex: none;
    color: var(--text-faint);
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .credit:hover {
    color: var(--accent-live);
  }

  @media (max-width: 600px) {
    figcaption {
      flex-direction: column;
      gap: 0.35rem;
    }
  }

  @media (max-width: 600px) {
    .hint,
    .tmux {
      display: none;
    }
  }
</style>
