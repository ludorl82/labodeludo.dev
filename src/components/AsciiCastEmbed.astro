---
/* asciinema.org-hosted variant of AsciiCast: the player is served by
   asciinema.org's embed script, so plays count on the recording's public
   page. The custom terminal chrome (title bar, tmux line) doesn't apply
   here — the embed owns its whole frame. */
interface Props {
  /** Recording id on asciinema.org (the part after /a/). */
  id: string;
  caption: string;
  disclaimer: string;
  /** Frame shown before playback starts, as an asciinema NPT offset. */
  poster?: string;
}

const { id, caption, disclaimer, poster = "npt:0:06" } = Astro.props;
---

<figure class="cast">
  <p class="disclaimer">{disclaimer}</p>

  <div class="embed">
    <script
      is:inline
      async
      id={`asciicast-${id}`}
      src={`https://asciinema.org/a/${id}.js`}
      data-poster={poster}
      data-idle-time-limit="2"
    ></script>
  </div>

  <figcaption>
    <span>{caption}</span>
    <a
      class="credit"
      href={`https://asciinema.org/a/${id}`}
      target="_blank"
      rel="noopener noreferrer"
      >asciinema.org ↗</a
    >
  </figcaption>
</figure>

<style>
  .cast {
    margin: 2rem 0;
  }

  .disclaimer {
    margin: 0 0 0.75rem;
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-muted);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-left: 3px solid var(--accent-live);
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
  }

  .embed {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--panel-border);
  }

  /* The embed script injects an iframe as a sibling of the script tag. */
  .embed :global(iframe) {
    display: block;
  }

  figcaption {
    margin-top: 0.65rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--text-faint);
  }

  .credit {
    flex: none;
    color: var(--text-faint);
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .credit:hover {
    color: var(--accent-live);
  }

  @media (max-width: 600px) {
    figcaption {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
