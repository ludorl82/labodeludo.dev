---
/* Les résultats du banc d'essai des modèles, tels que le banc les a publiés
   après sa dernière nuit de mesures. Les données ne sont pas dans le dépôt :
   veille.py (k3s-iac banc-modeles/) les dépose à côté du site, dans
   /banc/resultats.json, que le déploiement ne supprime pas (--exclude). Le
   déploiement de staging en copie la version de prod au moment du build.

   Le fichier passe une liste blanche côté banc (champs permis, valeurs
   vérifiées) ; ici, tout est posé en textContent, jamais en HTML : le nom
   d'un modèle vient de Hugging Face. */
interface Props {
  lang?: "fr" | "en";
}
const { lang = "fr" } = Astro.props;

const t = {
  fr: {
    loading: "Chargement des résultats…",
    filtre: "Cartes",
    toutes: "Toutes",
    une: "Une carte",
    trois: "Trois cartes",
  },
  en: {
    loading: "Loading the results…",
    filtre: "Cards",
    toutes: "All",
    une: "One card",
    trois: "Three cards",
  },
}[lang];
---

<section class="banc" data-banc data-lang={lang}>
  <div class="bar">
    <span class="stamp" data-stamp></span>
    <div class="filtre" role="group" aria-label={t.filtre}>
      <button type="button" data-filtre="" aria-pressed="true">{t.toutes}</button>
      <button type="button" data-filtre="1x3060" aria-pressed="false">{t.une}</button>
      <button type="button" data-filtre="3x3060" aria-pressed="false">{t.trois}</button>
    </div>
  </div>
  <div class="wrap" tabindex="0">
    <table>
      <thead data-head></thead>
      <tbody data-body>
        <tr><td class="placeholder">{t.loading}</td></tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  type Mesure = {
    date: string;
    moteur: "llamacpp" | "ollama";
    version: string;
    modele: string;
    config: string;
    statut: string;
    quant?: string;
    taille_go?: number;
    part_gpu?: number;
    decode_jps?: number;
    prefill_jps?: number;
    ttft_court_s?: number;
    chargement_s?: number;
    vram_pic_total_mio?: number;
    qualite?: Record<string, string>;
  };
  type Resultats = { genere: string; mesures: Mesure[] };

  const root = document.querySelector<HTMLElement>("[data-banc]")!;
  const EN = root.dataset.lang === "en";
  const S = EN
    ? {
        cols: ["Date", "Model", "Engine", "Cards", "Result", "Output (tok/s)", "First token (s)", "Peak VRAM (GiB)", "Load (s)", "Basics /7", "HA tools /4", "Québécois /8"],
        statuts: { ok: "ok", ne_rentre_pas: "does not fit", trop_gros: "too big", echec: "failed", introuvable: "not found" } as Record<string, string>,
        none: "No results here. They are only placed next to the site in production.",
        vide: "No measurements for these cards yet.",
        stamp: "published",
        locale: "en-CA",
      }
    : {
        cols: ["Date", "Modèle", "Moteur", "Cartes", "Résultat", "Écriture (j/s)", "Premier jeton (s)", "VRAM pic (Gio)", "Chargement (s)", "Base /7", "Outils HA /4", "Québécois /8"],
        statuts: { ok: "ok", ne_rentre_pas: "n'entre pas", trop_gros: "trop gros", echec: "échec", introuvable: "introuvable" } as Record<string, string>,
        none: "Pas de résultats ici. Ils ne sont déposés qu'à côté du site en production.",
        vide: "Aucune mesure pour ces cartes.",
        stamp: "publié le",
        locale: "fr-CA",
      };

  const head = root.querySelector<HTMLElement>("[data-head]")!;
  const body = root.querySelector<HTMLElement>("[data-body]")!;
  const stamp = root.querySelector<HTMLElement>("[data-stamp]")!;
  const boutons = [...root.querySelectorAll<HTMLButtonElement>("[data-filtre]")];

  const cell = (tag: "td" | "th", text: string, cls = "") => {
    const e = document.createElement(tag);
    e.textContent = text;
    if (cls) e.className = cls;
    return e;
  };
  const nombre = (v: number | undefined, decimales: number) =>
    v === undefined
      ? ""
      : v.toLocaleString(S.locale, { minimumFractionDigits: decimales, maximumFractionDigits: decimales });
  const score = (q: Record<string, string> | undefined, k: string) => (q?.[k] ?? "").split("/")[0];
  const moteur = (m: Mesure) => `${m.moteur === "llamacpp" ? "llama.cpp" : "Ollama"} ${m.version}`;
  const jour = (d: string) =>
    new Date(`${d}T12:00:00`).toLocaleDateString(S.locale, { day: "numeric", month: "short" });

  let donnees: Mesure[] = [];

  function rendre(filtre: string) {
    for (const b of boutons) b.setAttribute("aria-pressed", String(b.dataset.filtre === filtre));
    const lignes = donnees
      .filter((m) => !filtre || m.config === filtre)
      .sort((a, b) => b.date.localeCompare(a.date) || a.modele.localeCompare(b.modele) || a.config.localeCompare(b.config));
    body.replaceChildren();
    if (!lignes.length) {
      const tr = document.createElement("tr");
      const td = cell("td", S.vide, "placeholder");
      td.colSpan = S.cols.length;
      tr.append(td);
      body.append(tr);
      return;
    }
    for (const m of lignes) {
      const ok = m.statut === "ok";
      const tr = document.createElement("tr");
      if (!ok) tr.className = "ko";
      tr.append(
        cell("td", jour(m.date)),
        cell("th", m.modele + (m.quant ? ` (${m.quant})` : ""), "modele"),
        cell("td", moteur(m)),
        cell("td", m.config.startsWith("1x") ? "1" : "3", "num"),
        cell("td", S.statuts[m.statut] ?? m.statut),
        cell("td", ok ? nombre(m.decode_jps, 1) : "", "num"),
        cell("td", ok ? nombre(m.ttft_court_s, 2) : "", "num"),
        cell("td", ok && m.vram_pic_total_mio ? nombre(m.vram_pic_total_mio / 1024, 1) : "", "num"),
        cell("td", ok ? nombre(m.chargement_s, 1) : "", "num"),
        cell("td", score(m.qualite, "base"), "num"),
        cell("td", score(m.qualite, "outils-ha"), "num"),
        cell("td", score(m.qualite, "quebecois"), "num"),
      );
      body.append(tr);
    }
  }

  async function main() {
    const tr = document.createElement("tr");
    S.cols.forEach((c, i) => tr.append(cell("th", c, i >= 5 || i === 3 ? "num" : "")));
    head.replaceChildren(tr);
    let res: Resultats;
    try {
      const r = await fetch("/banc/resultats.json", { cache: "no-cache" });
      if (!r.ok) throw new Error(String(r.status));
      res = await r.json();
    } catch {
      const tr2 = document.createElement("tr");
      const td = cell("td", S.none, "placeholder");
      td.colSpan = S.cols.length;
      tr2.append(td);
      body.replaceChildren(tr2);
      return;
    }
    donnees = Array.isArray(res.mesures) ? res.mesures : [];
    stamp.textContent = `${S.stamp} ${new Date(res.genere).toLocaleString(S.locale, {
      day: "numeric",
      month: "long",
      hour: "2-digit",
      minute: "2-digit",
    })}`;
    for (const b of boutons) b.addEventListener("click", () => rendre(b.dataset.filtre ?? ""));
    rendre("");
  }

  main();
</script>

<style>
  .banc {
    margin: 1.5rem 0 3rem;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .stamp {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .filtre {
    display: flex;
    gap: 0.4rem;
  }

  .filtre button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--panel-border);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .filtre button[aria-pressed="true"] {
    background: var(--text);
    color: var(--bg);
  }

  /* Le tableau défile dans son cadre ; la page, jamais. */
  .wrap {
    overflow-x: auto;
    max-width: 100%;
  }

  table {
    border-collapse: collapse;
    font-size: 0.85rem;
    white-space: nowrap;
    width: 100%;
  }

  th,
  td {
    padding: 0.35rem 0.6rem;
    border-bottom: 1px solid var(--panel-border);
    text-align: left;
  }

  thead th {
    font-weight: 600;
    color: var(--text-muted);
    position: sticky;
    top: 0;
  }

  .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  tbody th.modele {
    font-weight: 600;
  }

  tr.ko td,
  tr.ko th {
    color: var(--text-muted);
  }

  .placeholder {
    color: var(--text-muted);
    white-space: normal;
  }
</style>
