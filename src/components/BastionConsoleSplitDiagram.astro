---
interface Props {
  context?: "article" | "architecture";
  lang?: "fr" | "en";
}

const { context = "article", lang = "fr" } = Astro.props;

const copy = {
  fr: {
    ariaLabel:
      "Schéma : avant, un seul Raspberry Pi de 4 Go porte à la fois le bastion (clés de service, pipeline de secrets) et la console interactive, limitée à 2 Go ; après, le Pi garde le rôle bastion sous l'alias DNS bastion.lab.example et une console de secours arrêtée, tandis que la console vit dans une VM dédiée de 16 Go sur le serveur GPU, sous le nom console.lab.example.",
    avantLabel: "avant · un Pi de 4 Go fait tout",
    piAvant: "pi-02 (4 Go)",
    piAvantSub1: "bastion : clés de service, secrets",
    piAvantSub2: "+ console interactive (max 2 Go)",
    piAvantSub3: "+ agent k3s",
    dnsAvant: "console.lab.example",
    apresLabel: "après · deux rôles, deux machines, deux noms",
    piApres: "pi-02 (4 Go) — bastion",
    piApresSub1: "clés de service, secrets, singletons",
    piApresSub2: "console de secours (arrêtée)",
    dnsBastion: "bastion.lab.example",
    vmApres: "console-vm (16 Go)",
    vmApresSub1: "VM sur gpu-01 · pas un nœud k3s",
    vmApresSub2: "console : sessions d'agent, dépôts",
    dnsConsole: "console.lab.example",
    hyperviseur: "gpu-01 · hyperviseur",
  },
  en: {
    ariaLabel:
      "Diagram: before, a single 4 GB Raspberry Pi carries both the bastion role (service keys, secrets pipeline) and the interactive console, capped at 2 GB; after, the Pi keeps the bastion role under the DNS alias bastion.lab.example plus a stopped emergency console, while the console lives in a dedicated 16 GB VM on the GPU server, under the name console.lab.example.",
    avantLabel: "before · one 4 GB Pi does everything",
    piAvant: "pi-02 (4 GB)",
    piAvantSub1: "bastion: service keys, secrets",
    piAvantSub2: "+ interactive console (2 GB cap)",
    piAvantSub3: "+ k3s agent",
    dnsAvant: "console.lab.example",
    apresLabel: "after · two roles, two machines, two names",
    piApres: "pi-02 (4 GB) — bastion",
    piApresSub1: "service keys, secrets, singletons",
    piApresSub2: "emergency console (stopped)",
    dnsBastion: "bastion.lab.example",
    vmApres: "console-vm (16 GB)",
    vmApresSub1: "VM on gpu-01 · not a k3s node",
    vmApresSub2: "console: agent sessions, repos",
    dnsConsole: "console.lab.example",
    hyperviseur: "gpu-01 · hypervisor",
  },
} as const;

const t = copy[lang];

const figcaptionFr =
  context === "architecture"
    ? "La séparation bastion/console — détail dans l'article « Séparer le bastion de la console »."
    : "Un rôle par machine : le bastion reste sur le Pi survivant, la console déménage dans une VM taillée pour travailler. Le nom suit le shell ; le bastion reçoit un alias neuf.";
const figcaptionEn =
  context === "architecture"
    ? "The bastion/console split — detailed in the article “Splitting the Bastion from the Console”."
    : "One role per machine: the bastion stays on the survivor Pi, the console moves into a VM sized for real work. The name follows the shell; the bastion gets a fresh alias.";
---

<figure class="split-diagram">
  <div class="diagram-wrap">
    <svg viewBox="0 0 700 330" role="img" aria-label={t.ariaLabel}>
      <defs>
        <marker id="bcs-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-faint)" />
        </marker>
        <marker id="bcs-arrow-live" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--accent-live)" />
        </marker>
      </defs>

      <!-- avant -->
      <text x="170" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--text-faint)">{t.avantLabel}</text>
      <text x="170" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">{t.dnsAvant}</text>
      <line x1="170" y1="54" x2="170" y2="72" stroke="var(--text-faint)" stroke-width="1.2" marker-end="url(#bcs-arrow)" />
      <rect x="60" y="76" width="220" height="88" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="170" y="97" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text)">{t.piAvant}</text>
      <text x="170" y="116" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--text-faint)">{t.piAvantSub1}</text>
      <text x="170" y="132" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--text-faint)">{t.piAvantSub2}</text>
      <text x="170" y="148" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="var(--text-faint)">{t.piAvantSub3}</text>

      <!-- séparateur -->
      <line x1="350" y1="30" x2="350" y2="300" stroke="var(--panel-border)" stroke-width="1" stroke-dasharray="3 5" />

      <!-- après -->
      <text x="525" y="22" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--accent-live)">{t.apresLabel}</text>

      <text x="455" y="48" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">{t.dnsBastion}</text>
      <line x1="455" y1="54" x2="455" y2="72" stroke="var(--text-faint)" stroke-width="1.2" marker-end="url(#bcs-arrow)" />
      <rect x="380" y="76" width="150" height="78" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="455" y="97" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--text)">{t.piApres}</text>
      <text x="455" y="116" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">{t.piApresSub1}</text>
      <text x="455" y="132" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">{t.piApresSub2}</text>

      <text x="620" y="180" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--accent-live)">{t.dnsConsole}</text>
      <line x1="620" y1="186" x2="620" y2="204" stroke="var(--accent-live)" stroke-width="1.2" marker-end="url(#bcs-arrow-live)" />
      <rect x="540" y="208" width="150" height="72" rx="4" fill="var(--panel)" stroke="var(--accent-live)" stroke-dasharray="5 3" />
      <text x="615" y="229" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--text)">{t.vmApres}</text>
      <text x="615" y="248" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">{t.vmApresSub1}</text>
      <text x="615" y="264" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">{t.vmApresSub2}</text>

      <!-- hyperviseur qui contient la VM -->
      <rect x="525" y="196" width="172" height="96" rx="6" fill="none" stroke="var(--panel-border)" />
      <text x="611" y="308" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">{t.hyperviseur}</text>
    </svg>
  </div>
  <figcaption>
    {lang === "fr" ? figcaptionFr : figcaptionEn}
    {context === "article" && (
      <>
        {" "}
        <a href={lang === "fr" ? "/architecture/" : "/architecture/"}>{lang === "fr" ? "Voir l'architecture complète" : "See the full architecture"}</a>
      </>
    )}
    {/* On the architecture page this caption NAMED its article without
        linking it — alone among the eleven diagrams. */}
    {context === "architecture" && (
      <>
        {" "}
        <a
          href={
            lang === "fr"
              ? "/blog/separer-le-bastion-de-la-console/"
              : "/en/blog/separer-le-bastion-de-la-console/"
          }
        >
          {lang === "fr" ? "Lire l'article" : "Read the article"}
        </a>
      </>
    )}
  </figcaption>
</figure>

<style>
  .split-diagram {
    margin: 2rem 0;
  }
  .diagram-wrap {
    background: var(--bg);
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    padding: 0.75rem;
    overflow-x: auto;
  }
  .diagram-wrap svg {
    display: block;
    width: 100%;
    height: auto;
    min-width: 560px;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
</style>
