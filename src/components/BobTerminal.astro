---
/**
 * "Parler à Bob" — the one stateful rectangle on an otherwise static site.
 *
 * Posts to /api/bob/chat, a Cloudflare Worker (ludorl82/cloudflare-iac,
 * live/workers/bob-chat) that signs Bedrock calls. The transcript is held
 * client-side and sent whole each turn: the Worker keeps no memory, so there is
 * no session to leak and nothing to clean up.
 *
 * Visual grammar is lifted from ConversationExcerpt.astro rather than invented
 * — mono, pre-wrap, and an accent left-border marking Bob's turns — so a live
 * exchange looks like the reconstructed ones elsewhere on the site.
 *
 * The disclaimer is the INVERSE of the house rule. Casts and ConversationExcerpt
 * must warn that they are reconstructions; this one has to warn that it is not.
 */
import { BOB_QUIPS } from "../lib/bob-humor";
import popular from "../data/openers.json";

// Written by hand, and still the fallback: an empty popular list is a normal
// state — a quiet fortnight, or a night where nothing survived the gate — and
// the panel must never be an empty row of nothing.
const HAND_WRITTEN = [
  "C'est quoi le setup ?",
  "Montre-moi ta pire journée",
  "Par où je commence ?",
  "T'as écrit sur quoi récemment ?",
];

// What people actually asked, selected nightly from real questions and cleared
// by check-openers.py before it could land here. See scripts/topology/.
const OPENERS = popular.openers?.length ? popular.openers : HAND_WRITTEN;

// No-JS fallback: one real quip, so the panel is never an empty box.
const fallback = BOB_QUIPS[Math.floor(Math.random() * BOB_QUIPS.length)];
---

<section class="bob-chat" id="bob-chat" aria-labelledby="bob-chat-title">
  <div class="chat-head">
    <p class="prompt" id="bob-chat-title">$ bob --chat</p>
    <button type="button" class="expand" id="bob-expand" aria-controls="bob-fullscreen">
      agrandir
    </button>
  </div>

  <p class="disclaimer">
    Ceci n'est pas une reconstitution : c'est un vrai modèle qui répond, en
    direct, sur une carte graphique du labo, pas dans le nuage — demande-lui
    son modèle, il le sait.
    Il ne connaît que ce qui est publié sur ce site et l'inventaire (assaini)
    du parc. Il peut se tromper, et ce n'est pas Ludo qui parle.
  </p>

  <div class="log" id="bob-log" aria-live="polite" aria-atomic="false">
    <div class="turn bob">
      <span class="who">bob</span>
      <p id="bob-fallback">{fallback}</p>
    </div>
  </div>

  <div class="openers" id="bob-openers">
    {OPENERS.map((o) => <button type="button" class="opener" data-q={o}>{o}</button>)}
  </div>

  <form class="ask" id="bob-form">
    <label class="sr-only" for="bob-input">Poser une question à Bob</label>
    <input
      id="bob-input"
      type="text"
      maxlength="500"
      autocomplete="off"
      placeholder="Demande-lui quelque chose…"
    />
    <button type="submit" id="bob-send">Envoyer</button>
  </form>

  <noscript>
    <p class="disclaimer">Il faut JavaScript pour lui parler. Les articles, eux, se lisent très bien sans.</p>
  </noscript>
</section>

<!--
  The same conversation, given room.

  A native <dialog> rather than a hand-rolled overlay: showModal() brings the
  focus trap, Escape, the inert background and ::backdrop with it. The palette's
  header comment warns that this codebase's older overlays are `<div hidden>`
  with no dialog role and no focus management, and to borrow their look rather
  than their semantics — this is that, done the short way.

  It holds NOTHING of its own. On open, the log, the openers and the form are
  MOVED here and moved back on close. Cloning them would mean two transcripts to
  keep in sync and two sets of listeners; moving the live nodes means the script
  above keeps working unchanged, and the conversation cannot diverge between the
  two views because there is only ever one of it.
-->
<dialog id="bob-fullscreen" class="bob-fullscreen" aria-labelledby="bob-fullscreen-title">
  <div class="bob-fullscreen-panel">
    <header class="bob-fullscreen-head">
      <p class="prompt" id="bob-fullscreen-title">$ bob --chat --fullscreen</p>
      <button type="button" class="expand" id="bob-collapse">réduire</button>
    </header>
    <div class="bob-fullscreen-slot" id="bob-slot"></div>
  </div>
</dialog>

<style>
  .bob-chat {
    margin: 1.25rem 0 0;
    max-width: var(--measure);
    padding: 0.85rem 1rem 1rem;
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .prompt {
    margin: 0;
    color: var(--accent-live);
    user-select: none;
  }

  .chat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  /* Quiet by default: the page is about reading, and a loud control here would
     compete with the prose. It gains weight on hover and focus, where it has
     been asked for. */
  .expand {
    flex: 0 0 auto;
    background: transparent;
    border: 1px solid var(--panel-border);
    border-radius: 4px;
    color: var(--text-faint);
    font-family: inherit;
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    cursor: pointer;
  }

  .expand:hover,
  .expand:focus-visible {
    color: var(--accent-live);
    border-color: var(--accent-live);
  }

  /* --- the fullscreen conversation ------------------------------------- */

  .bob-fullscreen {
    /* A dialog is display:none until opened and centred by the UA; everything
       here is about the open state. */
    width: min(52rem, 94vw);
    /* dvh, not vh: on a phone the on-screen keyboard shrinks the visible area,
       and vh would put the input behind it — the same trap the palette
       documents. */
    height: min(85dvh, 52rem);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel);
    color: var(--text);
    overflow: hidden;
  }

  .bob-fullscreen::backdrop {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(2px);
  }

  .bob-fullscreen-panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.85rem 1rem 1rem;
    font-family: var(--font-mono);
    /* Bigger than the inline box's 0.8125rem. The inline one is a widget beside
       prose and defers to it; this one IS the page while it is open, and a
       conversation you opened on purpose should not be read at 13px. */
    font-size: 0.9375rem;
    gap: 0.6rem;
  }

  .bob-fullscreen-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex: 0 0 auto;
  }

  /* The moved nodes live here. min-height:0 is what actually lets the log
     scroll: without it the flex item refuses to shrink below its content and
     the whole panel grows past the dialog instead. */
  .bob-fullscreen-slot {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    gap: 0.6rem;
  }

  /* These three selectors target the SAME elements as the inline rules above —
     they are the same nodes, moved — so everything here is the delta that being
     in the dialog implies: the log takes the height and scrolls, and the form
     stays pinned under it instead of scrolling away with the transcript. */
  .bob-fullscreen-slot .log {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    margin-top: 0;
    padding-right: 0.4rem;
    /* A short conversation sits ON the input rather than floating at the top of
       a tall empty panel — the chat convention, and the reason the inline box
       never needed it: there, the box is only as tall as its content. It costs
       nothing once the transcript is long enough to scroll, because a flex
       container that overflows starts from its scroll origin anyway. */
    justify-content: flex-end;
  }

  .bob-fullscreen-slot .openers,
  .bob-fullscreen-slot .ask {
    flex: 0 0 auto;
  }

  /* Phone: the dialog IS the screen. Rounded corners floating over 3% of
     visible page is fussy rather than elegant at this size. */
  @media (max-width: 34rem) {
    .bob-fullscreen {
      width: 100vw;
      height: 100dvh;
      border: 0;
      border-radius: 0;
    }
  }

  .disclaimer {
    margin: 0.6rem 0 0;
    padding-left: 0.7rem;
    border-left: 2px solid var(--accent-live);
    color: var(--text-faint);
    line-height: 1.55;
  }

  .log {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .turn p {
    margin: 0.2rem 0 0;
    white-space: pre-wrap;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .turn.bob p {
    padding-left: 0.7rem;
    border-left: 2px solid var(--accent-live);
  }

  .turn.bob a:not(.bob-link) {
    color: var(--accent-live);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.5rem 0 0 0.7rem;
  }


  .local-note {
    margin: 0.2rem 0 0;
    padding-left: 0.7rem;
    border-left: 2px dashed var(--text-faint);
    color: var(--text-faint);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .who {
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .turn.bob .who {
    color: var(--accent-live);
  }

  .openers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .opener {
    padding: 0.3rem 0.6rem;
    background: transparent;
    border: 1px solid var(--panel-border);
    border-radius: 999px;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .opener:hover {
    border-color: var(--accent-live);
    color: var(--accent-live);
  }

  .ask {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.85rem;
  }

  .ask input {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.45rem 0.6rem;
    background: var(--bg);
    border: 1px solid var(--panel-border);
    border-radius: 4px;
    color: var(--text);
    font-family: inherit;
    font-size: inherit;
  }

  .ask input:focus {
    outline: none;
    border-color: var(--accent-live);
  }

  .ask button {
    padding: 0.45rem 0.8rem;
    background: transparent;
    border: 1px solid var(--accent-live);
    border-radius: 4px;
    color: var(--accent-live);
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }

  .ask button[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { renderReply } from "../lib/bob-render";
    import { startThinking } from "../lib/bob-thinking";
  import { MAX_TURNS, loadConversation, saveConversation, toMessages } from "../lib/bob-memory";

  const log = document.getElementById("bob-log");
  const form = document.getElementById("bob-form") as HTMLFormElement | null;
  const input = document.getElementById("bob-input") as HTMLInputElement | null;
  const send = document.getElementById("bob-send") as HTMLButtonElement | null;
  const openers = document.getElementById("bob-openers");
  const fallbackTurn = document.getElementById("bob-fallback")?.parentElement;

  /* ------------------------------------------------- the fullscreen view --- */
  //
  // The dialog holds nothing of its own: the log, the openers and the form are
  // MOVED into it and moved back on close. Cloning would mean two transcripts
  // to keep in sync and two sets of listeners; moving the live nodes means the
  // chat code below never learns that a second view exists, and the two views
  // cannot disagree because there is only ever one of them.
  const section = document.getElementById("bob-chat");
  const dialog = document.getElementById("bob-fullscreen") as HTMLDialogElement | null;
  const slot = document.getElementById("bob-slot");
  const expand = document.getElementById("bob-expand");
  const collapse = document.getElementById("bob-collapse");
  // Where the nodes belong when the dialog is closed: before the <noscript>,
  // which is where they are authored. Captured once, up front, rather than
  // guessed at close time.
  const homeAnchor = section?.querySelector("noscript") ?? null;

  const scrollLogToEnd = () => {
    const l = document.getElementById("bob-log");
    if (l) l.scrollTop = l.scrollHeight;
  };

  if (dialog && slot && expand && collapse && section) {
    // Moving the nodes is idempotent — it checks where they already are —
    // because it is called from every path that can close this thing, and
    // those paths overlap. Calling it twice has to be free.
    const moveInto = (parent: Element, before: Node | null) => {
      for (const id of ["bob-log", "bob-openers", "bob-form"]) {
        const el = document.getElementById(id);
        if (el && el.parentElement !== parent) parent.insertBefore(el, before);
      }
    };

    const open = () => {
      moveInto(slot, null);
      dialog.showModal();
      scrollLogToEnd();
      (document.getElementById("bob-input") as HTMLInputElement | null)?.focus();
    };

    const restore = () => {
      moveInto(section, homeAnchor);
      (expand as HTMLButtonElement).focus();
    };

    // EVERY close path restores explicitly, and the `close` event is only a
    // belt-and-braces listener rather than the mechanism.
    //
    // That is not paranoia, it is what testing found: in the browser this was
    // verified in, `close` never fired — not for this dialog and not for a
    // freshly created one either. Whatever the cause, a feature that leaves the
    // transcript stranded inside a hidden dialog when it misbehaves is not a
    // feature worth shipping on a promise. Restoring from the paths we control
    // costs three lines and cannot silently stop working.
    const close = () => {
      // Close FIRST, restore after. The other order looks more careful and is
      // wrong: closing a modal makes the user agent do its own focus
      // restoration, which lands on <body> and overwrites the focus() below —
      // verified in the browser, the expand button did not get it back. Leaving
      // focus on the body after dismissing a dialog is the kind of thing only
      // keyboard users notice, and only by being lost.
      if (dialog.open) dialog.close();
      restore();
    };

    expand.addEventListener("click", open);
    collapse.addEventListener("click", close);
    dialog.addEventListener("close", restore);
    dialog.addEventListener("cancel", restore);
    // Escape, handled here rather than trusted to the UA's event: same reason.
    dialog.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape") close();
    });
    // Clicking the backdrop. A modal dialog's own box IS the element, so a
    // click whose target is the dialog itself landed outside the panel.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });
  }

  if (log && form && input && send) {
    // The Worker holds no memory, so the whole (short) transcript rides along.
    // Six turns is the server's cap too; trimming here keeps the request
    // honest. It is also shared with the palette through sessionStorage, so
    // arriving on this page mid-conversation continues it rather than
    // restarting it — see lib/bob-memory.ts.
    let history: { role: string; content: string }[] = [];
    let busy = false;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function addTurn(who: string, text: string) {
      const div = document.createElement("div");
      div.className = `turn ${who}`;
      const label = document.createElement("span");
      label.className = "who";
      label.textContent = who === "bob" ? "bob" : "toi";
      const p = document.createElement("p");
      div.append(label, p);
      log!.append(div);
      return p;
    }

    /**
     * Reveal at roughly 12 ms/char, capped at 2.5 s total. The asciicasts use
     * 45–115 ms/char, which reads beautifully there and would take half a minute
     * for a 400-character answer here — the house timing does not transfer.
     *
     * Types as plain text, then swaps in the linked version once finished:
     * re-parsing partial text every tick would make anchors flicker in and out.
     */
    function reveal(p: HTMLParagraphElement, text: string, links: any[]) {
      if (reduceMotion) {
        renderReply(p, text, links);
        return;
      }
      const step = Math.max(4, Math.min(12, 2500 / Math.max(text.length, 1)));
      let i = 0;
      const tick = () => {
        i += 1;
        p.textContent = text.slice(0, i);
        if (i < text.length) setTimeout(tick, step);
        else renderReply(p, text, links);
      };
      tick();
    }

    async function ask(question: string) {
      if (busy || !question.trim()) return;
      busy = true;
      send!.disabled = true;
      input!.value = "";
      fallbackTurn?.remove();
      openers?.remove();

      addTurn("toi", "").textContent = question;
      const answer = addTurn("bob", "");
      const stopThinking = startThinking(answer);

      history.push({ role: "user", content: question });
      history = history.slice(-MAX_TURNS);

      try {
        const res = await fetch("/api/bob/chat", {
          method: "POST",
          headers: { "content-type": "application/json" },
          // toMessages strips the per-turn links: they are for replaying the
          // page, not for the model.
          body: JSON.stringify({ messages: toMessages(history) }),
        });
        const data = await res.json();
        const reply = data.reply ?? "Pas de réponse. Bizarre.";
        // The Worker says which tier answered. When it is the local model on
        // `bob`, Bob says so himself — the local answers are visibly weaker, so
        // a silent downgrade would just read as Bob getting worse.
        if (data.localNote) {
          const note = document.createElement("p");
          note.className = "local-note";
          note.textContent = data.localNote;
          answer.before(note);
        }
        stopThinking();
        answer.textContent = "";
        reveal(answer, reply, data.links);
        history.push({ role: "assistant", content: reply, links: data.links || [] });
        history = history.slice(-MAX_TURNS);
        // Written once the answer is real, so a failed turn does not leave a
        // question hanging in storage with nothing after it.
        saveConversation(history);
      } catch {
        stopThinking();
        answer.textContent = "Le fil est coupé. Réessaie tantôt.";
      } finally {
        // Belt and braces: a spinner left running after an early return would
        // sit there forever, and the interval keeps a closure alive with it.
        stopThinking();
        busy = false;
        send!.disabled = false;
        input!.focus();
      }
    }

    /* --------------------------------------------------- reprise --- */
    /* Whatever was said before landing here — in the palette on an article, or
       on this page before you wandered off and came back — is replayed into
       the transcript and into `history`, so the next question is a genuine
       follow-up rather than a fresh start. Replayed, not re-asked: the model
       is not deterministic, so asking again would cost a call and answer
       something different from what the visitor already read. */
    (function resumeConversation() {
      const { turns } = loadConversation();
      if (turns.length < 2) return;

      fallbackTurn?.remove();
      openers?.remove();
      turns.forEach((m) => {
        if (m.role === "user") {
          addTurn("toi", "").textContent = m.content;
          return;
        }
        const answer = addTurn("bob", "");
        // The shared renderer, so a slug that came back out of storage is
        // still subject to the same rule: only hrefs the Worker validated.
        // Each reply gets ITS OWN links. Replaying only the last one's is the
        // bug this shape was changed to fix: on a refresh every earlier answer
        // came back as bare prose.
        renderReply(answer, m.content, m.links || []);
      });
      history = history.concat(turns).slice(-MAX_TURNS);
      input?.focus();
    })();

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      ask(input.value);
    });

    openers?.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      const q = t?.dataset?.q;
      if (q) ask(q);
    });
  }
</script>
