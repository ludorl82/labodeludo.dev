---
import { BOB_QUIPS } from "../lib/bob-humor";

interface NavItem {
  href: string;
  label: string;
}

interface Props {
  lang?: "fr" | "en";
  homeHref?: string;
  navItems?: NavItem[];
}

const { lang = "fr", homeHref = "/", navItems = [] } = Astro.props;

const pages = [{ href: homeHref, label: lang === "en" ? "Home" : "Accueil" }, ...navItems];

const shortcuts =
  lang === "en"
    ? [
        ["j / k", "move between posts, or scroll an article"],
        ["f / b", "page down / up, faster"],
        ["gg / G", "top / bottom of the list or article"],
        ["gh", "go to the homepage"],
        ["gn / gp", "next / previous nav page"],
        ["g1-g9", "jump straight to nav page N"],
        ["Enter", "open focused post"],
        [":bob", "summon Bob (one quip at a time)"],
        ["Esc", "clear focus / close this"],
        ["?", "toggle this cheat sheet"],
      ]
    : [
        ["j / k", "se déplacer entre les articles, ou faire défiler un article"],
        ["f / b", "avancer / reculer d'une page, plus vite"],
        ["gg / G", "haut / bas de la liste ou de l'article"],
        ["gh", "revenir à l'accueil"],
        ["gn / gp", "page de nav suivante / précédente"],
        ["g1-g9", "aller directement à la page de nav N"],
        ["Entrée", "ouvrir l'article ciblé"],
        [":bob", "invoquer Bob (une réplique à la fois)"],
        ["Échap", "annuler le focus / fermer ceci"],
        ["?", "afficher / masquer cette aide"],
      ];

const bobHint =
  lang === "en" ? "n: another one · Esc: close" : "n : une autre · Échap : fermer";
// Server-rendered pick as the initial quip; the script re-rolls on open so a
// cached page doesn't always greet with the same line (same doctrine as
// bob-humor.ts: never freeze a build-time pick as the only outcome).
const initialQuip = BOB_QUIPS[Math.floor(Math.random() * BOB_QUIPS.length)];

const title = lang === "en" ? "Keyboard shortcuts" : "Raccourcis clavier";
---

<div id="keyboard-help" class="keyboard-help" hidden>
  <div class="keyboard-help-panel">
    <p class="keyboard-help-title">$ {title.toLowerCase().replace(/ /g, "_")} --help</p>
    <dl>
      {
        shortcuts.map(([key, desc]) => (
          <div class="row">
            <dt>{key}</dt>
            <dd>{desc}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>

<div id="sudo-toast" class="sudo-toast" hidden></div>

<div id="bob-overlay" class="keyboard-help" hidden>
  <div class="keyboard-help-panel">
    <p class="keyboard-help-title">$ bob --quip</p>
    <p id="bob-quip" class="bob-quip">{initialQuip}</p>
    <p class="bob-hint">{bobHint}</p>
  </div>
</div>

<div id="cmdline" class="cmdline" hidden aria-hidden="true">
  <span id="cmdline-text">:</span><span class="cmdline-cursor"></span>
</div>

<style>
  .keyboard-help {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vh 4vw;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(2px);
  }

  .keyboard-help[hidden] {
    display: none;
  }

  .keyboard-help-panel {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    padding: 1.5rem 1.75rem;
    max-width: 24rem;
    width: 100%;
    font-family: var(--font-mono);
  }

  .keyboard-help-title {
    margin: 0 0 1rem;
    color: var(--accent-live);
    font-size: 0.875rem;
  }

  dl {
    margin: 0;
  }

  .row {
    display: flex;
    gap: 1rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--panel-border);
  }

  .row:first-child {
    border-top: none;
  }

  dt {
    flex: 0 0 6rem;
    color: var(--text);
    font-weight: 600;
    font-size: 0.8125rem;
  }

  dd {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .sudo-toast {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 250;
    max-width: 22rem;
    background: var(--panel);
    border: 1px solid var(--accent-live);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text);
    white-space: pre-line;
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.6);
  }

  .sudo-toast[hidden] {
    display: none;
  }

  .bob-quip {
    margin: 0 0 1rem;
    color: var(--text);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .bob-hint {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .cmdline {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 300;
    padding: 0.35rem 0.75rem;
    background: var(--panel);
    border-top: 1px solid var(--panel-border);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text);
  }

  .cmdline[hidden] {
    display: none;
  }

  .cmdline-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 1px;
    vertical-align: text-bottom;
    background: var(--accent-live);
    animation: cmdline-blink 1.1s steps(1, end) infinite;
  }

  @keyframes cmdline-blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes sudo-glitch {
    0%,
    100% {
      filter: none;
    }
    25%,
    75% {
      filter: invert(1);
    }
  }

  :global(body.sudo-glitch) {
    animation: sudo-glitch 0.5s steps(2, end);
  }
</style>

<script define:vars={{ lang, homeHref, pages, quips: BOB_QUIPS }}>
  const help = document.getElementById("keyboard-help");
  const toast = document.getElementById("sudo-toast");
  const bobOverlay = document.getElementById("bob-overlay");
  const bobQuip = document.getElementById("bob-quip");
  const cmdline = document.getElementById("cmdline");
  const cmdlineText = document.getElementById("cmdline-text");
  const links = Array.from(
    document.querySelectorAll(
      ".list .row-link, .authors .author-link, .items .item-link, .diagram .node-link"
    )
  );

  function toggleHelp() {
    help.hidden = !help.hidden;
  }

  // --- vim-style command line (`:` … Enter) -------------------------------
  let cmdBuffer = "";
  let toastTimer;

  function showToast(message, ms) {
    toast.textContent = message;
    toast.hidden = false;
    window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.hidden = true;
    }, ms);
  }

  function rollQuip() {
    const current = bobQuip.textContent;
    let next = current;
    // Two draws is enough: pools this size collide rarely, and a repeat is
    // in character anyway ("j'ai déjà dit ça ? ça reste vrai").
    for (let i = 0; i < 2 && next === current; i++) {
      next = quips[Math.floor(Math.random() * quips.length)];
    }
    bobQuip.textContent = next;
  }

  function openCmdline() {
    cmdBuffer = "";
    cmdlineText.textContent = ":";
    cmdline.hidden = false;
  }

  function closeCmdline() {
    cmdline.hidden = true;
  }

  function runCommand(cmd) {
    if (cmd === "bob") {
      rollQuip();
      bobOverlay.hidden = false;
      return;
    }
    if (cmd === "q" || cmd === "q!" || cmd === "wq") {
      const msg =
        lang === "en"
          ? "E37: you cannot quit a homepage (this is not vim, sorry)"
          : "E37 : on ne quitte pas une page d'accueil (ce n'est pas vim, désolé)";
      showToast(msg, 4000);
      return;
    }
    if (cmd !== "") {
      const msg =
        lang === "en"
          ? `E492: Not an editor command: ${cmd}`
          : `E492 : commande inconnue : ${cmd}`;
      showToast(msg, 4000);
    }
  }

  function handleCmdlineKey(e) {
    if (e.key === "Escape") {
      closeCmdline();
    } else if (e.key === "Enter") {
      closeCmdline();
      runCommand(cmdBuffer);
    } else if (e.key === "Backspace") {
      if (cmdBuffer === "") {
        closeCmdline();
      } else {
        cmdBuffer = cmdBuffer.slice(0, -1);
        cmdlineText.textContent = ":" + cmdBuffer;
      }
    } else if (e.key.length === 1) {
      cmdBuffer += e.key;
      cmdlineText.textContent = ":" + cmdBuffer;
    }
    e.preventDefault();
  }

  function handleBobOverlayKey(e) {
    if (e.key === "Escape" || e.key === "q") {
      bobOverlay.hidden = true;
    } else if (e.key === "n" || e.key === "j" || e.key === " " || e.key === "Enter") {
      rollQuip();
    }
    e.preventDefault();
  }

  function focusAt(index) {
    if (!links.length) return;
    const clamped = Math.max(0, Math.min(index, links.length - 1));
    links[clamped].focus();
    links[clamped].scrollIntoView({ block: "nearest" });
  }

  function gotoPage(index) {
    const page = pages[index];
    if (page) window.location.href = page.href;
  }

  function gotoRelativePage(delta) {
    const current = pages.findIndex((p) => p.href === window.location.pathname);
    const next = ((current === -1 ? 0 : current) + delta + pages.length) % pages.length;
    gotoPage(next);
  }

  let pendingG = false;
  let pendingGAt = 0;
  const G_TIMEOUT = 500;

  document.addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const tag = document.activeElement?.tagName;
    if (tag === "INPUT" || tag === "TEXTAREA") return;

    // Modal layers first: the command line and Bob's overlay swallow keys so
    // the nav bindings below never fire underneath them.
    if (!cmdline.hidden) {
      handleCmdlineKey(e);
      pendingG = false;
      return;
    }
    if (!bobOverlay.hidden) {
      handleBobOverlayKey(e);
      pendingG = false;
      return;
    }
    if (e.key === ":") {
      e.preventDefault();
      openCmdline();
      pendingG = false;
      return;
    }

    if (e.key === "?") {
      e.preventDefault();
      toggleHelp();
      pendingG = false;
      return;
    }

    if (e.key === "Escape") {
      if (!help.hidden) {
        help.hidden = true;
      } else {
        document.activeElement?.blur();
      }
      pendingG = false;
      return;
    }

    const gPending = pendingG && Date.now() - pendingGAt < G_TIMEOUT;
    pendingG = false;

    if (gPending) {
      if (e.key === "g") {
        e.preventDefault();
        if (links.length) {
          focusAt(0);
        } else {
          window.scrollTo({ top: 0 });
        }
        return;
      }
      if (e.key === "h") {
        e.preventDefault();
        window.location.href = homeHref;
        return;
      }
      if (e.key === "n") {
        e.preventDefault();
        gotoRelativePage(1);
        return;
      }
      if (e.key === "p") {
        e.preventDefault();
        gotoRelativePage(-1);
        return;
      }
      if (/^[1-9]$/.test(e.key)) {
        e.preventDefault();
        gotoPage(Number(e.key));
        return;
      }
    }

    if (e.key === "g") {
      pendingG = true;
      pendingGAt = Date.now();
      return;
    }

    const SCROLL_STEP = 100;
    const PAGE_ROWS = 5;
    const PAGE_FRACTION = 0.85;
    const current = links.indexOf(document.activeElement);

    if (e.key === "j") {
      e.preventDefault();
      if (links.length) {
        focusAt(current + 1);
      } else {
        window.scrollBy({ top: SCROLL_STEP });
      }
    } else if (e.key === "k") {
      e.preventDefault();
      if (links.length) {
        focusAt(current === -1 ? links.length - 1 : current - 1);
      } else {
        window.scrollBy({ top: -SCROLL_STEP });
      }
    } else if (e.key === "f") {
      e.preventDefault();
      if (links.length) {
        focusAt((current === -1 ? 0 : current) + PAGE_ROWS);
      } else {
        window.scrollBy({ top: window.innerHeight * PAGE_FRACTION });
      }
    } else if (e.key === "b") {
      e.preventDefault();
      if (links.length) {
        focusAt((current === -1 ? links.length - 1 : current) - PAGE_ROWS);
      } else {
        window.scrollBy({ top: -window.innerHeight * PAGE_FRACTION });
      }
    } else if (e.key === "G") {
      e.preventDefault();
      if (links.length) {
        focusAt(links.length - 1);
      } else {
        window.scrollTo({ top: document.documentElement.scrollHeight });
      }
    }
  });

  help.addEventListener("click", (e) => {
    if (e.target === help) help.hidden = true;
  });

  bobOverlay.addEventListener("click", (e) => {
    if (e.target === bobOverlay) {
      bobOverlay.hidden = true;
    } else {
      rollQuip();
    }
  });

  const KONAMI = [
    "arrowup",
    "arrowup",
    "arrowdown",
    "arrowdown",
    "arrowleft",
    "arrowright",
    "arrowleft",
    "arrowright",
    "b",
    "a",
  ];
  let progress = 0;

  document.addEventListener("keydown", (e) => {
    const key = e.key.toLowerCase();
    progress = key === KONAMI[progress] ? progress + 1 : key === KONAMI[0] ? 1 : 0;

    if (progress === KONAMI.length) {
      progress = 0;
      const message =
        lang === "en"
          ? "$ sudo su -\n[sudo] password for ludo: ********\nroot access granted (5s, don't tell ludo)"
          : "$ sudo su -\n[sudo] mot de passe pour ludo : ********\nAccès root accordé (5s, ne le dites pas à ludo)";
      showToast(message, 5000);
      document.body.classList.add("sudo-glitch");
      window.setTimeout(() => document.body.classList.remove("sudo-glitch"), 500);
    }
  });
</script>
