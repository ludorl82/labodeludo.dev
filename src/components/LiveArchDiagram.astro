---
// The SHAPE view of the generated architecture — drawn connections, few
// boxes — sitting above the exhaustive bands on /architecture/live.
//
// AUTOMATED-AUTHOR CONTRACT: this component is refreshed by the nightly
// diagram job (see scripts/topology/prompts/arch-diagram.md). The layout is
// authored; every COUNT and every host name comes from architecture.json so
// the numbers cannot silently lie between refreshes. Anything written here
// must pass scripts/topology/scan-public.py (documentation IPs and
// example-family domains only).
//
// INTERACTIVITY CONTRACT: every box that represents topology nodes carries
// data-node="<id>" (single node — joins the page's click-highlight and
// links to its source file) or data-nodes="<id> <id>..." (aggregate — a
// click lights exactly its members). Decorative marks (visiteurs, arrows,
// the WireGuard line) carry neither. The nightly driver refuses a refresh
// that strips these attributes.
//
// Canvas: the site column is narrow (~830px), so the flow is VERTICAL
// (edge → cluster → hardware, same order as the bands below) and the figure
// breaks out full-bleed on desktop. Keep the viewBox portrait-ish.
// Two seeds: architecture.json is what the four IaC repos DECLARE,
// fleet.json is what is physically plugged in — including everything no
// repo names. The gap between the two is drawn, not hidden.
import arch from "../data/architecture.json";
import fleet from "../data/fleet.json";

type TNode = {
  id: string;
  kind: string;
  label: string;
  meta: any;
  repo: string;
  source: string;
};
const nodes = arch.nodes as TNode[];
const kind = (k: string) => nodes.filter((n) => n.kind === k);
const byId = (id: string) => nodes.find((n) => n.id === id);
const src = (n: TNode) =>
  `https://github.com/ludorl82/${n.repo}/blob/HEAD/${n.source}`;

const dnsCount = kind("dns").length;
const accessCount = kind("access").length;
const appCount = kind("app").length;
const lambdaCount = kind("lambda").length;
const bucketCount = kind("bucket").length;
const hosts = kind("host");
const homeHosts = hosts.filter((h) => h.meta.class !== "cloud-vm");
const cloudHost = hosts.find((h) => h.meta.class === "cloud-vm");
const agents = hosts.filter((h) => h.meta.k3sRole === "agent");
const k3sAgents = agents.length;
// Machine NixOS ≠ nœud du cluster. La maison en héberge maintenant plusieurs
// qui sont gérées par l'IaC sans jamais joindre k3s — le repère se lit sur
// les arêtes member-of, pas sur l'appartenance à la bande « maison ».
const clusterNode = kind("cluster")[0];
const memberIds = new Set(
  (arch.edges as any[])
    .filter((e) => e.kind === "member-of" && e.to === clusterNode?.id)
    .map((e) => e.from),
);
const inK3s = (h: TNode) => memberIds.has(h.id);
const homeMembers = homeHosts.filter(inK3s);
const homeOutside = homeHosts.filter((h) => !inK3s(h));
const pinCount = (arch.edges as any[]).filter(
  (e) => e.kind === "pinned-to",
).length;
const externals = kind("external");
// Les onduleurs ont déjà quitté cette liste une fois : l'IaC les pilote
// toujours (modules NUT), mais plus aucun nœud de topologie ne les nomme, donc
// ils redescendent dans la bande du parc plus bas. upsCount reste le témoin de
// ce va-et-vient — il décide dans quelle bande ils sont dessinés.
const upsNodes = externals.filter((n) => n.id.startsWith("external:ups"));
const upsCount = upsNodes.length;
const tunnel = kind("tunnel")[0];
const traefik = byId("app:traefik");
const blogBucket = byId("bucket:labodeludo.dev");

// How each public name actually leaves the edge. The tunnel no longer lands
// on the ingress alone: some names are dialled straight at an in-cluster
// Service, some never touch the cluster at all, and some are split between
// the two. Partition all of it from the data — the split included, it shows
// up as a name carrying BOTH an `app:` and an `external:` origin, and this
// file used to recount that bucket by hand in a comment.
const routesTo = (arch.edges as any[]).filter((e) => e.kind === "routes-to");
const dnsNodes = kind("dns");
const externalIds = new Set(externals.map((n) => n.id));
const toTunnel = dnsNodes.filter((n) =>
  routesTo.some((e) => e.from === n.id && e.to === tunnel?.id),
);
// the names whose connector dials a LAN address rather than a cluster Service
const toLanOrigin = toTunnel.filter((n) =>
  routesTo.some((e) => e.from === n.id && externalIds.has(e.to)),
);
// Of those, the ones where the LAN box is the whole path: the cluster is not
// on it at all.
const toExternal = toLanOrigin.filter(
  (n) => !routesTo.some((e) => e.from === n.id && e.to.startsWith("app:")),
);
// The rest reach the cluster AND the box: the tunnel sorts them by URL path
// (one rule at a pod, the catch-all at the machine), so counting them as
// purely hors-cluster is the same lie in the other direction.
const sharedPath = toLanOrigin.filter((n) => !toExternal.includes(n));
const inCluster = toTunnel.filter((n) => !toExternal.includes(n));
// The four buckets stay disjoint whatever the data does: a name that both
// transits the ingress and ends on a LAN box belongs to the split sentence,
// not to two counts at once.
const viaIngress = inCluster.filter(
  (n) =>
    !sharedPath.includes(n) &&
    typeof n.meta.origin === "string" &&
    n.meta.origin.includes("traefik."),
);
const directToService = inCluster.filter(
  (n) => !viaIngress.includes(n) && !sharedPath.includes(n),
);
const sharedLabels = sharedPath.map((n) => n.label).join(", ");
const toBucket = dnsNodes.filter((n) =>
  routesTo.some((e) => e.from === n.id && e.to.startsWith("bucket:")),
);
// names with no origin edge at all — served at the edge itself
const servedAtEdge = dnsNodes.filter(
  (n) => !routesTo.some((e) => e.from === n.id),
);

// ---- la bande « maison » ------------------------------------------------
// Les machines ET les boîtes hors IaC se placent à partir des données. Elles
// étaient énumérées à la main, ce qui a fini par se voir : le jour où les
// onduleurs ont disparu de la topologie, leur case est restée vide au milieu
// de la rangée. Une rangée qui se compte toute seule ne garde pas le trou de
// celle qui s'en va — et accueille sans rien casser celle qui arrive.
const SITE_TOP = 620;
const H_X0 = 64;
const H_COLS = 3;
const H_PITCH_X = 128;
const H_PITCH_Y = 44;
const H_W = 116;
const H_H = 34;
const HOST_Y0 = 660;
const cell = (i: number, y0: number) => ({
  x: H_X0 + (i % H_COLS) * H_PITCH_X,
  y: y0 + Math.floor(i / H_COLS) * H_PITCH_Y,
});
const hostRows = Math.ceil(homeHosts.length / H_COLS);
// la rangée hors IaC descend avec la grille des machines : une machine de plus
// pousse le reste vers le bas au lieu de lui rentrer dedans
const EXT_Y0 = HOST_Y0 + hostRows * H_PITCH_Y + 26;
const usesCount = (id: string) =>
  (arch.edges as any[]).filter((e) => e.kind === "uses" && e.to === id).length;
// les hors-IaC que le connecteur compose directement : c'est ce qui rend le
// trait « origines hors cluster » vrai, et il vise maintenant les vraies cases
const originIds = new Set(
  routesTo.filter((e) => externalIds.has(e.to)).map((e) => e.to),
);
// Le pointillé ne veut pas dire « rien derrière », et un cas le prouve :
// `external:ollama` est le service qu'un des repos déclare bel et bien, sur
// une machine déjà dessinée en trait plein dans la grille du haut. Vu dans
// nixos-iac (hosts/gpu-01/configuration.nix) : l'origine LAN du tunnel est
// l'adresse VLAN10 de la machine, le port est ouvert, le service est activé
// là. architecture.json ne porte aucune adresse de machine — la graine ne
// peut pas faire le rapprochement, seul le snapshot le voit. Le nom affiché
// vient quand même de `byId`, pour qu'un châssis renommé suive tout seul ;
// si l'origine disparaît ou change de bécane, diagram-delta le signalera.
const originOnHost: Record<string, string> = {
  "external:ollama": "host:gpu-01",
};
const extBoxes = externals.map((n, i) => {
  const c = cell(i, EXT_Y0);
  const uses = usesCount(n.id);
  const hostId = originOnHost[n.id];
  const onHost = hostId
    ? (byId(hostId)?.label ?? hostId.split(":")[1])
    : undefined;
  return {
    n,
    ...c,
    row: Math.floor(i / H_COLS),
    origin: originIds.has(n.id),
    onHost,
    note: onHost
      ? `origine sur ${onHost}`
      : originIds.has(n.id)
        ? "origine de tunnel"
        : uses > 0
          ? `${uses} usages déclarés`
          : "référencé par l'IaC",
  };
});
const extOrigins = extBoxes.filter((b) => b.origin);
// les pointillés qui ne sont pas du matériel inconnu, mais un service posé
// sur une machine déclarée — c'est cette liste qui garde l'aria-label vrai
const hostedOrigins = extBoxes.filter((b) => b.onHost);
// « le nom se partage entre un pod et le service du host » n'est pas une
// déduction, c'est une arête. Ça a été vrai : le tunnel portait une règle
// /api/embed vers un pod du cluster et le reste du nom partait à l'adresse LAN
// du host. La règle est retirée (cloudflare-iac, live/tunnels.tf, 2026-09-15)
// et le join ne porte plus aucune arête `app:` sur ce nom — `sharedPath` est
// vide, et l'aria-label ne doit pas raconter un chemin que plus aucune arête
// ne déclare. Le partage se vérifie donc sur l'origine hébergée elle-même, pas
// sur le bucket global : un autre nom pourrait être coupé par chemin d'URL que
// celui-ci resterait entier.
const hostedSplit = hostedOrigins.some((b) =>
  routesTo
    .filter((e) => e.to === b.n.id)
    .some((e) =>
      routesTo.some((f) => f.from === e.from && f.to.startsWith("app:")),
    ),
);
const railY = (row: number) => EXT_Y0 + row * H_PITCH_Y - 16;
const railBottom = railY(
  extOrigins.length ? Math.max(...extOrigins.map((b) => b.row)) : 0,
);
const extRows = Math.ceil(externals.length / H_COLS);
const extBottom = EXT_Y0 + extRows * H_PITCH_Y - (H_PITCH_Y - H_H);
const noteY1 = extBottom + 22;
const noteY2 = noteY1 + 13;
// le cadre des deux sites ne rétrécit jamais sous sa taille dessinée, mais il
// grandit si le contenu le dépasse
const SITE_BOTTOM = Math.max(980, noteY2 + 14);

// ---- le parc, hors IaC -------------------------------------------------
// fleet.json carries the boxes no repo declares: the switches, the AP, the
// BMCs, the printer, the personal machines, the domotique. A device is
// drawn ONCE: anything architecture.json already names has a box above —
// hosts and the hors-IaC nodes the IaC references by name — plus the
// onduleurs, but ONLY while the topology still carries them. It no longer
// does, so they land here instead of vanishing between the two bands. An
// empty devices array simply means the seed has not run: nothing is drawn
// and nothing is said.
type FDevice = {
  class: string;
  count?: number;
  hostedBy?: string;
  iacDeclared?: boolean;
  location?: string;
  name: string;
  network?: string;
  role?: string;
};
const fleetDevices = ((fleet as any).devices ?? []) as FDevice[];
const drawnNames = new Set(
  nodes
    .filter((n) => n.kind === "host" || n.kind === "external")
    .map((n) => n.label),
);
// Le dédoublonnage se fait sur ce qu'architecture.json contient VRAIMENT, pas
// sur le drapeau iacDeclared du parc : le drapeau dit « déjà dessiné plus
// haut », et il se trompe dès qu'une machine sort de l'IaC entre deux passes
// du seed. S'y fier ferait disparaître l'appareil des deux bandes à la fois —
// exactement l'angle mort que cette bande existe pour éclairer.
const fleetExtras = fleetDevices.filter(
  (d) => !drawnNames.has(d.name) && !(d.class === "ups" && upsCount > 0),
);
// La dérive dans l'autre sens : le drapeau `iacDeclared` du parc dit « déjà
// dans architecture.json » et, pour ceux-là, la topologie des quatre repos
// publics ne leur connaît aucun nœud. Ne pas dire de plus : pas « aucun repo
// ne les nomme ». Ça s'est vérifié dans l'instantané et ça fait tomber la
// phrase — win11 se lit bel et bien dans nixos-iac-public (guests/win11/libvirt-
// domain.xml, et le hook de game mode de hosts/gaming-01), seulement sous
// guests/ et non sous hosts/, là où emit-topology ne regarde pas : le script ne
// marche que les nixosConfigurations. Les deux graines peuvent donc avoir raison
// chacune dans son registre, et « l'inventaire a tort » n'est pas décidable
// d'ici. Ils restent branchés, ils tirent du courant — ça se dit, et rien de
// plus : le drapeau est posé par une session privée, l'instantané public n'est
// pas tenu au même rythme que le repo privé, et le join ne lit que le public.
// Donc ni « l'IaC a cessé de les nommer » ni « jamais déclarés » ne tiennent —
// seul le désaccord des deux graines est un fait, et il porte sur un nœud.
const orphans = fleetDevices.filter(
  (d) => d.iacDeclared === true && !drawnNames.has(d.name),
);
const oneOrphan = orphans.length === 1;
// un orphelin que l'inventaire dit agent k3s est le seul cas où la bande du bas
// contredit un compte dessiné plus haut : ce compte-là est celui des déclarés.
// Le mot « k3s » tout seul ne suffit pas à le dire — le parc écrit aussi « pas
// un nœud k3s », et citer la négation à l'endroit faisait affirmer au schéma le
// contraire exact de ce que l'inventaire déclare. C'est la formule `agent k3s`
// qu'il faut lire, et rien qui la nie à côté.
const orphanAgents = orphans.filter((d) => {
  const role = d.role ?? "";
  return /agent k3s/i.test(role) && !/pas un|n'est pas|jamais un/i.test(role);
});
const fleetUnits = fleetExtras.reduce((n, d) => n + (d.count ?? 1), 0);
// « bien branchés » n'est pas une déduction, c'est un fait que la graine sait
// dire ou taire : le `role` d'une boîte peut la déclarer à l'arrêt. Une carte
// de rechange rangée dans une baie fait partie du parc, elle ne tire aucun
// courant pour autant — et son infobulle le dit déjà, ce qui mettait la
// légende en contradiction avec sa propre bande. L'adjectif se vérifie donc
// dans le texte du seed, et le nom cité vient de lui aussi, jamais d'ici.
const unpowered = fleetExtras.filter((d) =>
  /\bhors tension\b/i.test(d.role ?? ""),
);
const oneUnpowered = unpowered.length === 1;
// Le même adjectif se vérifie une deuxième façon : un `class` qui finit par
// « vm » n'a jamais eu de prise à lui. La puce de la bande l'affiche déjà
// (CLASS_FR plus bas), donc le sous-titre ne peut pas promettre « bien
// branchés » à ces cases-là sans se contredire lui-même. L'hôte n'est nommé
// que s'il est dessiné plus haut — c'est le seul rapprochement que la graine
// du parc permet, et le seul que ce schéma puisse attester.
const virtuals = fleetExtras.filter((d) => /(^|-)vm$/.test(d.class));
const oneVirtual = virtuals.length === 1;
const guestHost = (d: FDevice) =>
  d.hostedBy && drawnNames.has(d.hostedBy) ? d.hostedBy : undefined;
const virtualList = virtuals
  .map((d) => {
    const host = guestHost(d);
    return host ? `${d.name}, posée sur ${host}` : d.name;
  })
  .join(", ");
// Le mot de classe des châssis du haut se vérifie, lui aussi, contre le parc.
// `meta.class` sort d'un heuristic de PRÉFIXE DE NOM dans nixos-iac
// (scripts/emit-topology.py : « gpu- », « vm- », « console- »…), et « arcade- »
// ne matche rien — arcade1 et arcade2 étaient étiquetés « server » sur le
// dessin. L'instantané dit autre chose, et les deux graines tombent d'accord :
// `class: vm`, `hostedBy: gaming-01` dans fleet.json, et
// hosts/arcade1/configuration.nix s'ouvre par « a NixOS libvirt guest on
// gaming-01 ». Le châssis qui les porte étant déjà dessiné juste à côté, la
// grille du haut est la seule case du schéma où ce lien pouvait se lire : la
// bande du bas, elle, les dédoublonne et ne les note donc nulle part.
const fleetIsGuest = (h: TNode) => {
  const d = fleetDevices.find((f) => f.name === h.label);
  const host = d?.hostedBy;
  return host &&
    /(^|-)vm$/.test(d?.class ?? "") &&
    !/(^|-)vm$/.test(String(h.meta.class ?? "")) &&
    drawnNames.has(host)
    ? host
    : undefined;
};
const homeGuests = homeHosts.filter((h) => fleetIsGuest(h));
const pluggedIn =
  unpowered.length || virtuals.length
    ? "sous tension pour la plupart"
    : "bien branchés";
const offDuty = unpowered.length
  ? ` — ${oneUnpowered ? "une exception" : `${unpowered.length} exceptions`}, ${unpowered
      .map((d) => d.name)
      .join(", ")}, qui ${oneUnpowered ? "dort" : "dorment"} hors tension et ${
      oneUnpowered ? "compte" : "comptent"
    } quand même —`
  : "";
// « qui tire du courant », dans la légende, se vérifie comme l'adjectif du
// sous-titre : un domaine invité n'a pas de fiche quelque part, et c'est le
// `class` du seed qui le dit — pas l'allure de la bande.
const pluggedClause = virtuals.length
  ? "tire du courant pour la plupart"
  : "tire du courant";
// the seam worth naming: an undeclared machine that nonetheless carries a
// declared k3s agent — a layer crossing only the fleet seed can see
const agentNames = new Set(agents.map((a) => a.label));
const carriers = fleetExtras
  .map((d) => ({
    d,
    carried: fleetDevices
      .filter((o) => o.hostedBy === d.name && agentNames.has(o.name))
      .map((o) => o.name),
  }))
  .filter((c) => c.carried.length > 0);

const NET_FR: Record<string, string> = {
  vlan10: "VLAN serveurs",
  vlan50: "VLAN maison",
  "out-of-band": "réseau hors bande",
};
const CLASS_FR: Record<string, string> = {
  "access-point": "borne Wi-Fi",
  bmc: "gestion hors bande",
  camera: "caméra",
  desktop: "poste",
  domotique: "domotique",
  laptop: "portable",
  nas: "stockage",
  phone: "téléphonie",
  printer: "imprimante",
  router: "routeur",
  sbc: "carte SBC",
  server: "serveur",
  switch: "commutateur",
  ups: "onduleur",
  vm: "machine virtuelle",
};
// dit à voix haute dans l'aria-label plutôt qu'énuméré à la main : la liste
// suit le parc au lieu de vieillir avec lui
const fleetClasses = [
  ...new Set(fleetExtras.map((d) => CLASS_FR[d.class] ?? d.class)),
];
const NET_ORDER = ["vlan10", "vlan50", "out-of-band"];
const netOf = (d: FDevice) => d.network ?? "—";
// known networks first, then anything the map has never heard of, so a new
// segment appears in the drawing instead of vanishing from it
const netKeys = [
  ...NET_ORDER.filter((k) => fleetExtras.some((d) => netOf(d) === k)),
  ...[...new Set(fleetExtras.map(netOf))].filter((k) => !NET_ORDER.includes(k)),
];

// laid out here rather than in the markup: the band grows DOWNWARD with the
// fleet, and the viewBox grows with it
const F_TOP = SITE_BOTTOM + 20;
const F_COLS = 5;
const F_PITCH_X = 132;
const F_CHIP_W = 124;
const F_CHIP_H = 30;
const F_PITCH_Y = 36;
let fCursor = F_TOP + 62;
const fleetBands = netKeys.map((net) => {
  const head = fCursor;
  const items = fleetExtras
    .filter((d) => netOf(d) === net)
    .map((d, i) => ({
      d,
      x: 56 + (i % F_COLS) * F_PITCH_X,
      y: head + 12 + Math.floor(i / F_COLS) * F_PITCH_Y,
    }));
  fCursor = head + 12 + Math.ceil(items.length / F_COLS) * F_PITCH_Y + 10;
  return { net, label: NET_FR[net] ?? net, items };
});
const fleetBottom = fCursor;
// les coutures que seul le croisement des deux graines voit
const fleetNotes = [
  ...carriers.map(
    (c) =>
      `↑ ${c.d.name} n'est déclaré nulle part et porte pourtant ` +
      `${c.carried.join(", ")} — le cluster déborde de son IaC.`,
  ),
  ...(orphans.length
    ? [
        `↑ ${orphans.map((d) => d.name).join(", ")} : l'inventaire ${
          oneOrphan ? "le croit" : "les croit"
        } déclaré${oneOrphan ? "" : "s"}, la topologie publique ne ${
          oneOrphan ? "lui connaît" : "leur connaît"
        } aucun nœud.`,
        ...(orphanAgents.length
          ? [
              `↑ ${orphanAgents
                .map((d) => d.name)
                .join(", ")} s'y dit même agent k3s : les ${k3sAgents} ` +
                `agents du schéma sont les déclarés, pas les seuls branchés.`,
            ]
          : []),
      ]
    : []),
  // la couture inverse de `carriers` : un appareil que la graine dit posé sur
  // une machine, elle, déclarée. Le haut du schéma dessine le châssis, le bas
  // dessine l'invité, et personne ne dessine le lien — c'est donc ici qu'il se
  // nomme, avec l'hôte seulement quand il est vraiment dessiné plus haut.
  ...virtuals.map(
    (d) =>
      `↑ ${d.name} : domaine invité, pas une prise — ${
        guestHost(d)
          ? `son hôte ${guestHost(d)}, lui, est dessiné plus haut`
          : "la graine ne lui connaît pas d'hôte dessiné ici"
      }.`,
  ),
];
// « jamais déclarés » serait faux deux fois. D'abord dès qu'un orphelin est
// dans la bande : lui, le drapeau du parc le dit déclaré, et la topologie
// publique ne le confirme pas — sans le nier non plus, car un repo peut fort
// bien le nommer hors des nœuds qu'emit-topology ramasse (win11, encore, tenu
// par le hook de game mode dans hosts/gaming-01). Ensuite pour les
// onduleurs, redescendus ici parce qu'aucun nœud de topologie ne les nomme
// plus, alors que le repo NixOS les pilote toujours, module NUT par module
// NUT. Le seul fait que la graine garantisse, c'est l'absence de nœud — et
// c'est déjà tout ce qui explique qu'il n'y ait rien à cliquer.
const fleetSubtitle = orphans.length
  ? `${pluggedIn}, déclarés par l'inventaire mais sans nœud : rien à allumer, aucune source à ouvrir`
  : `${pluggedIn}, hors de la topologie : rien à allumer, aucune source à ouvrir`;
const svgH = fleetExtras.length
  ? fleetBottom + 26 + fleetNotes.length * 14
  : SITE_BOTTOM + 20;

const appIds = kind("app").map((n) => n.id).join(" ");
const agentIds = agents.map((n) => n.id).join(" ");
const lambdaIds = kind("lambda").map((n) => n.id).join(" ");
const bucketIds = kind("bucket").map((n) => n.id).join(" ");

const ariaLabel =
  `Schéma d'architecture : les visiteurs entrent par Cloudflare (${dnsCount} ` +
  `noms publics, ${accessCount} applications Access). ${toBucket.length} nom ` +
  `pointe vers le bucket S3 du blog, ${servedAtEdge.length} sont servis à ` +
  `l'edge lui-même, et ${toTunnel.length} descendent dans l'unique tunnel ` +
  `sortant, initié depuis le cluster. De ces ${toTunnel.length} noms, ` +
  `${viaIngress.length} passent par l'ingress traefik, ` +
  `${directToService.length} visent directement un Service du cluster sans ` +
  `passer par l'ingress, ${toExternal.length} ne touchent pas le cluster ` +
  `du tout : le connecteur atteint leurs origines en LAN, du matériel hors ` +
  `IaC` +
  (sharedPath.length
    ? `, et ${sharedPath.length} ${
        sharedPath.length > 1 ? "noms se partagent" : "nom se partage"
      } entre les deux (${sharedLabels}) : le tunnel trie par chemin d'URL, ` +
      `un pod du cluster d'un côté, une origine hors cluster de l'autre ` +
      `— il trie, je dessine`
    : "") +
  `. Le cluster s'étend sur deux sites reliés par WireGuard : la maison ` +
  `(${homeHosts.length} machines NixOS, ${k3sAgents} agents k3s) et un EC2 ` +
  `chez AWS qui est l'unique control-plane, le hub WireGuard vers lequel la ` +
  `maison compose — côté maison la liaison se termine sur le pare-feu hors ` +
  `IaC et aucun port n'y est ouvert — et qui héberge aussi un connecteur de ` +
  `tunnel. ${appCount} applications y tournent, dont ${pinCount} workloads ` +
  `épinglés à une machine précise.` +
  (homeOutside.length
    ? ` Côté maison, être une machine NixOS ne veut pas dire être un nœud du ` +
      `cluster : ${homeMembers.length} des ${homeHosts.length} en sont, les ` +
      `${homeOutside.length} autres ` +
      `(${homeOutside.map((h) => h.label).join(", ")}) sont gérées par l'IaC ` +
      `sans jamais joindre k3s.`
    : "") +
  (homeGuests.length
    ? ` Méfie-toi du mot « machines » : ${homeGuests.length} des ` +
      `${homeHosts.length} de la grille ne sont pas du fer mais des invitées ` +
      `libvirt, posées sur un châssis dessiné dans la même grille (${homeGuests
        .map((h) => `${h.label} sur ${fleetIsGuest(h)}`)
        .join(", ")}). Le nombre ne bouge pas — elles sont bien NixOS et bien ` +
      `gérées par l'IaC ; c'est la nature de la case qui se corrige, pas le ` +
      `compte.`
    : "") +
  (externals.length
    ? ` Toujours côté maison, ${externals.length} boîtes en pointillés ` +
      `(${externals.map((n) => n.label).join(", ")}) ne sont déclarées par ` +
      `aucun repo comme machines : elles n'existent dans la topologie que ` +
      `parce que l'IaC les nomme en passant, et c'est ce qui les rend ` +
      `cliquables.`
    : "") +
  (hostedOrigins.length
    ? ` Le pointillé ne veut pas dire « rien derrière » : ` +
      `${hostedOrigins.map((b) => `${b.n.label} est un service que le repo NixOS déclare sur ${b.onHost}`).join(", ")}. ` +
      `Même châssis que la machine en trait plein de la grille du haut` +
      (hostedSplit
        ? ` — et sur ce nom le tunnel trie par chemin d'URL : un pod du ` +
          `cluster d'un côté, le service du host de l'autre, et le visiteur ` +
          `ne voit jamais qu'un seul nom.`
        : ` — mais rien ne descend du cluster sur ce nom : le connecteur ` +
          `compose le service du host, et aucun workload déclaré ne le sert.`)
    : "") +
  ` Chaque boîte cliquable répond à une seule question : le chemin qu'elle ` +
  `emprunte, d'un nom public jusqu'à la machine qui le sert — et l'inverse ` +
  `si tu pars d'une machine. Les groupes s'allument tels quels, et une ` +
  `machine sans lien déclaré n'a pas de chemin à allumer.` +
  (fleetExtras.length
    ? ` Une dernière bande montre le reste du parc : ${fleetUnits} ` +
      `appareils ${
        virtuals.length
          ? `${
              oneVirtual
                ? "dont une machine virtuelle"
                : `dont ${virtuals.length} machines virtuelles`
            } (${virtualList})`
          : "bien réels"
      } — ${fleetClasses.join(", ")} — qu'aucun des quatre ` +
      `repos publics ne déclare dans sa topologie, répartis sur ` +
      `${netKeys.length} segments réseau. Ceux-là ` +
      `n'ont pas de source à ouvrir, donc pas de clic.` +
      (orphans.length
        ? ` ${oneOrphan ? "Un seul" : `${orphans.length} d'entre eux`} ` +
          `(${orphans.map((d) => d.name).join(", ")}) y figure${
            oneOrphan ? "" : "nt"
          } parce que l'inventaire ${
            oneOrphan ? "le croit" : "les croit"
          } déclaré${oneOrphan ? "" : "s"} alors que la topologie des quatre ` +
          `repos publics ne ${
            oneOrphan ? "lui connaît" : "leur connaît"
          } aucun nœud — et l'instantané me laisse voir que le nom, lui, peut ` +
          `fort bien se lire dans un repo : ce qui manque est le nœud, pas la ` +
          `trace. Les deux graines peuvent avoir raison chacune dans son ` +
          `registre ; laquelle croit trop, je ne peux pas le trancher d'ici.` +
          (orphanAgents.length
            ? ` Et ${orphanAgents
                .map((d) => d.name)
                .join(", ")} s'y dit agent k3s : les ${k3sAgents} agents de ` +
              `ce schéma sont les déclarés, pas les seuls branchés.`
            : "")
        : "") +
      (carriers.length
        ? ` ${carriers.length > 1 ? "Certains d'entre eux portent" : "L'un d'eux porte"} ` +
          `pourtant ${carriers.flatMap((c) => c.carried).join(", ")} : ` +
          `${
            carriers.flatMap((c) => c.carried).length > 1
              ? "des agents du cluster tournent"
              : "un agent du cluster tourne"
          } sur du matériel que l'IaC ne connaît pas.`
        : "")
    : "");
---

<figure class="live-arch">
  <div class="diagram-wrap">
    <svg viewBox={`0 0 760 ${svgH}`} role="img" aria-label={ariaLabel}>
      <defs>
        <marker id="la-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-faint)" />
        </marker>
        <marker id="la-arrow-live" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--accent-live)" />
        </marker>
      </defs>

      <!-- visiteurs (décoratif) -->
      <ellipse cx="190" cy="46" rx="82" ry="28" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="190" y="43" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--text)">visiteurs</text>
      <text x="190" y="58" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">HTTPS</text>

      <!-- le blog lui-même : servi en statique -->
      <a class="svg-node" data-node={blogBucket?.id} href={blogBucket && src(blogBucket)}>
        <title>le bucket S3 du blog — cliquer pour allumer son chemin</title>
        <rect x="470" y="18" width="230" height="56" rx="6" fill="var(--panel)" stroke="var(--panel-border)" stroke-width="1.5" />
        <text x="585" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" fill="var(--text)">s3://labodeludo.dev</text>
        <text x="585" y="57" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">ce blog — fichiers statiques</text>
      </a>

      <!-- Cloudflare edge = le tunnel et ses noms -->
      <a class="svg-node" data-node={tunnel?.id} href={tunnel && src(tunnel)}>
        <title>l'edge Cloudflare — le tunnel et ses noms publics</title>
        <rect x="80" y="120" width="600" height="78" rx="6" fill="var(--panel)" stroke="var(--panel-border)" stroke-width="1.5" />
        <text x="380" y="143" text-anchor="middle" font-family="var(--font-display)" font-size="12.5" font-weight="600" fill="var(--text)">Cloudflare edge</text>
        <text x="380" y="161" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--text-faint)">{dnsCount} noms publics · {accessCount} apps Access · 0 port ouvert vers la maison</text>
        <text x="380" y="178" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--text-faint)">{servedAtEdge.length} servis à l'edge · {toBucket.length} vers S3 · {toTunnel.length} par le tunnel</text>
      </a>

      <path d="M190,74 L190,118" fill="none" stroke="var(--text-faint)" stroke-width="1.5" marker-end="url(#la-arrow)" />
      <path d="M585,118 L585,76" fill="none" stroke="var(--text-faint)" stroke-width="1.5" marker-end="url(#la-arrow)" />
      <text x="600" y="100" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">statique</text>

      <!-- tunnel sortant (décoratif — la boîte edge porte le nœud) -->
      <path d="M380,282 L380,200" fill="none" stroke="var(--accent-live)" stroke-width="1.7" stroke-dasharray="5 4" marker-end="url(#la-arrow-live)" />
      <text x="394" y="228" font-family="var(--font-mono)" font-size="10.5" fill="var(--accent-live)">tunnel cloudflared — sortant, initié du cluster</text>

      <!-- les noms dont le connecteur compose une adresse LAN : le cluster
           n'est sur le chemin d'aucun d'eux par l'ingress. Les uns n'y
           entrent pas du tout ; les autres y entrent quand même, triés par
           chemin d'URL — c'est le « +N » du trait de contournement, à droite.
           (décoratif — les boîtes hors IaC portent les nœuds) -->
      {toLanOrigin.length > 0 && extOrigins.length > 0 && (
        <g>
          <path d={`M100,200 L100,206 L22,206 L22,${railBottom}`} fill="none" stroke="var(--accent-live)" stroke-width="1.4" stroke-dasharray="5 4" />
          {extOrigins.map((b) => (
            <path d={`M22,${railY(b.row)} L${b.x + H_W / 2},${railY(b.row)} L${b.x + H_W / 2},${b.y - 2}`} fill="none" stroke="var(--accent-live)" stroke-width="1.4" stroke-dasharray="5 4" marker-end="url(#la-arrow-live)" />
          ))}
          <text x="32" y="224" font-family="var(--font-mono)" font-size="10" fill="var(--accent-live)">{toLanOrigin.length} noms publics → {extOrigins.length} origines hors cluster,</text>
          <text x="32" y="237" font-family="var(--font-mono)" font-size="10" fill="var(--accent-live)">atteintes en LAN par le connecteur</text>
        </g>
      )}

      <!-- ============ cluster k3s ============ -->
      <rect x="40" y="250" width="680" height="330" rx="8" fill="none" stroke="var(--accent-live)" stroke-width="1.2" stroke-dasharray="2 3" />
      <text x="58" y="274" font-family="var(--font-mono)" font-size="11" fill="var(--accent-live)">cluster k3s — un seul cluster, deux sites</text>

      <!-- traefik -->
      <a class="svg-node" data-node={traefik?.id} href={traefik && src(traefik)}>
        <title>traefik — l'ingress du cluster</title>
        <rect x="280" y="292" width="200" height="48" rx="6" fill="var(--panel)" stroke="var(--panel-border)" stroke-width="1.5" />
        <text x="380" y="312" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" fill="var(--text)">traefik (ingress)</text>
        <text x="380" y="329" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">{viaIngress.length} noms publics · TLS interne</text>
      </a>

      <!-- contournement de l'ingress : ces noms visent le Service directement
           (décoratif — l'agrégat applications porte les nœuds). Le « +N » est
           le nom que le tunnel coupe par chemin d'URL : une partie de ses
           requêtes descend ici, le reste ressort vers une boîte hors IaC. -->
      {directToService.length > 0 && (
        <g>
          <path d="M380,270 L560,270 L560,405 L519,405" fill="none" stroke="var(--accent-live)" stroke-width="1.5" marker-end="url(#la-arrow-live)" />
          <text x="568" y="300" font-family="var(--font-mono)" font-size="9.5" fill="var(--accent-live)">{directToService.length} noms visent</text>
          <text x="568" y="313" font-family="var(--font-mono)" font-size="9.5" fill="var(--accent-live)">le Service direct,</text>
          <text x="568" y="326" font-family="var(--font-mono)" font-size="9.5" fill="var(--accent-live)">sans l'ingress</text>
          {sharedPath.length > 0 && (
            <text x="568" y="345" font-family="var(--font-mono)" font-size="9.5" fill="var(--accent-live)">+{sharedPath.length} pour un chemin</text>
          )}
        </g>
      )}

      <!-- apps (agrégat : un clic allume exactement ses membres) -->
      <g class="svg-node" data-nodes={appIds}>
        <title>les applications du cluster — cliquer pour les allumer toutes</title>
        <rect x="245" y="376" width="270" height="58" rx="6" fill="var(--panel)" stroke="var(--panel-border)" stroke-width="1.5" />
        <text x="380" y="399" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--text)">{appCount} applications</text>
        <text x="380" y="417" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">{pinCount} workloads épinglés à leur machine</text>
      </g>
      <path d="M380,340 L380,374" fill="none" stroke="var(--text-faint)" stroke-width="1.5" marker-end="url(#la-arrow)" />

      <!-- agents maison (agrégat) -->
      <g class="svg-node" data-nodes={agentIds}>
        <title>les agents k3s de la maison</title>
        <rect x="80" y="470" width="230" height="80" rx="6" fill="var(--panel)" stroke="var(--panel-border)" stroke-width="1.5" />
        <text x="195" y="494" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--text)">{k3sAgents} agents k3s</text>
        <text x="195" y="511" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">serveurs · Pi · VMs</text>
        <text x="195" y="526" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">VLAN serveurs, maison</text>
      </g>
      <path d="M310,455 L360,436" fill="none" stroke="var(--text-faint)" stroke-width="1.5" marker-end="url(#la-arrow)" />

      <!-- control-plane EC2 (dans le cluster) -->
      <a class="svg-node" data-node={cloudHost?.id} href={cloudHost && src(cloudHost)}>
        <title>cloud-01 — cliquer pour allumer les chemins qui passent par lui</title>
        <rect x="450" y="470" width="230" height="80" rx="6" fill="var(--panel)" stroke="var(--panel-border)" stroke-width="1.5" />
        <text x="565" y="494" text-anchor="middle" font-family="var(--font-display)" font-size="12" font-weight="600" fill="var(--text)">{cloudHost?.label ?? "cloud-01"}</text>
        <text x="565" y="509" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">EC2 — UNIQUE control-plane</text>
        <text x="565" y="524" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">etcd · taint dédiée · site AWS</text>
        <text x="565" y="539" text-anchor="middle" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">connecteur tunnel résident</text>
      </a>
      <path d="M450,455 L400,436" fill="none" stroke="var(--text-faint)" stroke-width="1.5" marker-end="url(#la-arrow)" />

      <!-- WireGuard entre les deux moitiés du cluster (décoratif).
           Direction : cloud-01 est le hub (il écoute), son unique pair est le
           pare-feu et n'a pas d'endpoint — c'est donc la maison qui compose.
           La maison n'ouvre rien, ce qui rejoint le « 0 port ouvert » de l'edge. -->
      <path d="M310,510 H448" fill="none" stroke="var(--accent-live)" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#la-arrow-live)" />
      <text x="380" y="560" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--accent-live)">WireGuard — la maison compose vers le hub {cloudHost?.label ?? "cloud-01"}</text>
      <text x="380" y="573" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--accent-live)">côté maison : le pare-feu, hors IaC · aucun port ouvert</text>

      <!-- ============ les deux sites, physiquement ============ -->
      <path d="M195,550 L195,618" fill="none" stroke="var(--text-faint)" stroke-width="1.2" stroke-dasharray="2 3" />
      <path d="M565,550 L565,618" fill="none" stroke="var(--text-faint)" stroke-width="1.2" stroke-dasharray="2 3" />

      <!-- maison -->
      <rect x="40" y={SITE_TOP} width="420" height={SITE_BOTTOM - SITE_TOP} rx="8" fill="none" stroke="var(--panel-border)" stroke-width="1.2" />
      <text x="58" y="644" font-family="var(--font-mono)" font-size="11" fill="var(--text-faint)">maison — {homeHosts.length} machines NixOS</text>
      {
        homeHosts.map((h, i) => {
          const c = cell(i, HOST_Y0);
          const guest = fleetIsGuest(h);
          return (
            <a class="svg-node" data-node={h.id} href={src(h)}>
              <title>{h.label} — {guest ? `invitée libvirt sur ${guest}` : h.meta.class} · {inK3s(h) ? "nœud du cluster" : "gérée par l'IaC, hors cluster"} · cliquer pour allumer les chemins qui y aboutissent</title>
              <rect x={c.x} y={c.y} width={H_W} height={H_H} rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
              <text x={c.x + H_W / 2} y={c.y + 18} text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--text)">{h.label}</text>
              <text x={c.x + H_W / 2} y={c.y + 30} text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-faint)">{guest ? `vm · ${guest}` : h.meta.class}{inK3s(h) ? " · k3s" : ""}</text>
            </a>
          );
        })
      }

      <!-- les `external:`, vus depuis leurs bords : la rangée suit
           `externals`, elle n'énumère plus personne à la main -->
      {extBoxes.map(({ n, x, y, note, onHost }) => (
        <a class="svg-node" data-node={n.id} href={src(n)}>
          <title>{n.label} — {onHost ? "origine de tunnel : un service que l'IaC déclare sur une machine déclarée, pas une machine en soi" : "matériel qu'aucun repo ne déclare"}, {note}{n.meta.via ? ` · ${n.meta.via}` : ""} · cliquer pour allumer les chemins qui y aboutissent</title>
          <rect x={x} y={y} width={H_W} height={H_H} rx="4" fill="none" stroke="var(--text-faint)" stroke-dasharray="4 3" />
          <text x={x + H_W / 2} y={y + 18} text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--text-faint)">{n.label}</text>
          <text x={x + H_W / 2} y={y + 30} text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-faint)">{note}</text>
        </a>
      ))}
      {homeOutside.length > 0 && (
        <text x="64" y={noteY1} font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">« · k3s » : dans le cluster — {homeMembers.length} des {homeHosts.length} ; les autres : NixOS, zéro pod</text>
      )}
      <text x="64" y={noteY2} font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">pointillés : matériel non déclaré, mais que l'IaC nomme — donc cliquable</text>

      <!-- AWS -->
      <rect x="490" y={SITE_TOP} width="230" height={SITE_BOTTOM - SITE_TOP} rx="8" fill="none" stroke="var(--panel-border)" stroke-width="1.2" />
      <text x="508" y="644" font-family="var(--font-mono)" font-size="11" fill="var(--text-faint)">AWS ca-central</text>
      <a class="svg-node" data-node={cloudHost?.id} href={cloudHost && src(cloudHost)}>
        <title>cloud-01, côté matériel</title>
        <rect x="508" y="660" width="194" height="34" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
        <text x="605" y="681" text-anchor="middle" font-family="var(--font-mono)" font-size="10.5" fill="var(--text)">{cloudHost?.label ?? "cloud-01"} (EC2)</text>
      </a>
      <g class="svg-node" data-nodes={lambdaIds}>
        <title>les fonctions Lambda</title>
        <text x="508" y="726" font-family="var(--font-mono)" font-size="10.5" fill="var(--text)">λ {lambdaCount} fonctions Lambda</text>
      </g>
      <g class="svg-node" data-nodes={bucketIds}>
        <title>les buckets S3</title>
        <text x="508" y="748" font-family="var(--font-mono)" font-size="10.5" fill="var(--text)">s3 {bucketCount} buckets</text>
      </g>
      <text x="508" y="770" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">sauvegardes · pipelines ·</text>
      <text x="508" y="784" font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">le blog lui-même</text>

      <!-- ============ le reste du parc ============
           Ce que le parc contient et qu'aucun repo ne déclare. Pointillés
           comme les autres boîtes hors IaC, mais sans nœud de topologie :
           il n'y a rien à allumer ni de source à ouvrir — c'est justement
           ce que la bande raconte. (Décoratif : aucune donnée topologique,
           donc ni data-node ni data-nodes.) -->
      {fleetExtras.length > 0 && (
        <g>
          <path d={`M250,${SITE_BOTTOM} L250,${F_TOP}`} fill="none" stroke="var(--text-faint)" stroke-width="1.2" stroke-dasharray="2 3" />
          <rect x="40" y={F_TOP} width="680" height={fleetBottom - F_TOP} rx="8" fill="none" stroke="var(--panel-border)" stroke-width="1.2" stroke-dasharray="4 3" />
          <text x="58" y={F_TOP + 26} font-family="var(--font-mono)" font-size="11" fill="var(--text-faint)">le reste du parc — {fleetUnits} appareils, zéro nœud déclaré</text>
          <text x="58" y={F_TOP + 43} font-family="var(--font-mono)" font-size="9.5" fill="var(--text-faint)">{fleetSubtitle}</text>
          {fleetBands.map((band) => (
            <g>
              <text x="58" y={band.items[0].y - 6} font-family="var(--font-mono)" font-size="10" fill="var(--text-faint)">{band.label} — {band.items.length}</text>
              {band.items.map(({ d, x, y }) => (
                <g>
                  <title>{d.name} — {d.role ?? d.class}</title>
                  <rect x={x} y={y} width={F_CHIP_W} height={F_CHIP_H} rx="4" fill="none" stroke="var(--text-faint)" stroke-dasharray="4 3" />
                  <text x={x + F_CHIP_W / 2} y={y + 13} text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-faint)">{d.count && d.count > 1 ? `${d.name} ×${d.count}` : d.name}</text>
                  <text x={x + F_CHIP_W / 2} y={y + 24} text-anchor="middle" font-family="var(--font-mono)" font-size="7.5" fill="var(--text-faint)">{CLASS_FR[d.class] ?? d.class}</text>
                </g>
              ))}
            </g>
          ))}
          {fleetNotes.map((note, i) => (
            <text x="58" y={fleetBottom + 18 + i * 14} font-family="var(--font-mono)" font-size="9" fill="var(--accent-live)">{note}</text>
          ))}
        </g>
      )}
    </svg>
  </div>
  <figcaption>
    La forme du système — générée des mêmes données que l'inventaire
    ci-dessous. Une boîte allume le chemin qu'elle emprunte : d'un nom public
    jusqu'à la machine qui le sert, et dans l'autre sens si tu pars d'une
    machine. Un deuxième clic ouvre son fichier source.
    {fleetExtras.length > 0 &&
      " La bande du bas, elle, ne clique pas : c'est le reste du parc, qui " +
        "existe, qui " +
        pluggedClause +
        (offDuty ? `${offDuty} et ` : ", et ") +
        (orphans.length
          ? `que l'inventaire croit ${
              oneOrphan ? "déjà déclaré" : "déjà déclarés"
            }, alors que la topologie publique ne ${
              oneOrphan ? "lui connaît" : "leur connaît"
            } aucun nœud — le nom, lui, se lit peut-être ailleurs dans un repo.`
          : "que nul repo public ne compte dans sa topologie.")}
  </figcaption>
</figure>

