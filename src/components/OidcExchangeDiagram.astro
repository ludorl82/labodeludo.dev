---
interface Props {
  context?: "article" | "architecture";
  lang?: "fr" | "en";
}

const { context = "article", lang = "fr" } = Astro.props;

const copy = {
  fr: {
    ariaLabel:
      "Diagramme de séquence : un job GitHub Actions demande un jeton d'identité à l'émetteur OIDC de GitHub, qui répond avec un JWT signé décrivant le dépôt et la branche ; le job présente ce JWT à AWS STS via AssumeRoleWithWebIdentity ; STS vérifie la signature avec les clés publiques de GitHub et compare les claims à la politique de confiance du rôle, puis retourne des identifiants temporaires qui meurent avec le job. Aucun secret n'est stocké nulle part.",
    job: "job GitHub Actions",
    jobSub: "runner jetable",
    idp: "émetteur OIDC GitHub",
    idpSub: "token.actions.githubusercontent.com",
    sts: "AWS STS / IAM",
    stsSub: "rôle + politique de confiance",
    s1: "1 · demande de jeton (id-token: write)",
    s2: "2 · JWT signé — sub = repo:…:master · aud = sts · ttl 5 min",
    s3: "3 · AssumeRoleWithWebIdentity (JWT + nom du rôle)",
    check1: "vérifie la signature (clés publiques de GitHub)",
    check2: "compare sub/aud à la politique de confiance",
    s4: "4 · identifiants temporaires ≈ 1 h — meurent avec le job",
    note: "aucun secret stocké — le seul artefact permanent est la relation de confiance à clé publique",
  },
  en: {
    ariaLabel:
      "Sequence diagram: a GitHub Actions job requests an identity token from GitHub's OIDC issuer, which answers with a signed JWT describing the repo and branch; the job presents that JWT to AWS STS via AssumeRoleWithWebIdentity; STS verifies the signature with GitHub's public keys and matches the claims against the role's trust policy, then returns temporary credentials that die with the job. No secret is stored anywhere.",
    job: "GitHub Actions job",
    jobSub: "disposable runner",
    idp: "GitHub OIDC issuer",
    idpSub: "token.actions.githubusercontent.com",
    sts: "AWS STS / IAM",
    stsSub: "role + trust policy",
    s1: "1 · token request (id-token: write)",
    s2: "2 · signed JWT — sub = repo:…:master · aud = sts · ttl 5 min",
    s3: "3 · AssumeRoleWithWebIdentity (JWT + role name)",
    check1: "verifies the signature (GitHub's public keys)",
    check2: "matches sub/aud against the trust policy",
    s4: "4 · temporary credentials ≈ 1 h — they die with the job",
    note: "no stored secret — the only permanent artifact is the public-key trust relationship",
  },
} as const;

const t = copy[lang];
---

<figure class:list={["oidc-diagram", context]}>
  <div class="diagram-wrap">
    <svg viewBox="0 0 700 350" role="img" aria-label={t.ariaLabel}>
      <defs>
        <marker id="oe-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--text-faint)" />
        </marker>
        <marker id="oe-arrow-live" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" fill="var(--accent-live)" />
        </marker>
      </defs>

      <!-- actors -->
      <rect x="20" y="20" width="190" height="48" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="115" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" fill="var(--text)">{t.job}</text>
      <text x="115" y="57" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-faint)">{t.jobSub}</text>

      <rect x="255" y="20" width="190" height="48" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="350" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" fill="var(--text)">{t.idp}</text>
      <text x="350" y="57" text-anchor="middle" font-family="var(--font-mono)" font-size="7.5" fill="var(--text-faint)">{t.idpSub}</text>

      <rect x="490" y="20" width="190" height="48" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="585" y="40" text-anchor="middle" font-family="var(--font-mono)" font-size="11.5" fill="var(--text)">{t.sts}</text>
      <text x="585" y="57" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-faint)">{t.stsSub}</text>

      <!-- lifelines -->
      <line x1="115" y1="68" x2="115" y2="310" stroke="var(--panel-border)" stroke-dasharray="3 4" />
      <line x1="350" y1="68" x2="350" y2="160" stroke="var(--panel-border)" stroke-dasharray="3 4" />
      <line x1="585" y1="68" x2="585" y2="310" stroke="var(--panel-border)" stroke-dasharray="3 4" />

      <!-- 1: job -> idp -->
      <line x1="115" y1="100" x2="345" y2="100" stroke="var(--text-faint)" marker-end="url(#oe-arrow)" />
      <text x="230" y="92" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-muted)">{t.s1}</text>

      <!-- 2: idp -> job -->
      <line x1="350" y1="140" x2="120" y2="140" stroke="var(--text-faint)" marker-end="url(#oe-arrow)" />
      <text x="235" y="132" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-muted)">{t.s2}</text>

      <!-- 3: job -> sts -->
      <line x1="115" y1="185" x2="580" y2="185" stroke="var(--text-faint)" marker-end="url(#oe-arrow)" />
      <text x="348" y="177" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-muted)">{t.s3}</text>

      <!-- STS checks -->
      <rect x="440" y="200" width="250" height="48" rx="4" fill="var(--panel)" stroke="var(--panel-border)" />
      <text x="565" y="220" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-muted)">{t.check1}</text>
      <text x="565" y="237" text-anchor="middle" font-family="var(--font-mono)" font-size="8.5" fill="var(--text-muted)">{t.check2}</text>

      <!-- 4: sts -> job -->
      <line x1="585" y1="278" x2="120" y2="278" stroke="var(--accent-live)" marker-end="url(#oe-arrow-live)" />
      <text x="350" y="270" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--accent-live)">{t.s4}</text>

      <!-- bottom note -->
      <text x="350" y="335" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">{t.note}</text>
    </svg>
  </div>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .oidc-diagram {
    margin: 2rem 0;
  }
  .diagram-wrap {
    overflow-x: auto;
  }
  .diagram-wrap svg {
    display: block;
    width: 100%;
    min-width: 34rem;
    height: auto;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--text-faint);
  }
  .oidc-diagram.architecture {
    margin: 1rem 0;
  }
</style>
