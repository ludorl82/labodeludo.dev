  .racks {
    margin: 2rem 0 3rem;
  }
  .diagram-wrap {
    overflow-x: auto;
  }
  .diagram-wrap svg {
    display: block;
    min-width: 700px;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin-inline: auto;
  }
  .sig {
    display: block;
    margin-top: 0.35rem;
    color: var(--text-muted);
  }
  figcaption {
    color: var(--text-faint);
    font-size: 0.8rem;
    max-width: 70ch;
    margin: 0.6rem auto 0;
  }
</style>
