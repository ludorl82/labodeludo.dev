---
// The two racks, drawn from the fleet seed — not from a hand-kept picture.
//
// AUTOMATED-AUTHOR CONTRACT: refreshed by the nightly diagram job (prompt:
// scripts/topology/prompts/rack-diagram.md) from src/data/fleet.json, which
// itself comes from a private document a sibling session reconciles every
// night. Every box, label and count is read from that file: nothing about
// the racks is written by hand, which is the point — the SVG this replaced
// had drifted to showing a machine that no longer existed.
//
// Two rules the data imposes, and the drawing must not break:
//   * `rackOrder` is a STACKING order, not a U position. The source records
//     no U positions, so rows are evenly spaced and no U scale is drawn.
//     The rack's TOTAL height (racks[].units) is known and may be labelled.
//   * A VM or BMC is INSIDE a machine, not beside it: `hostedBy` nests it
//     as a chip in its host's row rather than giving it a shelf of its own.
//
// Palette: this site is monochrome on purpose, so "colour by network" means
// the existing grayscale accents, not new hues.
import fleet from "../data/fleet.json";

type Device = {
  name: string;
  class: string;
  network?: string;
  role?: string;
  spec?: string;
  model?: string;
  iacDeclared?: boolean;
  location?: string;
  rackOrder?: number;
  power?: string;
  hostedBy?: string;
  count?: number;
};
type Rack = { units?: number; kind?: string };

const devices = (fleet.devices ?? []) as Device[];
const racks = ((fleet as any).racks ?? {}) as Record<string, Rack>;

const inRack = (loc: string) =>
  devices
    .filter((d) => d.location === loc && typeof d.rackOrder === "number")
    .sort((a, b) => (a.rackOrder ?? 99) - (b.rackOrder ?? 99));

const hostedOn = (name: string) =>
  devices.filter((d) => d.hostedBy === name);

// hosted gear whose host is not itself a row (or that names no host) still
// has to be accounted for, or the drawing would quietly lose it
const orphanHosted = (loc: string, rows: Device[]) =>
  devices.filter(
    (d) =>
      d.location === loc &&
      typeof d.rackOrder !== "number" &&
      !(d.hostedBy && rows.some((r) => r.name === d.hostedBy)),
  );

const NETWORK_TONE: Record<string, string> = {
  vlan10: "var(--accent-devops)",
  vlan50: "var(--accent-maison)",
  "out-of-band": "var(--accent-labo)",
  aws: "var(--accent-cloud)",
};
const tone = (d: Device) => NETWORK_TONE[d.network ?? ""] ?? "var(--accent-default)";

const NETWORK_LABEL: Record<string, string> = {
  vlan10: "VLAN serveurs",
  vlan50: "VLAN maison",
  "out-of-band": "hors réseau",
  aws: "hors site",
};

const RACKS = [
  { key: "wall-rack", x: 20, title: "baie murale — sous-sol" },
  { key: "rolling-rack", x: 390, title: "baie roulante — bureau" },
];

const ROW_H = 38;
const ROW_GAP = 5;
const CHIP_H = 14;
const HEAD = 74;
const RAIL = 9;

const rowsFor = (key: string) => inRack(key);
const rowHeight = (d: Device) =>
  ROW_H + (hostedOn(d.name).length > 0 ? CHIP_H + 3 : 0);
const rackHeight = (key: string) => {
  const rows = rowsFor(key);
  const orphans = orphanHosted(key, rows).length;
  return (
    HEAD +
    rows.reduce((h, d) => h + rowHeight(d) + ROW_GAP, 0) +
    (orphans > 0 ? 18 : 0) +
    14
  );
};
const height = Math.max(...RACKS.map((r) => rackHeight(r.key)), 120) + 34;

const hasRacks = RACKS.some((r) => rowsFor(r.key).length > 0);
const label = (d: Device) =>
  d.count && d.count > 1 ? `${d.name} ×${d.count}` : d.name;

// networks actually present, so the legend never invents an entry
const shownNetworks = [
  ...new Set(
    RACKS.flatMap((r) => rowsFor(r.key)).map((d) => d.network ?? ""),
  ),
].filter((n) => n in NETWORK_LABEL);

const ariaLabel = hasRacks
  ? RACKS.map((r) => {
      const rows = rowsFor(r.key);
      const u = racks[r.key]?.units;
      return (
        `${r.title} : ${rows.length} équipements${u ? `, châssis de ${u}U` : ""}. ` +
        rows
          .map(
            (d) =>
              `${label(d)}, ${d.model ?? d.spec ?? d.class}` +
              (d.role ? `, ${d.role}` : "") +
              (hostedOn(d.name).length
                ? `, héberge ${hostedOn(d.name).map((h) => h.name).join(", ")}`
                : ""),
          )
          .join(". ")
      );
    }).join(" ") +
    " L'ordre est celui de l'inventaire, pas une position en U."
  : "Élévation des baies — l'inventaire matériel n'a pas encore été généré.";
---

{
  hasRacks && (
    <figure class="racks">
      <div class="diagram-wrap">
        <svg viewBox={`0 0 760 ${height}`} role="img" aria-label={ariaLabel}>
          {RACKS.map(({ key, x, title }) => {
            const rows = rowsFor(key);
            const meta = racks[key] ?? {};
            const orphans = orphanHosted(key, rows);
            let y = HEAD;
            return (
              <Fragment>
                {/* the enclosure: frame + two mounting rails. The rails are
                    plain strips on purpose — notches would read as U marks,
                    and the data does not know U positions. */}
                <rect x={x} y="20" width="350" height={rackHeight(key)} rx="4"
                      fill="none" stroke="var(--panel-border)" stroke-width="1.5" />
                <rect x={x + 8} y={HEAD - 8} width={RAIL} height={rackHeight(key) - HEAD - 4}
                      fill="var(--panel)" stroke="var(--panel-border)" stroke-width="0.75" />
                <rect x={x + 350 - 8 - RAIL} y={HEAD - 8} width={RAIL} height={rackHeight(key) - HEAD - 4}
                      fill="var(--panel)" stroke="var(--panel-border)" stroke-width="0.75" />

                <text x={x + 16} y="42" font-family="var(--font-mono)" font-size="11.5" fill="var(--text-muted)">
                  {title}
                </text>
                <text x={x + 16} y="58" font-family="var(--font-mono)" font-size="9" fill="var(--text-faint)">
                  {meta.units ? `châssis ${meta.units}U` : "châssis"}
                  {meta.kind ? ` · ${meta.kind}` : ""} · {rows.length} équipements
                </text>

                {rows.map((d) => {
                  const hosted = hostedOn(d.name);
                  const top = y;
                  y += rowHeight(d) + ROW_GAP;
                  return (
                    <Fragment>
                      <rect x={x + 8 + RAIL + 4} y={top} width={350 - 2 * (8 + RAIL) - 8}
                            height={rowHeight(d)} rx="3" fill="var(--panel)"
                            stroke="var(--panel-border)"
                            stroke-dasharray={d.iacDeclared ? undefined : "4 3"} />
                      {/* network tone: a bar, not a fill — readable without
                          asking the reader to decode a background shade */}
                      <rect x={x + 8 + RAIL + 4} y={top} width="3" height={rowHeight(d)} fill={tone(d)} />
                      <text x={x + 8 + RAIL + 14} y={top + 15} font-family="var(--font-mono)" font-size="10.5" fill="var(--text)">
                        {label(d)}
                      </text>
                      <text x={x + 350 - 8 - RAIL - 8} y={top + 15} text-anchor="end"
                            font-family="var(--font-mono)" font-size="8.5" fill="var(--text-muted)">
                        {d.model ?? d.spec ?? d.class}
                      </text>
                      {(d.role || d.spec || d.power) && (
                        <text x={x + 8 + RAIL + 14} y={top + 27} font-family="var(--font-mono)" font-size="8" fill="var(--text-faint)">
                          {[
                            d.role,
                            d.model && d.spec ? d.spec : null,
                            d.power,
                          ]
                            .filter(Boolean)
                            .join(" · ")
                            .slice(0, 62)}
                        </text>
                      )}
                      {hosted.map((h, hi) => (
                        <Fragment>
                          <rect x={x + 8 + RAIL + 14 + hi * 74} y={top + ROW_H - 5}
                                width="70" height={CHIP_H} rx="2" fill="none"
                                stroke="var(--panel-border)" stroke-dasharray="2 2" />
                          <text x={x + 8 + RAIL + 18 + hi * 74} y={top + ROW_H + 5}
                                font-family="var(--font-mono)" font-size="7.5" fill="var(--text-faint)">
                            {h.name.length > 11 ? h.name.slice(0, 10) + "…" : h.name}
                          </text>
                        </Fragment>
                      ))}
                    </Fragment>
                  );
                })}

                {orphans.length > 0 && (
                  <text x={x + 16} y={y + 8} font-family="var(--font-mono)" font-size="8" fill="var(--text-faint)">
                    + {orphans.length} hébergés sans hôte nommé
                  </text>
                )}
              </Fragment>
            );
          })}

          {/* legend, built from the networks actually drawn */}
          {shownNetworks.map((n, i) => (
            <Fragment>
              <rect x={20 + i * 150} y={height - 20} width="3" height="10" fill={NETWORK_TONE[n]} />
              <text x={28 + i * 150} y={height - 11} font-family="var(--font-mono)" font-size="8.5" fill="var(--text-faint)">
                {NETWORK_LABEL[n]}
              </text>
            </Fragment>
          ))}
        </svg>
      </div>
      <figcaption>
        Les deux baies, relevées chaque nuit dans l'inventaire du matériel.
        Trait plein pour ce que les dépôts déclarent, pointillé pour le
        reste — le matériel que personne n'a jamais écrit nulle part. La
        barre de gauche donne le réseau, les puces en pointillé sont les
        machines virtuelles et les contrôleurs qui vivent <em>dans</em> la
        machine au-dessus d'elles, et le modèle réel est écrit à droite de
        chaque rangée. Le châssis est à sa vraie hauteur, mais
        les rangées sont dans l'ordre de l'inventaire et pas à leur position
        en U : le document source ne note pas les U, alors je ne fais pas
        semblant de les connaître.
        <span class="sig">— Bob, qui redessine</span>
      </figcaption>
    </figure>
  )
}

<style>
  .racks {
    margin: 2rem 0 3rem;
  }
  .diagram-wrap {
    overflow-x: auto;
  }
  .diagram-wrap svg {
    display: block;
    min-width: 700px;
    width: 100%;
    max-width: 900px;
    height: auto;
    margin-inline: auto;
  }
  .sig {
    display: block;
    margin-top: 0.35rem;
    color: var(--text-muted);
  }
  figcaption {
    color: var(--text-faint);
    font-size: 0.8rem;
    max-width: 70ch;
    margin: 0.6rem auto 0;
  }
</style>
