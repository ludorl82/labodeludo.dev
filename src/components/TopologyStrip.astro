---
import { primaryCategory, categoryColorVar } from "../lib/category";

interface Props {
  posts: { id: string; data: { title: string; tags: string[] } }[];
  basePath?: string;
}

const { posts, basePath = "/blog" } = Astro.props;

// The lit port is the newest article — Bob claims credit for plugging it in.
const litTitle = (title: string) =>
  `Le dernier branché : « ${title} ». C'est moi qui l'ai câblé, évidemment.`;
---

<nav class="strip" aria-label={`${posts.length} articles publiés, chacun représenté par un port coloré selon sa catégorie`}>
  {
    posts.map((post, i) => {
      const color = categoryColorVar(primaryCategory(post.data.tags));
      const lit = i === 0;
      return (
        <a
          class="port"
          class:list={[{ lit }]}
          style={`--port-color: var(${color})`}
          href={`${basePath}/${post.id}/`}
          title={lit ? litTitle(post.data.title) : post.data.title}
          aria-label={post.data.title}
        />
      );
    })
  }
</nav>

<style>
  .strip {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 1.25rem 0;
  }

  .port {
    display: block;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--port-color);
    opacity: 0.45;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .port:hover,
  .port:focus-visible {
    opacity: 1;
    transform: scale(1.4);
    outline: none;
    box-shadow: 0 0 6px 1px var(--port-color);
  }

  .port.lit {
    opacity: 1;
    box-shadow: 0 0 8px 1px var(--port-color);
  }

  @media (prefers-reduced-motion: no-preference) {
    .port.lit {
      animation: pulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 8px 1px var(--port-color);
    }
    50% {
      box-shadow: 0 0 3px 0px var(--port-color);
    }
  }
</style>
