---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchGenerated from "../components/ArchGenerated.astro";

// This page is ONE drawing, authored every night by a headless Claude Code
// session from seeds it may read (the four public IaC snapshots, and the
// sanitized fleet list) — never by hand. The hand-drawn overview that used
// to live here is gone: a drawing maintained by discipline is wrong the
// moment something changes, and that was the whole point of the exercise.
//
// Still gated: the generated view renders only when the build sets
// SHOW_LIVE_ARCH=1 (staging + the nightly job). Prod gets the honest note
// below until the flag flips in deploy.yml — one line, whenever.
const showLiveArch = process.env.SHOW_LIVE_ARCH === "1";
---

<BaseLayout
  title="Architecture — Le labo de Ludo"
  description="La forme du labo, redessinée chaque nuit à partir des dépôts IaC publics et de l'inventaire matériel — pas à la main."
>
  <a class="back" href="/">&larr; tous les articles</a>

  <header class="page-header">
    <h1>Architecture</h1>
    <p class="subtitle">
      Un seul schéma, redessiné chaque nuit à partir de ce que les dépôts
      déclarent et de l'inventaire du matériel — jamais à la main. Noms et
      adresses fictifs (préfixe de documentation
      <code>2001:db8:.../64</code>, RFC 3849). Ce que chaque morceau
      <em>fait</em>, et ce que j'ai écrit dessus, vit dans
      <a href="/inventaire/">l'inventaire</a>.
    </p>
  </header>

  {
    showLiveArch ? (
      <ArchGenerated />
    ) : (
      <p class="pending">
        Le schéma généré n'est pas encore publié ici — il tourne chaque nuit
        et se regarde en préversion le temps que je lui fasse confiance.
        D'ici là, <a href="/inventaire/">l'inventaire</a> décrit chaque rôle
        du réseau et pointe vers les articles qui en parlent.
      </p>
    )
  }
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-live);
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .subtitle {
    color: var(--text-muted);
    max-width: var(--measure);
    margin: 0 0 2.5rem;
  }

  .pending {
    color: var(--text-muted);
    max-width: var(--measure);
    border-left: 2px solid var(--panel-border);
    padding-left: 1rem;
  }
</style>
