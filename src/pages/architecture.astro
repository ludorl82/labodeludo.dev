---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArchGenerated from "../components/ArchGenerated.astro";
import AuthorBadge from "../components/AuthorBadge.astro";
import FrigateDetectorDiagram from "../components/FrigateDetectorDiagram.astro";
import CloudflareTunnelDiagram from "../components/CloudflareTunnelDiagram.astro";
import WebdavProxyDiagram from "../components/WebdavProxyDiagram.astro";
import WireGuardFtpDiagram from "../components/WireGuardFtpDiagram.astro";
import VoiceAssistantDiagram from "../components/VoiceAssistantDiagram.astro";
import ConsoleLayersDiagram from "../components/ConsoleLayersDiagram.astro";
import BastionConsoleSplitDiagram from "../components/BastionConsoleSplitDiagram.astro";
import K3sClusterDiagram from "../components/K3sClusterDiagram.astro";
import NfsShareMoveDiagram from "../components/NfsShareMoveDiagram.astro";
import SurvivorIslandDiagram from "../components/SurvivorIslandDiagram.astro";
import ScanPipelineDiagram from "../components/ScanPipelineDiagram.astro";

// Two halves, on purpose. The top is ONE drawing, authored every night by
// a headless Claude Code session from seeds it may read (the four public
// IaC snapshots and the sanitized fleet list) — never by hand; the
// hand-drawn OVERVIEW that used to live here is gone, because a whole-lab
// drawing maintained by discipline is wrong the moment anything changes.
//
// The bottom is the opposite case and that is why it survives: each of
// these eleven diagrams explains one MECHANISM, was drawn for its article,
// and describes a decision rather than an inventory. Nothing generated can
// replace them, and they do not rot when a host is renamed.
//
// Public since 2026-08-08 (SHOW_LIVE_ARCH=1 in deploy.yml's prod job); the
// flag stays as the one-line off switch, and the fallback note below is
// what a build without it still shows.
//
// VOICE: this page is BOB's — he redraws it nightly and signs it. Ludo's
// voice stays on /inventaire, where the roles are hand-written. Do not
// blend the two (see the site's two-voice rule).
const showLiveArch = process.env.SHOW_LIVE_ARCH === "1";

// ORDER: newest article first, DERIVED — never hand-arranged. These
// sections used to sit in the order their blocks happened to be appended
// over the months, which read as random (Frigate 07-09 ahead of the tunnel
// 07-03, the scan pipeline 08-05 landing mid-list). Everything else on this
// page comes from data; this list now does too, so it cannot drift out of
// order when a diagram is added.
//
// `slug` is the article the diagram was drawn for — the same one its
// architecture-context figcaption links to (enforced by
// scripts/check-diagram-links.mjs), and the source of the sort key.
const DETAILS = [
  { slug: "mon-encodeur-faisait-du-bruit-le-detecteur-video-tournait-sur-le-cpu-au-lieu-du-gpu",
    title: "détection vidéo (Frigate)", Component: FrigateDetectorDiagram },
  { slug: "retirer-pare-feu-tunnel-cloudflare",
    title: "accès public (tunnel Cloudflare)", Component: CloudflareTunnelDiagram },
  { slug: "le-move-qui-echouait-une-histoire-de-proxy-de-schema-http-et-dun-coffre-fort-presque-corrompu",
    title: "requête WebDAV (proxy et en-tête Destination)", Component: WebdavProxyDiagram },
  { slug: "ftp-prive-wireguard",
    title: "accès privé (tunnel WireGuard)", Component: WireGuardFtpDiagram },
  { slug: "tout-ca-pour-un-script-bash",
    title: "pipeline de numérisation (SFTP → S3 → Lambda → Drive)", Component: ScanPipelineDiagram },
  { slug: "ce-que-peut-faire-un-llm-local-sur-une-carte-a-300-mon-assistant-vocal-maison-avec-qwen3",
    title: "assistant vocal (Home Assistant + Ollama)", Component: VoiceAssistantDiagram },
  { slug: "compartimentalisation-des-outils-de-console",
    title: "console conteneurisée (bastion)", Component: ConsoleLayersDiagram },
  { slug: "separer-le-bastion-de-la-console",
    title: "la séparation bastion / console", Component: BastionConsoleSplitDiagram },
  { slug: "deployer-un-cluster-k3s-avec-claude-code",
    title: "grappe conteneurs (k3s)", Component: K3sClusterDiagram },
  { slug: "deplacer-mes-partages-nfs-sur-un-ssd-sans-toucher-a-kubernetes",
    title: "stockage NFS de la grappe (chemin d'export)", Component: NfsShareMoveDiagram },
  { slug: "l-ile-du-survivant",
    title: "l'île du survivant (reprise après panne électrique)", Component: SurvivorIslandDiagram },
];

// Fail LOUD on an unknown slug. Sorting on a missing date would quietly
// park that diagram at one end of the page and look deliberate — exactly
// the silent wrongness this page exists to stop.
const posts = await getCollection("blog");
const dateOf = new Map(posts.map((p) => [p.id, +p.data.pubDate]));
const unknown = DETAILS.filter((d) => !dateOf.has(d.slug)).map((d) => d.slug);
if (unknown.length) {
  throw new Error(
    `architecture.astro: DETAILS references unknown article(s): ${unknown.join(", ")}`,
  );
}
const details = [...DETAILS].sort(
  (a, b) => dateOf.get(b.slug)! - dateOf.get(a.slug)!,
);
---

<BaseLayout
  title="Architecture — Le labo de Ludo"
  description="La forme du labo, redessinée chaque nuit à partir des dépôts IaC publics et de l'inventaire matériel — pas à la main."
>
  <a class="back" href="/">&larr; tous les articles</a>

  <header class="page-header">
    <h1>Architecture</h1>
    <p class="byline">
      <AuthorBadge author="bob" /> redessine cette page chaque nuit —
      <a href="/auteurs/bob/">qui est Bob</a>
    </p>
    <p class="subtitle">
      Un seul schéma ici, et ce n'est pas Ludo qui le dessine : pendant
      qu'il dort, je relis les dépôts, je relis l'inventaire du matériel, et
      je recommence le dessin au complet. Un schéma tenu à la main, ça ment
      tranquillement pendant des semaines; celui-là ment une nuit au
      maximum, et il affiche l'heure de son dernier essai. Noms et adresses
      fictifs (préfixe de documentation <code>2001:db8:.../64</code>,
      RFC 3849). Ce que chaque morceau <em>fait</em>, et ce que Ludo a écrit
      dessus, vit dans <a href="/inventaire/">l'inventaire</a>.
    </p>
  </header>

  {
    showLiveArch ? (
      <ArchGenerated />
    ) : (
      <p class="pending">
        Le schéma n'est pas dans cette version du site — ce build-là a été
        fait sans lui. Il tourne quand même chaque nuit, promis. D'ici
        là, <a href="/inventaire/">l'inventaire</a> décrit chaque rôle du
        réseau et pointe vers les articles qui en parlent.
      </p>
    )
  }

  <section class="details">
    <h2># les pièces, en détail — celles que je ne redessine pas</h2>
    <p class="section-note">
      {details.length} schémas rapprochés, dessinés à la main pour leurs
      articles, et qui restent à la main. Chacun explique un <em>mécanisme</em> :
      une décision, un piège, une panne comprise trop tard. Ça, un inventaire
      ne le raconte pas — et ça ne vieillit pas non plus quand une machine
      change de nom. Classés du plus récent au plus ancien, selon la date de
      l'article : même l'ordre, je ne le décide pas à la main.
    </p>

    {
      details.map(({ title, Component }) => (
        <section class="detail">
          <h2>Détail : {title}</h2>
          <Component context="architecture" />
        </section>
      ))
    }
  </section>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-live);
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    margin: 0 0 0.75rem;
  }

  .byline a {
    color: var(--text-faint);
  }

  .subtitle {
    color: var(--text-muted);
    max-width: var(--measure);
    margin: 0 0 2.5rem;
  }

  .pending {
    color: var(--text-muted);
    max-width: var(--measure);
    border-left: 2px solid var(--panel-border);
    padding-left: 1rem;
  }

  .details {
    margin: 4rem 0 0;
    border-top: 1px solid var(--panel-border);
    padding-top: 2rem;
  }

  .details > h2 {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: normal;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .section-note {
    color: var(--text-faint);
    font-size: 0.85rem;
    max-width: var(--measure);
    margin: 0 0 1.5rem;
  }

  .detail {
    margin: 2.5rem 0;
  }

  .detail h2 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0 0 1rem;
  }
</style>
