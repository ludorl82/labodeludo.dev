---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LiveArchDiagram from "../../components/LiveArchDiagram.astro";
import arch from "../../data/architecture.json";

// Staging-only for now: the page is generated only when the build sets
// SHOW_LIVE_ARCH=1 (the staging deploy job and the nightly regeneration do;
// the prod deploy does not). A dynamic route with an empty getStaticPaths
// is Astro's way of not emitting the page at all — same file on every
// branch, no dev/main drift, and prod cannot re-grow it by accident.
export function getStaticPaths() {
  return process.env.SHOW_LIVE_ARCH === "1"
    ? [{ params: { live: "live" } }]
    : [];
}

// The generated architecture view. Everything on this page comes from
// src/data/architecture.json, produced by scripts/topology/join-topology.py
// out of the four PUBLIC sanitized IaC snapshots — never the private repos.
// A hand-drawn diagram is wrong the moment something changes; this one is
// only as stale as its generation date, shown below, honestly.

type TNode = {
  id: string;
  kind: string;
  label: string;
  layer: string;
  source: string;
  repo: string;
  meta: Record<string, any>;
};
const nodes = arch.nodes as TNode[];
const edges = arch.edges as { from: string; to: string; kind: string }[];

const byLayer = (layer: string, kinds?: string[]) =>
  nodes.filter(
    (n) => n.layer === layer && (!kinds || kinds.includes(n.kind)),
  );

const protectedDns = new Set(
  edges.filter((e) => e.kind === "protects").map((e) => e.to),
);
const pins = new Map(
  edges.filter((e) => e.kind === "pinned-to").map((e) => [e.from, e.to]),
);
const isEdges = new Map(
  edges.filter((e) => e.kind === "is").map((e) => [e.from, e.to]),
);

const dns = byLayer("edge", ["dns"]).sort((a, b) =>
  a.label.localeCompare(b.label),
);
const tunnel = byLayer("edge", ["tunnel"])[0];
const instance = byLayer("cloud", ["instance"])[0];
const lambdas = byLayer("cloud", ["lambda"]);
const buckets = byLayer("cloud", ["bucket"]);
const apps = byLayer("cluster", ["app"]).sort((a, b) =>
  a.label.localeCompare(b.label),
);
const workloadsByApp = new Map<string, TNode[]>();
for (const w of byLayer("cluster", ["workload"])) {
  const app = "app:" + w.id.slice("workload:".length).split("/")[0];
  workloadsByApp.set(app, [...(workloadsByApp.get(app) ?? []), w]);
}
const hosts = byLayer("hardware", ["host"]).sort((a, b) =>
  a.label.localeCompare(b.label),
);
const externals = byLayer("external", ["external"]).sort((a, b) =>
  a.label.localeCompare(b.label),
);

const src = (n: TNode) =>
  `https://github.com/ludorl82/${n.repo}/blob/HEAD/${n.source}`;
const short = (id: string) => id.slice(id.indexOf(":") + 1);
const generated = (arch.generated as string).replace("T", " ").slice(0, 16);

// the drift badge: the three nightly drift checks assert the private repos
// still match the real infrastructure, so the snapshots this page is built
// from are trustworthy exactly when they are green — and the page says so
// instead of pretending. "unknown" (fetch failed, or a build without the
// nightly pipeline) is shown as unverified, never as green.
type Verified = {
  status?: "ok" | "drift" | "unknown";
  checkedAt?: string | null;
  monitors?: { name: string; up: boolean }[];
};
const verified: Verified = (arch as any).verified ?? { status: "unknown" };
const vStatus = verified.status ?? "unknown";
const vDate = verified.checkedAt
  ? verified.checkedAt.replace("T", " ").slice(0, 16) + " UTC"
  : null;
const vDown = (verified.monitors ?? []).filter((m) => !m.up);

// the client-side highlighter only needs the edge list
const edgesLite = edges.map((e) => [e.from, e.to]);
---

<BaseLayout
  title="Architecture générée — Le labo de Ludo"
  description="La vraie architecture du labo, générée chaque nuit à partir des quatre dépôts IaC publics — pas dessinée à la main."
>
  <a class="back" href="/architecture">&larr; l'architecture dessinée</a>

  <header class="page-header">
    <h1>Architecture générée</h1>
    <p class="subtitle">
      Cette page n'est pas dessinée : elle est <strong>générée</strong> à
      partir des quatre dépôts IaC publics (
      <a href="https://github.com/ludorl82/cloudflare-iac-public">cloudflare</a
      >, <a href="https://github.com/ludorl82/aws-iac-public">aws</a>,
      <a href="https://github.com/ludorl82/k3s-iac-public">k3s</a>,
      <a href="https://github.com/ludorl82/nixos-iac-public">nixos</a>) — les
      mêmes fichiers sanitisés qui accompagnent les articles. Un diagramme
      dessiné ment dès qu'on change quelque chose; celui-ci n'est jamais plus
      vieux que sa date de génération. Noms et adresses fictifs, comme
      toujours. <strong>Tout est cliquable — le schéma comme
      l'inventaire.</strong> Cliquer une boîte allume ce qui en dépend, dans
      les deux à la fois : un nom public éclaire son chemin jusqu'au
      matériel, une machine éclaire ce qui tombe avec elle. Un deuxième clic
      ouvre le fichier qui la définit; Échap efface.
    </p>
  </header>

  <div class="status">
    <span class="stamp">générée {generated} UTC</span>
    {
      vStatus === "ok" ? (
        <span class="drift ok" title={`drift checks verts, ${vDate}`}>
          ✓ conforme à l'infra réelle — {vDate}
        </span>
      ) : vStatus === "drift" ? (
        <span
          class="drift bad"
          title={vDown.map((m) => m.name).join(", ") || "dérive détectée"}
        >
          ✗ dérive détectée — ce diagramme peut être en retard
        </span>
      ) : (
        <span class="drift unk">vérification indisponible — non vérifié</span>
      )
    }
    {
      Object.entries(arch.sources as Record<string, any>).map(([repo, s]) => (
        <a
          class="commit"
          href={`https://github.com/ludorl82/${repo}/commit/${s.commit}`}
        >
          {repo.replace("-iac-public", "")}@{s.commit}
        </a>
      ))
    }
  </div>

  <LiveArchDiagram />

  <section class="band" data-layer="edge">
    <h2># edge — Cloudflare</h2>
    <div class="row">
      {
        dns.map((n) => (
          <a
            class="node dns"
            data-node={n.id}
            href={src(n)}
            title={n.meta.origin ?? ""}
          >
            {n.label}
            {protectedDns.has(n.id) && <span class="tag">access</span>}
          </a>
        ))
      }
    </div>
    <div class="row">
      <a class="node hub" data-node={tunnel.id} href={src(tunnel)}>
        tunnel «{tunnel.label}» ── connecteurs dans le cluster
      </a>
    </div>
  </section>

  <section class="band" data-layer="cloud">
    <h2># cloud — AWS</h2>
    <div class="row">
      <a class="node" data-node={instance.id} href={src(instance)}>
        EC2 {instance.meta.instanceType}
        {isEdges.has(instance.id) && (
          <span class="dim">= {short(isEdges.get(instance.id)!)}</span>
        )}
      </a>
      {
        lambdas.map((n) => (
          <a class="node" data-node={n.id} href={src(n)}>
            λ {n.label}
          </a>
        ))
      }
    </div>
    <div class="row">
      {
        buckets.map((n) => (
          <a class="node chip" data-node={n.id} href={src(n)}>
            s3://{n.label}
          </a>
        ))
      }
    </div>
  </section>

  <section class="band" data-layer="cluster">
    <h2># cluster — k3s</h2>
    <div class="row">
      {
        apps.map((a) => (
          <div class="node app" data-node={a.id}>
            <a class="app-name" href={src(a)}>
              {a.label}
            </a>
            <div class="workloads">
              {(workloadsByApp.get(a.id) ?? []).map((w) => (
                <a
                  class="node wl"
                  data-node={w.id}
                  href={src(w)}
                  title={w.meta.kind}
                >
                  {w.label}
                  {pins.has(w.id) && (
                    <span class="dim">→{short(pins.get(w.id)!)}</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band" data-layer="hardware">
    <h2># matériel — NixOS</h2>
    <div class="row">
      {
        hosts.map((n) => (
          <a class="node host" data-node={n.id} href={src(n)}>
            <strong>{n.label}</strong>
            <span class="dim">
              {n.meta.class} · {String(n.meta.arch).replace("-linux", "")}
              {n.meta.k3sRole ? ` · k3s ${n.meta.k3sRole}` : ""}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  {
    externals.length > 0 && (
      <section class="band" data-layer="external">
        <h2># hors IaC — vu depuis ses bords</h2>
        <div class="row">
          {externals.map((n) => (
            <a class="node ext" data-node={n.id} href={src(n)} title={n.meta.via ?? n.meta.origin ?? ""}>
              {n.label}
              <span class="dim">
                {n.meta.origin ? "origine du tunnel" : n.meta.via}
              </span>
            </a>
          ))}
        </div>
        <p class="band-note">
          Rien ici n'est déclaré dans un dépôt IaC — ces boîtes n'existent
          que parce que l'IaC les <em>référence</em> (une origine de tunnel,
          des volumes NFS, un module UPS). Le matériel que rien de
          déclaratif ne touche — la switch, l'AP, les BMC — est absent par
          construction : la frontière visible fait partie du portrait.
        </p>
      </section>
    )
  }

  <p class="footnote">
    Régénérée chaque nuit par un pipeline qui ne lit <em>que</em> les dépôts
    publics — les sanitizers (et leurs vérifications qui refusent de publier
    au moindre doute) restent la seule frontière de confiance. Le badge
    ci-haut vient des trois vérifications de dérive nocturnes qui comparent
    les dépôts privés à l'infrastructure réelle : ce diagramme est fiable
    <em>exactement quand elles sont vertes</em>, et il l'admet quand elles ne
    le sont pas — « live » veut dire « régénéré chaque nuit, dernière
    vérification affichée », pas temps réel.
  </p>

  <script type="application/json" id="topo-edges" set:html={JSON.stringify(edgesLite)} />
  <script>
    // Click a node: light up its neighborhood. Hub-like nodes (the tunnel,
    // the cluster, the machines) LIGHT UP but never propagate — otherwise
    // any click reaches the whole page through them. Clicking a hub itself
    // still expands one level, which is exactly the blast-radius question.
    const edges = JSON.parse(
      document.getElementById("topo-edges")!.textContent!,
    ) as [string, string][];
    const TERMINAL = new Set(["tunnel", "host", "cluster", "external"]);
    const ns = (id: string) => id.slice(0, id.indexOf(":"));
    const adj = new Map<string, string[]>();
    for (const [a, b] of edges) {
      adj.set(a, [...(adj.get(a) ?? []), b]);
      adj.set(b, [...(adj.get(b) ?? []), a]);
    }
    const els = document.querySelectorAll<HTMLElement>(
      "[data-node], [data-nodes]",
    );
    function idsOf(el: HTMLElement): string[] {
      return el.dataset.node
        ? [el.dataset.node]
        : (el.dataset.nodes ?? "").split(" ").filter(Boolean);
    }
    let active: string | null = null;
    function apply(sel: Set<string> | null) {
      els.forEach((el) => {
        const mine = idsOf(el);
        const hit = !!sel && mine.some((id) => sel.has(id));
        el.classList.toggle("lit", hit);
        el.classList.toggle("dimmed", !!sel && !hit);
      });
    }
    function reach(start: string) {
      const seen = new Set([start]);
      const q = [start];
      while (q.length) {
        const cur = q.shift()!;
        if (cur !== start && TERMINAL.has(ns(cur))) continue;
        for (const n of adj.get(cur) ?? []) {
          if (!seen.has(n)) {
            seen.add(n);
            q.push(n);
          }
        }
      }
      return seen;
    }
    els.forEach((el) => {
      el.addEventListener("click", (ev) => {
        // single node: light its neighborhood (first click selects,
        // second follows the link). Aggregate (data-nodes): light exactly
        // its members — no traversal, no link.
        const key = el.dataset.node ?? el.dataset.nodes!;
        if (active !== key) {
          ev.preventDefault();
          active = key;
          apply(
            el.dataset.node
              ? reach(el.dataset.node)
              : new Set(idsOf(el)),
          );
        } else if (!el.dataset.node) {
          ev.preventDefault();
        }
      });
    });
    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape") {
        active = null;
        apply(null);
      }
    });
  </script>
</BaseLayout>

<style>
  .back {
    color: var(--text-muted);
    text-decoration: none;
  }
  .page-header {
    margin: 1.5rem 0;
  }
  .subtitle {
    color: var(--text-muted);
    max-width: 70ch;
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 2rem;
    font-size: 0.85rem;
  }
  .stamp {
    color: var(--accent-live);
  }
  .drift.ok {
    color: var(--accent-live);
  }
  .drift.bad {
    color: var(--text);
    background: var(--accent-default);
    padding: 0 0.4rem;
  }
  .drift.unk {
    color: var(--text-faint);
  }
  .commit {
    color: var(--text-faint);
    text-decoration: none;
  }
  .commit:hover {
    color: var(--text);
  }
  .band {
    border: 1px solid var(--text-faint);
    padding: 0.75rem 1rem 1rem;
    margin-bottom: 1.25rem;
  }
  .band h2 {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    font-weight: normal;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .node {
    display: inline-block;
    border: 1px solid var(--text-faint);
    padding: 0.25rem 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
    transition: opacity 0.15s, border-color 0.15s;
  }
  .node:hover {
    border-color: var(--accent-live);
  }
  .node.lit {
    border-color: var(--accent-live);
    color: var(--accent-live);
  }
  .node.dimmed {
    opacity: 0.25;
  }
  .chip,
  .wl {
    font-size: 0.78rem;
    border-style: dashed;
  }
  .hub {
    border-style: double;
    border-width: 3px;
  }
  .app {
    padding: 0.4rem 0.5rem;
  }
  .app-name {
    color: var(--text);
    text-decoration: none;
    display: block;
    margin-bottom: 0.3rem;
  }
  .workloads {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .host {
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .ext {
    border-style: dashed;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .band-note {
    color: var(--text-faint);
    font-size: 0.8rem;
    max-width: 70ch;
    margin: 0.75rem 0 0;
  }
  .dim {
    color: var(--text-faint);
    font-size: 0.75rem;
  }
  .tag {
    color: var(--bg);
    background: var(--text-muted);
    font-size: 0.65rem;
    padding: 0 0.25rem;
    margin-left: 0.35rem;
    vertical-align: middle;
  }
  .footnote {
    color: var(--text-faint);
    font-size: 0.85rem;
    max-width: 75ch;
    margin-top: 2rem;
  }
</style>
