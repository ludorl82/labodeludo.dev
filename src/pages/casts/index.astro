---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CastList from "../../components/CastList.astro";
import ConsoleSnapshot from "../../components/ConsoleSnapshot.astro";

const casts = (await getCollection("casts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Enregistrements de terminal — Le labo de Ludo"
  description="Des sessions de travail réelles, condensées et rejouables dans le navigateur : ce que ça donne quand un agent pilote mon infrastructure."
>
  <a class="back" href="/">&larr; tous les articles</a>

  <header class="page-header">
    <h1>Enregistrements de terminal</h1>
    <p class="lede">
      Ce qui se passe dans ma console : en haut, la session de travail telle
      qu'elle était hier soir ; plus bas, les sessions derrière les articles,
      rejouables dans le navigateur. La plupart sont des reconstitutions
      condensées d'une session Claude Code, tirées de sa transcription réelle ;
      d'autres sont des prises réelles de la console ou du chat du site.
      Chacune dit ce qu'elle est en toutes lettres.
    </p>
  </header>

  <ConsoleSnapshot lang="fr" />

  <h2 class="list-h">Les enregistrements</h2>
  <CastList casts={casts} lang="fr" />
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  h1 {
    margin: 0 0 0.6rem;
  }

  .list-h {
    margin: 0 0 1rem;
    font-size: 1.15rem;
  }

  .lede {
    margin: 0;
    max-width: var(--measure);
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
