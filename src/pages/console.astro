---
/* La console : la session tmux « claude » telle qu'elle était au dernier
   instantané. Les données ne sont pas dans le dépôt : scripts/console/
   instantane.mjs les produit chaque soir sur la console, assainies, et les
   dépose à côté du site, dans /console/instantane.json, que le déploiement
   ne supprime pas. Une fuite se corrige en remplaçant le fichier ; elle ne
   reste dans l'historique d'aucun dépôt public.

   Tout le texte vient de transcriptions : il est posé en textContent, jamais
   en HTML. */
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="La console — Le labo de Ludo"
  description="Les fenêtres de ma session Claude Code, telles qu'elles étaient au dernier instantané : ce sur quoi je travaille, et ce qui s'en vient."
>
  <a class="back" href="/">&larr; tous les articles</a>

  <header class="page-header">
    <h1>La console</h1>
    <p class="lede">
      Chaque fenêtre de ma session tmux, avec la conversation qui s'y déroule
      avec Claude Code : ce sur quoi je travaille cette semaine, et ce qui
      deviendra peut-être un article. Clique sur une fenêtre dans la barre du
      bas pour la parcourir.
    </p>
    <p class="disclaimer">
      ✔ Prise réelle, refaite chaque soir et assainie automatiquement, sans
      relecture humaine. Les noms d'hôte, adresses et domaines sont remplacés par
      des valeurs fictives, et les appels d'outils sont réduits à une ligne,
      sans leur sortie. Une fenêtre qu'une des gardes touche est retenue ce
      soir-là : la liste blanche, la liste noire du vrai inventaire, ou la
      relecture par le modèle du labo, qui cherche ce qu'aucune liste ne sait
      nommer d'avance.
    </p>
  </header>

  <figure class="console" data-console>
    <div class="term">
      <div class="titlebar">
        <span class="app">Alacritty</span>
        <span class="stamp" data-stamp></span>
      </div>
      <div class="pane" data-pane tabindex="0" aria-live="polite">
        <p class="placeholder">Chargement de l'instantané…</p>
      </div>
      <nav class="tmux" aria-label="Fenêtres de la session">
        <span class="seg s0">claude</span>
        <span class="seg s1">ludorl82</span>
        <div class="wins" data-wins></div>
      </nav>
    </div>
  </figure>
</BaseLayout>

<script>
  type Entry = { r: "u" | "a" | "t" | "n"; t: string; at?: string };
  type Win = {
    index: number;
    name: string;
    active: boolean;
    activity: string;
    status: "publiee" | "retenue";
    reason?: "garde" | "relecture";
    entries?: Entry[];
  };
  type Snapshot = { generated: string; windows: Win[] };

  const root = document.querySelector<HTMLElement>("[data-console]")!;
  const pane = root.querySelector<HTMLElement>("[data-pane]")!;
  const wins = root.querySelector<HTMLElement>("[data-wins]")!;
  const stamp = root.querySelector<HTMLElement>("[data-stamp]")!;

  const el = (tag: string, cls: string, text?: string) => {
    const e = document.createElement(tag);
    e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  };

  const when = (iso: string) =>
    new Date(iso).toLocaleString("fr-CA", {
      day: "numeric",
      month: "long",
      hour: "2-digit",
      minute: "2-digit",
    });

  function show(w: Win, buttons: Map<number, HTMLButtonElement>) {
    for (const [i, b] of buttons) b.setAttribute("aria-current", String(i === w.index));
    pane.replaceChildren();
    const head = el("p", "head", `${w.index}:${w.name} — dernière activité le ${when(w.activity)}`);
    pane.append(head);

    if (w.status === "retenue") {
      pane.append(
        el(
          "p",
          "held",
          w.reason === "relecture"
            ? "Fenêtre retenue ce soir : la relecture par le modèle du labo y a trouvé quelque chose de privé."
            : "Fenêtre retenue ce soir : une des gardes de listes y a trouvé un nom ou une valeur qui ne sort pas du labo.",
        ),
      );
    } else if (!w.entries?.length) {
      pane.append(el("p", "held", "Rien à montrer dans cette fenêtre."));
    }

    for (const e of w.entries ?? []) {
      if (e.r === "u") {
        const p = el("div", "msg user");
        p.append(el("span", "mark", "❯ "), el("span", "body", e.t));
        pane.append(p);
      } else if (e.r === "a") {
        const p = el("div", "msg asst");
        p.append(el("span", "mark", "● "), el("span", "body", e.t));
        pane.append(p);
      } else if (e.r === "t") {
        pane.append(el("div", "msg tool", `  ⎿ ${e.t}`));
      } else {
        pane.append(el("div", "msg note", e.t));
      }
    }
    // On arrive sur le présent : le bas de la conversation.
    pane.scrollTop = pane.scrollHeight;
    history.replaceState(null, "", `#fenetre-${w.index}`);
  }

  async function main() {
    let snap: Snapshot;
    try {
      const res = await fetch("/console/instantane.json", { cache: "no-cache" });
      if (!res.ok) throw new Error(String(res.status));
      snap = await res.json();
    } catch {
      pane.replaceChildren(
        el("p", "placeholder", "Pas d'instantané ici. Il n'est déposé qu'à côté du site en production."),
      );
      return;
    }
    stamp.textContent = `instantané du ${when(snap.generated)}`;

    const buttons = new Map<number, HTMLButtonElement>();
    for (const w of snap.windows) {
      const b = el("button", "win", `${w.index}:${w.name}${w.active ? "*" : ""}`) as HTMLButtonElement;
      b.type = "button";
      if (w.status === "retenue") b.classList.add("held-tab");
      b.addEventListener("click", () => show(w, buttons));
      buttons.set(w.index, b);
      wins.append(b);
    }

    const wanted = Number(location.hash.match(/^#fenetre-(\d+)$/)?.[1]);
    const first =
      snap.windows.find((w) => w.index === wanted) ??
      [...snap.windows]
        .filter((w) => w.status === "publiee")
        .sort((a, b) => b.activity.localeCompare(a.activity))[0] ??
      snap.windows[0];
    if (first) show(first, buttons);
    else pane.replaceChildren(el("p", "placeholder", "La session est vide ce soir."));
  }

  main();
</script>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  h1 {
    margin: 0 0 0.6rem;
  }

  .lede {
    margin: 0 0 1rem;
    max-width: var(--measure);
    color: var(--text-muted);
    line-height: 1.7;
  }

  .disclaimer {
    margin: 0;
    max-width: var(--measure);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-muted);
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-left: 3px solid var(--accent-live);
    border-radius: 4px;
    padding: 0.6rem 0.85rem;
  }

  .console {
    margin: 0;
  }

  .term {
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--panel-border);
    font-family: var(--font-mono);
  }

  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #eff4f9;
    color: #1f1f1f;
    font-size: 0.72rem;
    padding: 0.3rem 0.55rem;
  }

  .stamp {
    color: #585858;
  }

  .pane {
    height: min(70vh, 42rem);
    overflow-y: auto;
    background: #181818;
    color: #dadada;
    font-size: 0.8rem;
    line-height: 1.55;
    padding: 0.75rem 0.9rem;
  }

  .pane:focus-visible {
    outline: 2px solid var(--accent-live);
    outline-offset: -2px;
  }

  .pane :global(.head) {
    margin: 0 0 1rem;
    color: #767676;
  }

  .pane :global(.msg) {
    margin: 0 0 0.8rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pane :global(.user) {
    color: #ffffff;
  }

  .pane :global(.user .mark) {
    color: #87d787;
  }

  .pane :global(.asst .mark) {
    color: #dadada;
  }

  .pane :global(.tool) {
    margin-top: -0.4rem;
    color: #8a8a8a;
  }

  .pane :global(.note) {
    color: #767676;
    text-align: center;
  }

  .pane :global(.held),
  .pane :global(.placeholder) {
    color: #949494;
    font-style: italic;
  }

  .tmux {
    display: flex;
    align-items: stretch;
    background: #121212;
    font-size: 0.7rem;
    line-height: 1.9;
    white-space: nowrap;
  }

  .seg {
    padding: 0 0.7rem;
    color: #121212;
  }

  .s0 {
    background: #bcbcbc;
    font-weight: 700;
  }

  .s1 {
    background: #8a8a8a;
  }

  .wins {
    flex: 1;
    display: flex;
    gap: 0.2rem;
    overflow-x: auto;
    padding: 0 0.5rem;
  }

  .wins :global(.win) {
    border: 0;
    background: none;
    padding: 0 0.45rem;
    font: inherit;
    color: #8a8a8a;
    cursor: pointer;
  }

  .wins :global(.win:hover),
  .wins :global(.win:focus-visible) {
    color: var(--accent-live);
  }

  .wins :global(.win[aria-current="true"]) {
    color: #ffffff;
    font-weight: 700;
    background: #303030;
  }

  .wins :global(.held-tab) {
    color: #4e4e4e;
    text-decoration: line-through;
  }
</style>
