---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BOB_404_EN } from "../../lib/bob-humor";

// Fallback only — the inline script re-picks on every load. See bob-humor.ts.
const fallback = BOB_404_EN[0];
---

<BaseLayout lang="en" title="404 — Le labo de Ludo">
  <a class="back" href="/en/">&larr; all posts</a>

  <header class="page-header">
    <h1>404</h1>
  </header>

  <pre class="term" data-entries={JSON.stringify(BOB_404_EN)}><code id="term-body">{fallback.body}</code></pre>

  <p class="hint" id="term-hint">{fallback.hint}</p>

  <script is:inline>
    (function () {
      var term = document.querySelector(".term");
      var body = document.getElementById("term-body");
      var hint = document.getElementById("term-hint");
      if (!term || !body || !hint) return;

      var entries;
      try {
        entries = JSON.parse(term.dataset.entries || "[]");
      } catch (e) {
        return;
      }
      if (entries.length < 2) return;

      // Avoid repeating the previous pick, so a reload always visibly changes.
      var KEY = "bob-404-en-last";
      var last = -1;
      try {
        last = parseInt(sessionStorage.getItem(KEY) ?? "-1", 10);
      } catch (e) {
        /* private mode — just take the random pick */
      }

      var i = Math.floor(Math.random() * entries.length);
      if (i === last) i = (i + 1) % entries.length;

      try {
        sessionStorage.setItem(KEY, String(i));
      } catch (e) {
        /* nothing to do */
      }

      body.textContent = entries[i].body;
      hint.textContent = entries[i].hint;
    })();
  </script>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-live);
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0 0 1.5rem;
  }

  .term {
    background: var(--panel);
    border: 1px solid var(--panel-border);
    border-left: 3px solid var(--panel-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    line-height: 1.55;
    max-width: var(--measure);
  }

  .term code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .hint {
    margin: 1.5rem 0 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
</style>
