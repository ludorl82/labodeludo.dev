---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { articlesForCast, CAST_TYPE_LABELS, CAST_TYPE_HINTS } from "../../../lib/casts";
import AsciiCast from "../../../components/AsciiCast.astro";

export async function getStaticPaths() {
  const casts = await getCollection("castsEn");
  return casts.map((cast) => ({ params: { slug: cast.id }, props: { cast } }));
}

const { cast } = Astro.props;
const frenchCasts = await getCollection("casts");
const hasFrench = frenchCasts.some((c) => c.id === cast.id);
const { Content } = await render(cast);

const articles = await articlesForCast(cast, "en");
---

<BaseLayout
  lang="en"
  title={`${cast.data.title} — Le labo de Ludo`}
  description={cast.data.description}
  translations={{
    en: `/en/casts/${cast.id}/`,
    ...(hasFrench ? { fr: `/casts/${cast.id}/` } : {}),
  }}
>
  <a class="back" href="/en/casts/">&larr; all recordings</a>

  <article>
    <header class="cast-header">
      <h1>{cast.data.title}</h1>
      <time datetime={cast.data.pubDate.toISOString()}>
        {
          cast.data.pubDate.toLocaleDateString("en-CA", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      <a
        class="cast-type"
        data-type={cast.data.type}
        href={`/en/casts/?type=${cast.data.type}`}
        title={CAST_TYPE_HINTS.en[cast.data.type]}
      >{CAST_TYPE_LABELS.en[cast.data.type]}</a>
    </header>

    <AsciiCast
      src={cast.data.cast}
      poster={cast.data.poster}
      caption={cast.data.caption}
      disclaimer={cast.data.disclaimer}
      session={cast.data.session}
      frame={cast.data.frame}
    />

    <div class="prose">
      <Content />
    </div>

    {
      articles.length > 0 && (
        <p class="related">
          {articles.length === 1 ? "The article that tells this story:" : "The articles that tell this story:"}{" "}
          {articles.map((a, i) => (
            <>
              {i > 0 && " · "}
              <a href={`/en/blog/${a.id}/`}>{a.data.title}</a>
            </>
          ))}
        </p>
      )
    }
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .cast-header {
    margin-bottom: 1.5rem;
  }

  h1 {
    margin: 0 0 0.5rem;
  }

  time {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .cast-type {
    margin-left: 0.75rem;
  }

  .prose {
    max-width: var(--measure);
    line-height: 1.7;
  }

  .related {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--panel-border);
    max-width: var(--measure);
    color: var(--text-muted);
  }
</style>
