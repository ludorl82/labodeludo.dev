---
import { getCollection } from "astro:content";
import { byNewest } from "../lib/author";
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyStrip from "../components/TopologyStrip.astro";
import PostList from "../components/PostList.astro";

const posts = (await getCollection("blog")).sort(byNewest);
---

<BaseLayout
  title="Le labo de Ludo"
  description="Journal d'incidents et de bricolages d'un homelab réel — réseau, self-hosting, automatisation."
  translations={{ fr: "/", en: "/en/" }}
>
  <TopologyStrip posts={posts} />
  <PostList posts={posts} />
  <p class="fil-lien">
    Aussi : <a href="/nouvelles/">le fil de Bob</a>, ce que les mises à jour changent au labo (essai hebdomadaire).
  </p>
</BaseLayout>

<style>
  .fil-lien {
    margin-top: 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-faint);
  }
</style>
