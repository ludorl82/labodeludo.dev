---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { INVENTORY, type InventoryKey } from "../../lib/inventory";
import arch from "../../data/architecture.json";

export async function getStaticPaths() {
  return (Object.keys(INVENTORY) as InventoryKey[]).map((item) => ({
    params: { item },
  }));
}

const { item } = Astro.params as { item: InventoryKey };
const info = INVENTORY[item];

const allPosts = await getCollection("blog");
const posts = info.articles
  .map((id) => allPosts.find((post) => post.id === id))
  .filter((post): post is NonNullable<typeof post> => post !== undefined)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// The other half of the bridge: what this role IS in the generated
// topology. Gated like the rest of the generated material, and fail-soft —
// a node id that vanished from a nightly refresh simply isn't listed.
const showLiveArch = process.env.SHOW_LIVE_ARCH === "1";
const liveNodes = showLiveArch
  ? (info.nodes ?? [])
      .map((id) => (arch.nodes as any[]).find((n) => n.id === id))
      .filter(Boolean)
  : [];
---

<BaseLayout title={`${info.name} — Le labo de Ludo`} description={info.description}>
  <a class="back" href="/inventaire/">&larr; inventaire</a>

  <header class="item-header">
    <h1>{info.name}</h1>
  </header>

  <p class="description">{info.description}</p>

  {
    liveNodes.length > 0 && (
      <section class="live-nodes">
        <h2># dans l'architecture générée</h2>
        <ul>
          {liveNodes.map((n: any) => (
            <li>
              <a
                href={`https://github.com/ludorl82/${n.repo}/blob/HEAD/${n.source}`}
              >
                <code>{n.id}</code>
              </a>
              <span class="dim">{n.layer}</span>
            </li>
          ))}
        </ul>
        <p class="dim note">
          Ces identifiants viennent des dépôts IaC publics, pas de cette
          page — <a href="/architecture/">la vue générée</a> les redessine
          chaque nuit.
        </p>
      </section>
    )
  }

  {
    posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">Aucun article ne parle spécifiquement de ce rôle pour l'instant.</p>
    )
  }
</BaseLayout>

<style>
  .live-nodes {
    margin: 0 0 2rem;
  }

  .live-nodes h2 {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: normal;
    color: var(--text-muted);
    margin: 0 0 0.5rem;
  }

  .live-nodes ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .live-nodes li {
    border: 1px dashed var(--panel-border);
    padding: 0.2rem 0.5rem;
    font-size: 0.78rem;
  }

  .live-nodes a {
    color: var(--text);
    text-decoration: none;
  }

  .live-nodes a:hover {
    color: var(--accent-live);
  }

  .live-nodes .dim {
    color: var(--text-faint);
    margin-left: 0.4rem;
  }

  .live-nodes .note {
    font-size: 0.78rem;
    margin: 0.6rem 0 0;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back:hover {
    color: var(--accent-live);
  }

  .item-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.05rem + 1.3vw, 1.875rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .description {
    margin: 1rem 0 0;
    max-width: var(--measure);
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .empty {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--panel-border);
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }
</style>
